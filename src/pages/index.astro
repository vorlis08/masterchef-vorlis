---
import Layout from '../layouts/Layout.astro';
import recipesData from '../data/recipes.json';

const categories = [...new Set(recipesData.map((r: any) => r.category))];
---

<Layout title="MasterChef Vorlis">

  <!-- Header -->
  <header class="px-4 sm:px-6 pt-6 sm:pt-9 pb-4 sm:pb-6 max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-9 sm:mb-12">
      <div>
        <div class="label text-accent mb-1.5">Kuchařka</div>
        <h1 class="display text-[26px] sm:text-[34px] text-text">
          MasterChef <span class="text-accent">Vorlis</span>
        </h1>
      </div>
      <div class="flex items-center gap-3">
        <!-- Chef AI -->
        <button id="chef-btn" class="hidden sm:flex w-9 h-9 rounded-lg bg-surface border border-border items-center justify-center text-text-muted hover:text-accent hover:border-accent transition-colors" title="Co dnes uvařit?">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
          </svg>
        </button>
        <!-- Shopping list -->
        <button id="shopping-btn" class="relative hidden sm:flex w-9 h-9 rounded-lg bg-surface border border-border items-center justify-center text-text-muted hover:text-accent hover:border-accent transition-colors" title="Nákupní seznam">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
          </svg>
          <span id="shopping-count" class="hidden absolute -top-1.5 -right-1.5 min-w-[18px] h-[18px] px-1 rounded-full bg-accent text-white text-[10px] font-semibold flex items-center justify-center"></span>
        </button>
        <!-- Kalendar -->
        <button id="cal-btn" class="w-10 h-10 sm:w-9 sm:h-9 rounded-lg bg-surface border border-border flex items-center justify-center text-text-muted hover:text-accent hover:border-accent transition-colors relative" title="Kalendář vaření">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
          </svg>
          <span id="cal-badge" class="hidden absolute -top-1 -right-1 min-w-[16px] h-4 px-1 rounded-full bg-accent text-white text-[9px] font-semibold flex items-center justify-center"></span>
        </button>
        <!-- Spiz -->
        <button id="pantry-btn" class="spiz-tlacitko h-10 sm:h-9 px-2.5 sm:px-3 rounded-lg flex items-center gap-2 transition-colors relative" title="Moje spíž">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h12A2.25 2.25 0 0020.25 14.25V3M3.75 3h16.5M3.75 3H2.25M20.25 3h1.5M9 7.5h6M9 11.25h6M8.25 16.5v3.75M15.75 16.5v3.75" />
          </svg>
          <span class="hidden sm:inline text-[13px] font-medium">Spíž</span>
          <span id="pantry-badge" class="hidden absolute -top-1 -right-1 min-w-[16px] h-4 px-1 rounded-full bg-accent text-white text-[9px] font-semibold flex items-center justify-center"></span>
        </button>
        <!-- Prihlaseni -->
        <button id="auth-btn" class="h-10 sm:h-9 px-3 rounded-lg bg-surface border border-border flex items-center gap-2 text-text-muted text-[13px] hover:text-accent hover:border-accent transition-colors" title="Přihlásit se">
          <svg id="auth-ikona" class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
          <img id="auth-foto" alt="" class="hidden w-6 h-6 rounded-full object-cover shrink-0 -ml-0.5" />
          <span id="auth-label" class="hidden sm:inline max-w-[110px] truncate">Přihlásit</span>
        </button>
        <!-- Settings -->
        <button id="settings-btn" class="w-10 h-10 sm:w-9 sm:h-9 rounded-lg bg-surface border border-border flex items-center justify-center text-text-muted hover:text-accent hover:border-accent transition-colors" title="Nastavení">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 010 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 010-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Search -->
    <div class="relative mb-6">
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-text-muted pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input type="text" id="search" placeholder="Hledat podle názvu nebo suroviny" class="w-full bg-surface border border-border rounded-xl py-3.5 sm:py-3 pl-12 pr-4 text-text placeholder:text-text-muted focus:outline-none focus:border-accent transition-colors text-[16px] sm:text-[15px]" />
    </div>

    <!-- Filters -->
    <div class="flex flex-col gap-2.5" id="filter-area">
      <!-- Row 1: category -->
      <div class="flex gap-2 overflow-x-auto scrollbar-hide -mx-4 px-4 sm:mx-0 sm:px-0 sm:flex-wrap sm:overflow-visible" id="filter-bar"></div>
      <!-- Row 2: chod a cas -->
      <div class="flex items-center gap-2 overflow-x-auto scrollbar-hide -mx-4 px-4 sm:mx-0 sm:px-0 sm:flex-wrap sm:overflow-visible" id="filter-bar-2"></div>
      <!-- Row 3: stav receptu a spiz. Jina osa nez chod/cas, proto zvlast. -->
      <div class="flex items-center gap-2 overflow-x-auto scrollbar-hide -mx-4 px-4 sm:mx-0 sm:px-0 sm:flex-wrap sm:overflow-visible" id="filter-bar-3"></div>
    </div>
  </header>

  <!-- Dnešní volba -->
  <section id="hero" class="px-4 sm:px-6 max-w-6xl mx-auto hidden"></section>

  <!-- Recipe grid -->
  <section class="px-4 sm:px-6 pb-32 sm:pb-16 max-w-6xl mx-auto">
    <div id="grid-heading" class="hidden items-center justify-between gap-3 mb-6 pb-3 border-b border-border">
      <div class="flex items-baseline gap-3">
        <h2 id="grid-title" class="display text-[19px] sm:text-[22px] text-text">Rejstřík</h2>
        <span id="grid-count" class="meta text-text-muted"></span>
      </div>
      <div class="view-toggle" id="view-toggle">
        <button data-view="menu" class="on">Rejstřík</button>
        <button data-view="grid">Mřížka</button>
      </div>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-8 sm:gap-x-6 sm:gap-y-10" id="recipe-grid"></div>
    <div id="no-results" class="hidden text-center py-24">
      <p class="display text-[22px] text-text mb-2">Tady zatím nic není</p>
      <p class="text-text-muted text-[14px] max-w-[280px] mx-auto leading-relaxed">Zkus hledat jinak, nebo přidej první recept tlačítkem plus.</p>
    </div>
  </section>

  <div id="hover-preview" aria-hidden="true"><img alt="" /></div>

  <!-- Recipe detail modal -->
  <div id="modal-overlay" class="fixed inset-0 bg-black/70 z-50 hidden opacity-0 transition-opacity duration-200">
    <div id="modal" class="fixed inset-y-0 right-0 w-full max-w-2xl bg-bg overflow-y-auto translate-x-full transition-transform duration-300 ease-out">
      <button id="modal-close" class="sticky top-4 ml-4 z-10 w-10 h-10 rounded-full bg-surface border border-border flex items-center justify-center text-text-muted hover:text-text transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
      <div id="mode-sweep" class="mode-sweep" aria-hidden="true"></div>
      <div id="modal-figure" class="-mt-14 relative">
        <img id="modal-image" alt="" class="w-full aspect-[16/10] object-cover" />
        <div id="modal-image-fade" class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-bg to-transparent pointer-events-none"></div>
      </div>
      <div id="modal-body" class="px-5 sm:px-8 py-6 sm:py-8">
        <div id="modal-header-row" class="flex items-start justify-between mb-2">
          <h2 id="modal-title" class="display text-[27px] sm:text-[32px] text-text"></h2>
        </div>
        <p id="modal-description" class="text-text-muted text-[15px] mb-6 leading-relaxed"></p>
        <div id="modal-meta" class="meta flex items-center gap-2.5 mb-7 text-text-muted"></div>
        <div id="modal-fleuron" class="f-fleuron hidden" aria-hidden="true"><span>&#10087;</span></div>
        <div id="modal-note" class="f-note hidden"></div>
        <div id="modal-controls" class="flex flex-wrap items-center gap-3 mb-8">
          <div class="mode-toggle" id="mode-toggle" role="group" aria-label="Verze receptu">
            <button type="button" class="mode-opt is-on" data-mode="basic">Basic</button>
            <button type="button" class="mode-opt" data-mode="fancy">Fancy</button>
          </div>
          <div class="flex items-center gap-1 bg-surface border border-border rounded-lg px-1 py-1">
            <button id="portion-minus" class="w-8 h-8 rounded-md flex items-center justify-center text-text-muted hover:text-accent hover:bg-surface-hover transition-colors text-[18px] font-medium">−</button>
            <span id="portion-value" class="meta min-w-[74px] text-center text-text">4 porce</span>
            <button id="portion-plus" class="w-8 h-8 rounded-md flex items-center justify-center text-text-muted hover:text-accent hover:bg-surface-hover transition-colors text-[18px] font-medium">+</button>
          </div>
          <button id="cook-mode-btn" class="flex-1 sm:flex-none justify-center px-4 py-2.5 sm:py-2 rounded-lg bg-accent text-white text-[13px] font-medium active:scale-[0.98] hover:bg-accent-hover transition-all flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 010 1.972l-11.54 6.347a1.125 1.125 0 01-1.667-.986V5.653z" /></svg>
            Režim vaření
          </button>
          <button id="book-btn" class="flex-1 sm:flex-none justify-center px-4 py-2.5 sm:py-2 rounded-lg bg-surface border border-accent/50 text-accent text-[13px] font-medium active:scale-[0.98] hover:bg-accent hover:text-white hover:border-accent transition-all flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
            TO UVAŘÍM!
          </button>
          <button id="add-shop-btn" class="flex-1 sm:flex-none px-4 py-2.5 sm:py-2 rounded-lg bg-surface border border-border text-text-muted text-[13px] font-medium active:scale-[0.98] hover:text-accent hover:border-accent transition-all">
            Do nákupu
          </button>
          <button id="nutrition-btn" class="flex items-center gap-1.5 px-4 py-2.5 sm:py-2 rounded-lg bg-surface border border-border text-text-muted text-[13px] font-medium active:scale-[0.98] hover:text-accent hover:border-accent transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
            Nutriční hodnoty
          </button>
          <button id="subst-btn" class="flex items-center gap-1.5 px-4 py-2.5 sm:py-2 rounded-lg bg-surface border border-border text-text-muted text-[13px] font-medium active:scale-[0.98] hover:text-accent hover:border-accent transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"/></svg>
            Nahradit
          </button>
        </div>
        <div class="mb-8">
          <h3 id="head-ingredients" class="label text-accent mb-4">Ingredience</h3>
          <ul id="modal-ingredients" class="space-y-2"></ul>
        </div>
        <div class="mb-8">
          <h3 id="head-steps" class="label text-accent mb-5">Postup</h3>
          <ol id="modal-steps" class="space-y-5"></ol>
        </div>
        <div id="modal-tip" class="hidden p-5 rounded-xl bg-surface border border-border">
          <p class="text-[14px] leading-relaxed">
            <span class="text-accent font-medium">Tip — </span>
            <span id="modal-tip-text" class="text-text-muted"></span>
          </p>
        </div>

        <div id="modal-rating" class="mt-6 pt-6 border-t border-border">
          <div class="flex items-center justify-between mb-4">
            <h3 class="label text-accent">Moje hodnocení</h3>
          <button id="wish-btn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface border border-border text-text-muted text-[12px] font-medium hover:text-accent hover:border-accent transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M11.48 3.5a.56.56 0 011.04 0l2.12 4.3 4.75.69c.46.07.64.63.31.95l-3.44 3.35.81 4.73c.08.46-.4.81-.81.6L12 15.9l-4.26 2.23c-.41.21-.89-.14-.81-.6l.81-4.73-3.44-3.35a.56.56 0 01.31-.95l4.75-.69 2.12-4.3z" /></svg>
            <span id="wish-label">Chci vyzkoušet</span>
          </button>
          <button id="cooked-btn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface border border-border text-text-muted text-[12px] font-medium hover:text-accent hover:border-accent transition-colors">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Uvařil jsem to
            </button>
          </div>
          <div class="flex items-center gap-1 mb-4" id="star-row">
            <button class="star-btn text-[28px] leading-none transition-transform hover:scale-110" data-star="1">☆</button>
            <button class="star-btn text-[28px] leading-none transition-transform hover:scale-110" data-star="2">☆</button>
            <button class="star-btn text-[28px] leading-none transition-transform hover:scale-110" data-star="3">☆</button>
            <button class="star-btn text-[28px] leading-none transition-transform hover:scale-110" data-star="4">☆</button>
            <button class="star-btn text-[28px] leading-none transition-transform hover:scale-110" data-star="5">☆</button>
            <span id="cook-stats" class="ml-3 text-[12px] text-text-muted"></span>
          </div>
          <textarea id="personal-note" rows="3" placeholder="Osobní poznámky, úpravy, co bych příště změnil..." class="w-full bg-surface border border-border rounded-lg py-2.5 px-4 text-text text-[14px] placeholder:text-text-muted focus:outline-none focus:border-accent transition-colors resize-none"></textarea>
          <button id="save-note-btn" class="mt-2 px-4 py-2 rounded-lg bg-surface border border-border text-text-muted text-[12px] font-medium hover:text-accent hover:border-accent transition-colors">Uložit poznámku</button>
          <p id="note-saved" class="hidden mt-1.5 text-[11px] text-green-400">Uloženo</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Chef AI modal -->
  <div id="chef-overlay" class="fixed inset-0 bg-black/70 z-[60] hidden opacity-0 transition-opacity duration-200">
    <div id="chef-modal" class="fixed inset-y-0 right-0 w-full max-w-2xl bg-bg overflow-y-auto translate-x-full transition-transform duration-300 ease-out">
      <div class="px-5 sm:px-8 py-6 sm:py-8">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-[22px] font-semibold text-text flex items-center gap-2">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
            </svg>
            Co dnes uvařit?
          </h2>
          <button id="chef-close" class="w-10 h-10 rounded-full bg-surface border border-border flex items-center justify-center text-text-muted hover:text-text transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>

        <div class="mb-6">
          <label class="block text-[13px] font-medium text-text-muted mb-1.5">Jaké máš ingredience?</label>
          <textarea id="chef-input" rows="3" class="w-full bg-surface border border-border rounded-lg py-2.5 px-4 text-text text-[15px] focus:outline-none focus:border-accent transition-colors resize-none" placeholder="kuřecí prsa, rýže, smetana, cibule..."></textarea>
        </div>

        <div class="flex gap-3 mb-8">
          <button id="chef-search" class="flex-1 py-2.5 rounded-lg bg-accent text-white font-medium text-[14px] hover:bg-accent-hover transition-colors">
            Najdi recepty
          </button>
          <button id="chef-ai" class="flex-1 py-2.5 rounded-lg bg-surface border border-border text-text font-medium text-[14px] hover:border-accent hover:text-accent transition-colors flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
