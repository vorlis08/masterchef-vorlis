    // --- Markdown renderer (lightweight) ---
    function renderMarkdown(text) {
      return text
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.+?)\*/g, '<em>$1</em>')
        .replace(/`(.+?)`/g, '<code class="bg-surface px-1 rounded text-accent text-[13px]">$1</code>')
        .replace(/^### (.+)$/gm, '<h3 class="font-semibold text-text mt-3 mb-1">$1</h3>')
        .replace(/^## (.+)$/gm, '<h2 class="font-semibold text-text mt-3 mb-1">$1</h2>')
        .replace(/^\d+\. (.+)$/gm, '<div class="flex gap-2 my-1"><span class="text-accent shrink-0">•</span><span>$1</span></div>')
        .replace(/^- (.+)$/gm, '<div class="flex gap-2 my-1"><span class="text-text-muted shrink-0">–</span><span>$1</span></div>')
        .replace(/\n\n/g, '<br><br>')
        .replace(/\n/g, '<br>');
    }

    // --- AI ingredient substitution ---
    const substOverlay = document.getElementById('subst-overlay');
    const substModal = document.getElementById('subst-modal');
    const substSelect = document.getElementById('subst-select');
    const substResult = document.getElementById('subst-result');
    const substLoading = document.getElementById('subst-loading');

    function openSubst() {
      const r = recipes.find(x => x.slug === currentSlug);
      if (!r) return;
      const ings = variantOf(r).ingredients;
      substSelect.innerHTML = '<option value="">— vyber ingredienci —</option>' +
        ings.map(i => `<option value="${escAttr(i)}">${esc(i)}</option>`).join('');
      substResult.classList.add('hidden');
      substResult.innerHTML = '';
      substLoading.classList.add('hidden');
      document.getElementById('subst-replacement').value = '';
      substOverlay.classList.remove('hidden');
      requestAnimationFrame(() => {
        substOverlay.classList.remove('opacity-0');
        substModal.classList.remove('scale-95', 'opacity-0');
      });
    }

    function closeSubst() {
      substOverlay.classList.add('opacity-0');
      substModal.classList.add('scale-95', 'opacity-0');
      setTimeout(() => substOverlay.classList.add('hidden'), 200);
    }

    document.getElementById('subst-btn').addEventListener('click', openSubst);
    document.getElementById('subst-close').addEventListener('click', closeSubst);
    substOverlay.addEventListener('click', e => { if (e.target === substOverlay) closeSubst(); });

    document.getElementById('subst-ask').addEventListener('click', async () => {
      const ingredient = substSelect.value;
      const replacement = document.getElementById('subst-replacement').value.trim();
      if (!ingredient || !replacement) return;

      const r = recipes.find(x => x.slug === currentSlug);
      // Text dotazu sklada Worker. Odsud jdou ven jen data.
      substLoading.classList.remove('hidden');
      substResult.classList.add('hidden');
      substResult.innerHTML = '';

      try {
        const res = await fetch(AI_WORKER, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'substitute',
            recipeTitle: r ? r.title : '',
            ingredient: ingredient,
            replacement: replacement,
          })
        });

        if (!res.ok) throw new Error('Worker chyba ' + res.status);

        substLoading.classList.add('hidden');
        substResult.classList.remove('hidden');
        substResult.innerHTML = '';

        let rawText = '';
        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';

        while (true) {
          const { done, value } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });
          const lines = buffer.split('\n');
          buffer = lines.pop();
          for (const line of lines) {
            if (!line.startsWith('data: ')) continue;
            const data = line.slice(6).trim();
            if (data === '[DONE]') break;
            try {
              const json = JSON.parse(data);
              const delta = json.delta?.text || json.choices?.[0]?.delta?.content || '';
              if (delta) {
                rawText += delta;
                substResult.innerHTML = renderMarkdown(rawText);
              }
            } catch {}
          }
        }
      } catch (err) {
        substLoading.classList.add('hidden');
        substResult.classList.remove('hidden');
        substResult.innerHTML = '<span class="text-red-400">Chyba: ' + err.message + '</span>';
      }
    });

    // --- Nutrition modal ---
    const nutritionOverlay = document.getElementById('nutrition-overlay');
    const nutritionModal = document.getElementById('nutrition-modal');

    const NUTR_MAX = { protein: 80, carbs: 120, sugar: 60, fat: 60, fiber: 15, sodium: 2000, calcium: 400, iron: 10, vitamin_c: 60 };

    function setNutrBar(id, value, max) {
      const el = document.getElementById(id);
      if (el) el.style.width = Math.min(Math.round((value / max) * 100), 100) + '%';
    }

    function openNutrition() {
      const r = recipes.find(x => x.slug === currentSlug);
      const noData = document.getElementById('nutrition-no-data');
      const content = document.getElementById('nutrition-content');
      const label = document.getElementById('nutrition-serving-label');

      if (!r || !r.nutrition) {
        noData.classList.remove('hidden');
        content.classList.add('hidden');
        label.textContent = '';
      } else {
        const n = r.nutrition;
        noData.classList.add('hidden');
        content.classList.remove('hidden');
        label.textContent = 'na 1 porci (' + (n.serving_g || '?') + ' g)';
        document.getElementById('nutr-calories').textContent = n.calories ?? '—';
        document.getElementById('nutr-protein').textContent = n.protein ?? '—';
        document.getElementById('nutr-carbs').textContent = n.carbs ?? '—';
        document.getElementById('nutr-sugar').textContent = n.sugar ?? '—';
        document.getElementById('nutr-fat').textContent = n.fat ?? '—';
        document.getElementById('nutr-fiber').textContent = n.fiber ?? '—';
        document.getElementById('nutr-sodium').textContent = n.sodium ?? '—';
        document.getElementById('nutr-calcium').textContent = n.calcium ?? '—';
        document.getElementById('nutr-iron').textContent = n.iron ?? '—';
        document.getElementById('nutr-vitc').textContent = n.vitamin_c ?? '—';
        setNutrBar('nutr-bar-protein', n.protein, NUTR_MAX.protein);
        setNutrBar('nutr-bar-carbs', n.carbs, NUTR_MAX.carbs);
        setNutrBar('nutr-bar-sugar', n.sugar, NUTR_MAX.sugar);
        setNutrBar('nutr-bar-fat', n.fat, NUTR_MAX.fat);
        setNutrBar('nutr-bar-fiber', n.fiber, NUTR_MAX.fiber);
        setNutrBar('nutr-bar-sodium', n.sodium, NUTR_MAX.sodium);
        setNutrBar('nutr-bar-calcium', n.calcium, NUTR_MAX.calcium);
        setNutrBar('nutr-bar-iron', n.iron * 10, NUTR_MAX.iron * 10);
        setNutrBar('nutr-bar-vitc', n.vitamin_c, NUTR_MAX.vitamin_c);
      }

      nutritionOverlay.classList.remove('hidden');
      requestAnimationFrame(() => {
        nutritionOverlay.classList.remove('opacity-0');
        nutritionModal.classList.remove('scale-95', 'opacity-0');
      });
    }

    function closeNutrition() {
      nutritionOverlay.classList.add('opacity-0');
      nutritionModal.classList.add('scale-95', 'opacity-0');
      setTimeout(() => nutritionOverlay.classList.add('hidden'), 200);
    }

    document.getElementById('nutrition-btn').addEventListener('click', openNutrition);
    document.getElementById('nutrition-close').addEventListener('click', closeNutrition);
    nutritionOverlay.addEventListener('click', e => { if (e.target === nutritionOverlay) closeNutrition(); });

    }); // DOMContentLoaded
  </script>


