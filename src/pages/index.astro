    /**
     * Zmensi vybranou fotku a udela z ni data-adresu.
     *
     * Proc rovnou do databaze a ne do uloziste souboru: 160 pixelu na
     * vysku je ~10 kB. Zakladat kvuli tomu dalsi sluzbu, kterou je
     * potreba platit a zalohovat, se nevyplati.
     *
     * Zmensuje se v prohlizeci, ne na serveru - jinak by uzivatel
     * posilal ctyri megapixely z telefonu kvuli obrazku o velikosti
     * nehtu.
     */
    function zmensFotku(soubor) {
      return new Promise((splneno, chyba) => {
        if (!/^image\//.test(soubor.type)) return chyba(new Error('Tohle není obrázek.'));
        // Strop na vstup: nad 12 MB uz to jen zbytecne zdrzuje.
        if (soubor.size > 12 * 1024 * 1024) return chyba(new Error('Fotka je moc velká (nad 12 MB).'));

        const cteni = new FileReader();
        cteni.onerror = () => chyba(new Error('Fotku se nepovedlo přečíst.'));
        cteni.onload = () => {
          const obr = new Image();
          obr.onerror = () => chyba(new Error('Tenhle formát obrázku neumím.'));
          obr.onload = () => {
            const H = 160;
            // Ctverec z prostredka - profilovka je stejne kulata.
            const strana = Math.min(obr.width, obr.height);
            const platno = document.createElement('canvas');
            platno.width = H;
            platno.height = H;
            platno.getContext('2d').drawImage(
              obr,
              (obr.width - strana) / 2, (obr.height - strana) / 2, strana, strana,
              0, 0, H, H
            );
            splneno(platno.toDataURL('image/jpeg', 0.82));
          };
          obr.src = cteni.result;
        };
        cteni.readAsDataURL(soubor);
      });
    }

