  <script type="application/json" id="recipes-data" set:html={JSON.stringify(recipesData).replace(/</g, '\\u003c')}></script>

  <script>
    import {
      fold, esc, escAttr, splitQty, scaleIngredient, roman,
      parseDurations, fmtClock, parseIngredients, ingredientMatch,
    } from '../lib/recipe-logic.js';
    import { filterRecipes, headingFor, countLabel } from '../lib/filters.js';
    import { gridView } from '../lib/recipe-view.js';
    import { hodnost, celkemUvareno } from '../lib/hodnosti.js';

    import {
      pantryView, guessKind, starterList, STATUSES, statusLabel,
      krokMnozstvi, posunMnozstvi,
    } from '../lib/pantry.js';
    import { buildChecklist, checklistProgress, spizPodleSekci } from '../lib/catalog.js';
    import { pripravenost, sediSurovina, chybejici } from '../lib/match.js';
    import {
      dnes as dnesniDatum, jeDatum, jeCas, popisBookingu, popisDatumu,
      konflikty, popisKonfliktu, coZamknout, nadchazejici, rychleTerminy,
    } from '../lib/booking.js';
    import {
      DNY_ZKRATKY, mesicniMrizka, posunMesic, pocetVMesici, bookingyDne,
    } from '../lib/kalendar.js';
    import {
      krok as tourKrokData, omez as tourOmez, jePrvni as tourPrvni,
      jePosledni as tourPosledni, popisPostupu as tourPostup,
      popisekDopredu as tourDopredu, akceKroku as tourAkce,
    } from '../lib/tour.js';
    import {
      createSession, currentStep, stepNumber, isLast, goTo,
      progressPercent, stepLabel, progressLabel, ghostLabel, nextLabel,
      finishText, finishLabel
    } from '../lib/cook-session.js';
    import {
      createTimers, addTimer, removeTimer, clearTimers, tick as tickTimerState,
      isRunning, hasRunning, isEmpty as noTimers, timerViews
    } from '../lib/cook-timers.js';

    // Zakladni adresa appky. BASE_URL nema lomitko na konci (8.18),
    // takze se doplnuje - bez nej by odkazy na obrazky sedly vedle.
    const ZAKLAD_URL = import.meta.env.BASE_URL.replace(/[/]*$/, '/');

    const recipesData = JSON.parse(document.getElementById('recipes-data').textContent);

    // --- Prihlaseni ------------------------------------------------------
    // Worker po prihlaseni vrati listek za mrizkou v adrese. Mrizka se na
    // server neposila, takze listek nezustane v zadnem logu po ceste.
    let currentUser = null;

    // Uvodni okno a brana se skladaji az po nacteni stranky, takze na ne
    // odsud primo nevidime. Az budou hotove, samy se sem prihlasi.
    // Vsechno, co se ma stat po overeni prihlaseni. Sklada se to az
    // s nactenou strankou, takze odsud na to primo nevidime.
    let poPrihlaseni = null;
    let branaHook = null;
    // Tlacitko s vlastnim jmenem je TADY, ale okno profilu se sklada
    // az uvnitr bloku po nacteni stranky - odsud na nej primo nevidime
    // (8.13). Az bude hotove, samo se sem prihlasi.
    let profilHook = null;

    function readTokenFromUrl() {
      const m = /[#&]token=([^&]+)/.exec(location.hash || '');
      if (!m) return;
      Store.setSession(decodeURIComponent(m[1]));
      // Uklidime adresu, at listek nezustane viset v historii prohlizece.
      history.replaceState(null, '', location.pathname + location.search);
    }

    function paintAuth() {
      const btn = document.getElementById('auth-btn');
      const label = document.getElementById('auth-label');
      const foto = document.getElementById('auth-foto');
      const ikona = document.getElementById('auth-ikona');
      if (!btn || !label) return;

      if (currentUser) {
        label.textContent = currentUser.name || currentUser.email;
        btn.title = currentUser.email + ' — můj profil';
        // Prihlaseny clovek pozna svoje tlacitko podle obrazku, ne podle
        // textu - ten se na uzkem displeji stejne schovava.
        if (foto) {
          foto.src = currentUser.avatar || (ZAKLAD_URL + 'avatary/panev.svg');
          foto.classList.remove('hidden');
        }
        if (ikona) ikona.classList.add('hidden');
      } else {
        label.textContent = 'Přihlásit';
        btn.title = 'Přihlásit se přes Google';
        if (foto) foto.classList.add('hidden');
        if (ikona) ikona.classList.remove('hidden');
      }
    }

    async function loadUser() {
      const token = Store.getSession();
      if (!token) {
        currentUser = null;
        paintAuth();
        if (branaHook) branaHook(true);
        if (poPrihlaseni) poPrihlaseni();
        return;
      }
      try {
        const res = await fetch(AI_WORKER + '/api/me', {
          headers: { Authorization: 'Bearer ' + token },
        });
        if (res.ok) {
          currentUser = await res.json();
        } else {
          // Listek propadl nebo uz neplati - zahodime ho.
          Store.setSession('');
          currentUser = null;
        }
      } catch { currentUser = null; }
      paintAuth();
      if (branaHook) branaHook(!currentUser);
      if (poPrihlaseni) poPrihlaseni();
    }

    // `consent` posle uzivatele na souhlasnou obrazovku Googlu. Jen
    // tam se da ziskat dlouhodoby pristup ke kalendari - pri beznem
    // prihlaseni ho Google neposila.
    function startGoogleLogin(consent) {
      const back = location.origin + location.pathname;
      location.href = AI_WORKER + '/auth/start?return=' + encodeURIComponent(back) +
        (consent ? '&consent=1' : '');
    }

    document.getElementById('auth-btn')?.addEventListener('click', () => {
      // Prihlaseny clovek se sem uz neklika kvuli odhlaseni, ale kvuli
      // profilu. Odhlaseni je v nem dole - je to vzacnejsi ukon nez
      // "chci se na sebe podivat".
      if (currentUser) {
        if (profilHook) profilHook();
        return;
      }
      startGoogleLogin();
    });

    // Adresa AI proxy. Klic k Anthropicu je uvnitr Workeru, ne tady.
    const AI_WORKER = 'https://vorlis.honzavorel0.workers.dev';

    // ==========================================================================
    // Store - jednotna vrstva pro ukladani dat.
    // Dnes pod tim bezi localStorage. Az prijde prihlasovani a databaze,
    // meni se jen telo tehle jedine vrstvy, zbytek appky zustava beze zmeny.
    // ==========================================================================
    const Store = {
      _raw(key, fallback) {
        try { const v = localStorage.getItem(key); return v === null ? fallback : v; }
        catch (e) { return fallback; }
      },
      _json(key, fallback) {
        try { const v = localStorage.getItem(key); if (v === null) return fallback; const p = JSON.parse(v); return p === null ? fallback : p; }
        catch (e) { return fallback; }
      },
      _write(key, value) { try { localStorage.setItem(key, value); } catch (e) {} },
      _writeJson(key, value) { try { localStorage.setItem(key, JSON.stringify(value)); } catch (e) {} },
      _remove(key) { try { localStorage.removeItem(key); } catch (e) {} },

      getFavorites()      { return this._json('favorites', []); },
      setFavorites(list)  { this._writeJson('favorites', list); },

      getViewMode()       { return this._raw('viewMode', 'menu'); },
      setViewMode(mode)   { this._write('viewMode', mode); },

      getRecipeMode()     { return this._raw('recipeMode', 'basic'); },
      setRecipeMode(mode) { this._write('recipeMode', mode); },

      getTheme()          { return this._raw('theme', ''); },
      setTheme(theme)     { if (theme) this._write('theme', theme); else this._remove('theme'); },

      // GitHub token appka uz nepouziva - recepty se z prohlizece needituji.
      // Zbyva jen uklid po starsich verzich.
      zapomenTokenGithubu() { this._remove('gh_token'); },

      // Prisel z e-mailu na uvod, ale jeste nebyl prihlaseny.
      getUvodPoPrihlaseni()  { return this._raw('uvodPotom', '') === '1'; },
      setUvodPoPrihlaseni(a) { if (a) this._write('uvodPotom', '1'); else this._remove('uvodPotom'); },

      // "Vypisovat mnozstvi u vseho" - viz spiz. Ulozeno lokalne,
      // je to preference vzhledu, ne data.
      getPantryDetail()   { return this._raw('pantryDetail', '') === '1'; },
      setPantryDetail(on) { if (on) this._write('pantryDetail', '1'); else this._remove('pantryDetail'); },

      // Kdo oznameni odmitl, uz se nema doprosovat. Drzi se v prohlizeci,
      // ne v databazi - je to rozhodnuti o TOMHLE zarizeni.
      getPushOdmitnuto()  { return this._raw('pushOdmitnuto', '') === '1'; },
      setPushOdmitnuto(x) { if (x) this._write('pushOdmitnuto', '1'); else this._remove('pushOdmitnuto'); },

      // Prihlasovaci listek od Workeru (viz worker/src/session.js).
      getSession()        { return this._raw('session', ''); },
      setSession(token)   { if (token) this._write('session', token); else this._remove('session'); },

      getShoppingList()     { return this._json('shopping_list', []); },
      setShoppingList(list) { this._writeJson('shopping_list', list); },

      getReview(slug) {
        const r = this._json('review_' + slug, null);
        return r || { stars: 0, note: '', cooked: 0, lastCooked: null };
      },
      setReview(slug, review) { this._writeJson('review_' + slug, review); },

      // Stav receptu: neuvareno / wishlist / uvareno (4.7).
      getWishlist()       { return this._json('wishlist', []); },
      setWishlist(list)   { this._writeJson('wishlist', list); },
    };

    document.addEventListener("DOMContentLoaded", function() {

    // Recepty uz appka needituje (editace z prohlizece padla i s tokenem
    // GitHubu), takze neni proc drzet kopii - cte se z nich jen.
    const recipes = recipesData;
    let currentSlug = null;

    // --- DOM refs ---
    const grid = document.getElementById('recipe-grid');
    const noResults = document.getElementById('no-results');
    const searchInput = document.getElementById('search');
    let activeCategory = 'all';
    let favorites = Store.getFavorites();

    // Tyhle tri drzi stav, ze ktereho pocita renderGrid (odznaky, filtry).
    // Musi vzniknout drive nez prvni vykresleni, jinak spadne na TDZ.
    let wishlist = Store.getWishlist();
    let pantryItems = [];
    let bookings = [];

    // Slugy, o kterych uz neco vi databaze. Drzime si je proto, aby slo
    // poslat i ODEBRANI: kdyz u receptu bez hodnoceni zhasnes srdicko,
    // vypadne ze seznamu "co posilat" a serveru se o nem nerekne nic -
    // takze v databazi zustane favorite=1 a pri pristim nacteni se
    // oblibeny recept sam vrati. Presne tohle se drive dělo.
    let znameServeru = new Set();

    function toggleFavorite(slug) {
      const i = favorites.indexOf(slug);
      if (i >= 0) favorites.splice(i, 1);
      else favorites.push(slug);
      Store.setFavorites(favorites);
      renderGrid();
      posliStav();
    }

    // --- Scroll reveal ---
    let revealObserver = null;
    function revealCards() {
      const items = grid.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) {
        items.forEach(el => el.classList.add('in'));
        return;
      }
      if (!revealObserver) {
        revealObserver = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            const el = entry.target;
            const delay = Math.min(parseInt(el.dataset.i || '0', 10), 5) * 70;
            setTimeout(() => el.classList.add('in'), delay);
            obs.unobserve(el);
          });
        }, { rootMargin: '0px 0px -40px 0px', threshold: 0.05 });
      }
      items.forEach((el, i) => { el.dataset.i = i % 6; revealObserver.observe(el); });
    }

    // --- Dnešní volba: one dish, chosen by the date, no browsing required ---
    function renderHero() {
      const hero = document.getElementById('hero');
      if (!hero) return;
      // Kdyz uzivatel filtruje, dnesni volba prekazi - hleda neco
      // konkretniho a nabidka "co treba tohle" je v ceste.
      // POZOR: kdyz pribude dalsi filtr, musi se dopsat i sem, jinak
      // hero zustane viset. `activeStav` se sem takhle dostal az pozdeji.
      const browsing = activeCategory !== 'all'
        || searchInput.value.trim() !== ''
        || activeMeal !== ''
        || activeTime !== ''
        || activeStav !== '';
      if (browsing || recipes.length === 0) {
        hero.classList.add('hidden');
        hero.innerHTML = '';
        return;
      }
      const now = new Date();
      const dayIndex = Math.floor((now - new Date(now.getFullYear(), 0, 0)) / 86400000);
      const r = recipes[dayIndex % recipes.length];
      if (hero.dataset.slug === r.slug && !hero.classList.contains('hidden')) return;
      hero.dataset.slug = r.slug;
      hero.classList.remove('hidden');
      hero.innerHTML = `
        <div class="rise mb-12 sm:mb-16 grid sm:grid-cols-[1.05fr_1fr] gap-5 sm:gap-9 items-center">
          <div class="card-media !aspect-[16/11] sm:!aspect-[4/3] order-1 sm:order-2">
            ${r.image
              ? photoTag(r, { eager: true })
              : `<div class="w-full h-full flex items-center justify-center"><span class="display text-[64px] text-border">${esc((r.title || '?').charAt(0))}</span></div>`}
          </div>
          <div class="order-2 sm:order-1">
            <div class="label text-accent mb-3">Dnešní volba</div>
            <h2 class="display text-[30px] sm:text-[42px] text-text mb-3">${esc(r.title)}</h2>
            <p class="text-text-muted text-[14.5px] sm:text-[15px] leading-relaxed mb-5 max-w-[46ch]">${esc(r.description || 'Otevři recept a uvidíš.')}</p>
            <div class="meta text-text-muted flex items-center gap-2.5 mb-6">
              ${r.time ? `<span>${esc(r.time)}</span><span class="opacity-40">/</span>` : ''}
              <span>${esc(r.difficulty || 'Snadné')}</span><span class="opacity-40">/</span>
              <span>${esc(r.servings || '?')} porcí</span>
            </div>
            <div class="flex gap-2.5">
              <button id="hero-open" class="px-5 py-3 rounded-xl bg-accent text-white text-[14px] font-medium hover:bg-accent-hover active:scale-[0.98] transition-all">Otevřít recept</button>
              <button id="hero-cook" class="px-5 py-3 rounded-xl border border-border text-text text-[14px] font-medium hover:border-accent hover:text-accent active:scale-[0.98] transition-all">Vařit hned</button>
            </div>
          </div>
        </div>`;
      document.getElementById('hero-open').addEventListener('click', () => openDetailModal(r.slug));
      document.getElementById('hero-cook').addEventListener('click', () => {
        openDetailModal(r.slug);
        setTimeout(() => document.getElementById('cook-mode-btn').click(), 340);
      });
    }

    // --- View mode ------------------------------------------------------
    let viewMode = Store.getViewMode();

    // -- Vzhled: z podkladu (viz recipe-view.js) udela HTML. --------------
    // Tohle je jediné místo, které ví, jak recept vypadá. Nový skin nahradí
    // tyhle dvě funkce a mozku se nedotkne.

    /**
     * Odznak "co ti chybi" (4.3). Nikdy netvrdi ano/ne - ukazuje miru,
     * protoze inventar se vzdycky rozejde s realitou.
     */
    function odznakPripravenosti(v) {
      const p = v.pripravenost;
      if (!p || p.stav === 'nevim') return '';
      return '<div class="odznak odznak-' + p.stav + '">' + esc(p.popisek) + '</div>';
    }

    /**
     * Stav receptu (4.7). Barva nesmi byt jediny signal, proto tvar:
     * kolecko = neuvareno, hvezdicka = chci vyzkouset, fajfka = uvareno.
     */
    /** "3×" u receptu, ktery uz mas za sebou. Nic netvrdi, jen pocita. */
    function pocetUvareni(v) {
      if (!v.uvareno) return '';
      return '<span class="pocet-uvareni" title="Uvařeno ' + esc(v.uvareno) + '×">' +
        esc(v.uvareno) + '&times;</span>';
    }

    function odznakStavu(v) {
      if (v.stav === 'uvareno') return '<span class="stav-znak" title="Uvařeno">✓</span>';
      if (v.stav === 'wishlist') return '<span class="stav-znak stav-chci" title="Chci vyzkoušet">☆</span>';
      return '<span class="stav-znak stav-ne" title="Neuvařeno">○</span>';
    }

    function cardMarkup(v) {
      return `
          <article class="recipe-card reveal relative text-left cursor-pointer${v.zvyraznit ? ' je-zvyrazneno' : ''}" data-slug="${escAttr(v.slug)}">
            <button class="fav-btn absolute top-2.5 right-2.5 z-10 w-9 h-9 rounded-full bg-black/45 backdrop-blur-sm flex items-center justify-center transition-colors ${v.favorite ? 'text-red-400' : 'text-white/70 hover:text-white'}" data-fav="${escAttr(v.slug)}" aria-label="Přidat do oblíbených">
              <svg class="w-[18px] h-[18px]" fill="${v.favorite ? 'currentColor' : 'none'}" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>
            </button>
            <div class="card-media mb-3">
              ${v.image
                ? photoTag(v)
                : `<div class="w-full h-full flex items-center justify-center"><span class="display text-[34px] text-border">${esc(v.initial)}</span></div>`}
            </div>
            ${v.category ? `<div class="label text-accent mb-1.5">${esc(v.category)}</div>` : ''}
            <h3 class="display text-[16px] sm:text-[19px] text-text mb-2">${esc(v.title)}${pocetUvareni(v)}</h3>
            ${odznakPripravenosti(v)}
            <div class="card-rule mb-2"></div>
            <div class="meta text-text-muted flex items-center gap-2">
              ${v.time ? `<span>${esc(v.time)}</span><span class="opacity-40">/</span>` : ''}
              <span>${esc(v.servingsLabel)}</span>
              ${v.stars ? `<span class="text-amber-400 text-[13px]">${'★'.repeat(v.stars)}</span>` : ''}
            </div>
          </article>`;
    }

    function rowMarkup(v) {
      return `
          <div class="menu-row reveal${v.zvyraznit ? ' je-zvyrazneno' : ''}" data-slug="${escAttr(v.slug)}" data-img="${escAttr(v.image)}">
            <span class="menu-num">${esc(v.number)}</span>
            <span class="menu-title">${odznakStavu(v)}${esc(v.title)}${pocetUvareni(v)}${v.favorite ? ' <span class="text-accent align-middle" style="font-size:0.42em">♥</span>' : ''}</span>
            <span class="menu-time hidden sm:inline">${esc(v.time)}</span>
            ${v.image ? photoTag(v, { cls: 'menu-thumb sm:hidden', alt: '', style: 'grid-row:1/span 2;grid-column:3' }) : ''}
            <span class="menu-sub">${esc(v.subtitle)} ${v.stars ? '<span class="menu-stars">' + '★'.repeat(v.stars) + '</span>' : ''}</span>
          </div>`;
    }

    function renderGrid() {
      // Mozek vybere recepty, vzhled je jen vykresli.
      const matched = filterRecipes(recipes, {
        query: searchInput.value,
        category: activeCategory,
        meal: activeMeal,
        time: activeTime,
        favorites: favorites,
      });

      // Filtr podle spize a stavu receptu. Pripravenost pocita mozek
      // ze spize, ktera je k dispozici jen prihlasenemu.
      const podleStavu = !activeStav ? matched : matched.filter(r => {
        if (activeStav === 'muzu') {
          const p = pripravenost(r, pantryItems);
          return p.stav === 'vse' || p.stav === 'skoro';
        }
        if (activeStav === 'wishlist') return jeVeWishlistu(r.slug);
        if (activeStav === 'uvareno') return getReview(r.slug).cooked > 0;
        if (activeStav === 'neuvareno') return !(getReview(r.slug).cooked > 0);
        return true;
      });

      // Mozek pripravi podklad pro kazdy recept, vzhled uz jen sklada HTML.
      const view = gridView(podleStavu, {
        mode: viewMode === 'grid' ? 'grid' : 'list',
        isFavorite: slug => favorites.includes(slug),
        ratingOf: getUserRating,
        pripravenostOf: r => (pantryItems.length ? pripravenost(r, pantryItems) : null),
        stavOf: slug => (getReview(slug).cooked > 0
          ? 'uvareno'
          : (jeVeWishlistu(slug) ? 'wishlist' : 'neuvareno')),
        uvarenoOf: slug => getReview(slug).cooked || 0,
        // Kdyz filtruju podle stavu, at je videt, PROC tam ten recept je.
        zvyraznitStav: activeStav,
      });
      const visible = view.count;
      const html = view.items
        .map(item => (view.mode === 'grid' ? cardMarkup(item) : rowMarkup(item)))
        .join('');

      grid.className = viewMode === 'grid'
        ? 'grid grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-8 sm:gap-x-6 sm:gap-y-10'
        : 'block';
      grid.innerHTML = html;
      noResults.classList.toggle('hidden', visible > 0);

      const gh = document.getElementById('grid-heading');
      const gc = document.getElementById('grid-count');
      const gt = document.getElementById('grid-title');
      if (gh) {
        gh.classList.toggle('hidden', visible === 0);
        if (visible > 0) gh.classList.add('flex');
      }
      if (gt) gt.textContent = headingFor(activeCategory);
      if (gc) gc.textContent = countLabel(visible);

      grid.querySelectorAll('.recipe-card, .menu-row').forEach(c =>
        c.addEventListener('click', () => openDetailModal(c.dataset.slug))
      );
      grid.querySelectorAll('.fav-btn').forEach(b =>
        b.addEventListener('click', e => { e.stopPropagation(); toggleFavorite(b.dataset.fav); })
      );

      bindHoverPreview();
      revealCards();
      renderHero();
    }

    // --- Cursor-following dish preview (pointer devices only) ------------
    const preview = document.getElementById('hover-preview');
    const previewImg = preview ? preview.querySelector('img') : null;
    let px = 0, py = 0, tx = 0, ty = 0, previewRaf = null;

    function previewLoop() {
      px += (tx - px) * 0.14;
      py += (ty - py) * 0.14;
      preview.style.translate = px + 'px ' + py + 'px';
      previewRaf = requestAnimationFrame(previewLoop);
    }

    function bindHoverPreview() {
      if (!preview || !window.matchMedia('(hover: hover)').matches) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      grid.querySelectorAll('.menu-row').forEach(row => {
        row.addEventListener('mouseenter', () => {
          const src = row.dataset.img;
          if (!src) return;
          previewImg.src = src;
          preview.classList.add('on');
          if (!previewRaf) previewLoop();
        });
        row.addEventListener('mouseleave', () => {
          preview.classList.remove('on');
          // Smycku zastavujeme. Drive bezel requestAnimationFrame do
          // konce zivota stranky, i kdyz uz nebylo co posouvat.
          if (previewRaf) { cancelAnimationFrame(previewRaf); previewRaf = null; }
        });
      });
    }

    document.addEventListener('mousemove', e => {
      tx = e.clientX + 150;
      ty = e.clientY;
      if (tx > window.innerWidth - 130) tx = e.clientX - 150;
    });

    // --- View toggle -----------------------------------------------------
    const viewToggle = document.getElementById('view-toggle');
    if (viewToggle) {
      viewToggle.querySelectorAll('button').forEach(b => {
        b.classList.toggle('on', b.dataset.view === viewMode);
        b.addEventListener('click', () => {
          viewMode = b.dataset.view;
          Store.setViewMode(viewMode);
          viewToggle.querySelectorAll('button').forEach(x => x.classList.toggle('on', x.dataset.view === viewMode));
          preview.classList.remove('on');
          renderGrid();
        });
      });
    }


    // --- Filters ---
    // active secondary filters
    let activeMeal = '';
    let activeTime = '';
    let activeStav = '';

    function updateFilters() {
      const bar  = document.getElementById('filter-bar');
      const bar2 = document.getElementById('filter-bar-2');
      const bar3 = document.getElementById('filter-bar-3');
      if (!bar || !bar2 || !bar3) return;

      // Row 1: view switches only. Category pills lived here, but with this
      // many recipes they barely narrowed anything and overlapped with the
      // course filters below.
      let h1 = `<button class="filter-btn pill ${activeCategory === 'all' ? 'is-active' : ''}" data-category="all">Vše</button>`;
      h1 += `<button class="filter-btn pill ${activeCategory === '__fav' ? 'is-active' : ''}" data-category="__fav">♥ Oblíbené</button>`;
      bar.innerHTML = h1;
      bar.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', () => { activeCategory = btn.dataset.category; updateFilters(); renderGrid(); });
      });

      // Row 2: chod a cas. Ingredientove stitky tu kdysi byly taky, ale
      // sestnact jich zabralo tri radky a pohrbilo dva filtry, ktere stoji
      // za prohlednuti. Hledani "kure" tuhle praci zvladne lip.
      const allMeals = [...new Set(recipes.flatMap(r => r.meal_type || []))];
      const mealOrder = ['snídaně','svačina','oběd','večeře','dezert','polévka','příloha','ostatní'];
      allMeals.sort((a,b) => mealOrder.indexOf(a) - mealOrder.indexOf(b));
      const timeBuckets = [
        { key: '20',  label: 'do 20 min' },
        { key: '45',  label: 'do 45 min' },
        { key: '90',  label: 'do 90 min' },
        { key: '90+', label: '90 min+'   },
      ];

      let h2 = '';
      if (allMeals.length) {
        h2 += '<span class="filtr-popisek">Chod</span>';
        allMeals.forEach(m => {
          h2 += `<button class="filter-btn pill pill-sm ${activeMeal === m ? 'is-active' : ''}" data-meal="${m}">${m}</button>`;
        });
        h2 += '<span class="pill-sep"></span>';
      }
      h2 += '<span class="filtr-popisek">Čas</span>';
      timeBuckets.forEach(b => {
        h2 += `<button class="filter-btn pill pill-sm ${activeTime === b.key ? 'is-active' : ''}" data-time="${b.key}">${b.label}</button>`;
      });
      bar2.innerHTML = h2;

      // Row 3: stav receptu je jina osa nez chod a cas - tri moznosti, ze
      // kterych plati vzdy nejvys jedna. Proto prepinac, ne dalsi pilulky
      // v rade: je na prvni pohled videt, ze se navzajem vylucuji.
      const stavy = [
        { key: 'neuvareno', znak: '○', label: 'Neuvařeno' },
        { key: 'uvareno',   znak: '✓', label: 'Uvařeno'   },
        { key: 'wishlist',  znak: '☆', label: 'Chci vyzkoušet' },
      ];

      let h3 = '<span class="filtr-popisek">Stav</span><span class="prepinac">';
      stavy.forEach(x => {
        h3 += `<button class="filter-btn prepinac-btn ${activeStav === x.key ? 'is-active' : ''}" data-stav="${x.key}">` +
              `<span class="prepinac-znak">${x.znak}</span>${x.label}</button>`;
      });
      h3 += '</span>';

      // Spiz je zase jina osa - nezavisi na tom, co uz mam za sebou.
      h3 += '<span class="pill-sep"></span>';
      h3 += `<button class="filter-btn pill pill-sm ${activeStav === 'muzu' ? 'is-active' : ''}" data-stav="muzu">🥫 Můžu uvařit</button>`;

      // Kdyz neco filtruje, musi jit jednim klikem vypnout. Jinak clovek
      // hleda, ktera pilulka mu schovala pulku kucharky.
      const filtrujeSe = activeCategory !== 'all' || activeMeal || activeTime || activeStav;
      if (filtrujeSe) {
        h3 += '<button id="filtr-zrusit" class="filtr-zrusit">✕ Zrušit filtry</button>';
      }
      bar3.innerHTML = h3;

      [bar2, bar3].forEach(pruh => {
        pruh.querySelectorAll('.filter-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            if (btn.dataset.meal !== undefined) activeMeal = activeMeal === btn.dataset.meal ? '' : btn.dataset.meal;
            if (btn.dataset.time !== undefined) activeTime = activeTime === btn.dataset.time ? '' : btn.dataset.time;
            if (btn.dataset.stav !== undefined) activeStav = activeStav === btn.dataset.stav ? '' : btn.dataset.stav;
            updateFilters(); renderGrid();
          });
        });
      });

      const zrusit = document.getElementById('filtr-zrusit');
      if (zrusit) zrusit.addEventListener('click', () => {
        activeCategory = 'all'; activeMeal = ''; activeTime = ''; activeStav = '';
        updateFilters(); renderGrid();
      });

      const navAll = document.getElementById('nav-all');
      const navFav = document.getElementById('nav-fav');
      if (navAll) navAll.classList.toggle('text-accent', activeCategory !== '__fav');
      if (navFav) navFav.classList.toggle('text-accent', activeCategory === '__fav');
    }

    // Prekreslovat celou mrizku na kazde pismeno je zbytecne - pri psani
    // stejne nikdo nestiha cist. Ctvrt vteriny ticha a jde se kreslit.
    let hledaniTimer = null;
    searchInput.addEventListener('input', () => {
      clearTimeout(hledaniTimer);
      hledaniTimer = setTimeout(renderGrid, 160);
    });

    // --- Detail modal ---
    const overlay = document.getElementById('modal-overlay');
    const modal = document.getElementById('modal');

    let currentServings = 4;


    // A blurred 20px stand-in rides along in the JSON, so a card never sits
    // empty while its photo downloads. The real photo paints straight over it.
    function photoTag(r, opts) {
      opts = opts || {};
      if (!r.image) return '';
      const blur = r.blur ? 'background-image:url(' + escAttr(r.blur) + ');' : '';
      return '<img class="photo ' + (opts.cls || '') + '" src="' + escAttr(r.image) + '"' +
        ' alt="' + escAttr(opts.alt === '' ? '' : (r.title || '')) + '"' +
        (opts.eager ? ' fetchpriority="high"' : ' loading="lazy"') +
        ' decoding="async" style="' + blur + (opts.style || '') + '" />';
    }

    function setPhoto(el, r) {
      if (!el) return;
      el.src = r.image || '';
      el.style.backgroundImage = r.blur ? 'url(' + r.blur + ')' : '';
    }

    // ---- Basic / Fancy -------------------------------------------------
    let fancyMode = false; // vždy začíná v basic módu

    // A recipe may carry a second, more involved version of itself.
    // Missing pieces fall back to the basic ones, so the switch works everywhere.
    function variantOf(r) {
      if (!fancyMode) return {
        ingredients: r.ingredients || [],
        steps: r.steps || [],
        description: r.description || '',
        time: r.time || '',
        tip: r.tip || '',
        own: true
      };
      return {
        ingredients: r.ingredients_fancy || r.ingredients || [],
        steps: r.steps_fancy || r.steps || [],
        description: r.description_fancy || r.description || '',
        time: r.time_fancy || r.time || '',
        tip: r.tip_fancy || r.tip || '',
        own: !!(r.ingredients_fancy || r.steps_fancy)
      };
    }


    function renderIngredients(r) {
      const base = r.servings || 4;
      const factor = currentServings / base;
      document.getElementById('portion-value').textContent =
        currentServings + ' ' + (currentServings === 1 ? 'porce' : currentServings < 5 ? 'porce' : 'porcí');
      const ingList = document.getElementById('modal-ingredients');
      const list = variantOf(r).ingredients;

      if (fancyMode) {
        ingList.className = 'f-ing-list';
        ingList.innerHTML = list.map(raw => {
          const parts = splitQty(scaleIngredient(raw, factor));
          return '<li class="f-ing">' +
            '<span class="f-ing-name">' + esc(parts.name) + '</span>' +
            (parts.qty ? '<span class="f-ing-dots"></span><span class="f-ing-qty">' + esc(parts.qty) + '</span>' : '') +
            '</li>';
        }).join('');
        ingList.querySelectorAll('.f-ing').forEach(li =>
          li.addEventListener('click', () => li.classList.toggle('is-done'))
        );
        return;
      }

      ingList.className = 'space-y-2';
      ingList.innerHTML = list.map(raw => {
        const ing = scaleIngredient(raw, factor);
        return `<li class="flex items-start gap-3 cursor-pointer group ingredient-item">
          <span class="mt-[3px] w-[18px] h-[18px] shrink-0 rounded border border-border group-hover:border-accent flex items-center justify-center transition-colors checkbox">
            <svg class="w-3 h-3 text-accent opacity-0 check-icon transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
          </span>
          <span class="text-[15px] text-text-muted group-hover:text-text transition-colors ing-text">${esc(ing)}</span>
        </li>`;
      }).join('');
      ingList.querySelectorAll('.ingredient-item').forEach(item => {
        item.addEventListener('click', () => {
          const ck = item.querySelector('.check-icon');
          const txt = item.querySelector('.ing-text');
          const on = ck.style.opacity === '1';
          ck.style.opacity = on ? '0' : '1';
          item.querySelector('.checkbox').classList.toggle('border-accent', !on);
          txt.classList.toggle('line-through', !on);
          txt.classList.toggle('opacity-40', !on);
        });
      });
    }

    document.getElementById('portion-minus').addEventListener('click', () => {
      if (currentServings <= 1) return;
      currentServings--;
      const r = recipes.find(x => x.slug === currentSlug);
      if (r) renderIngredients(r);
    });
    document.getElementById('portion-plus').addEventListener('click', () => {
      if (currentServings >= 20) return;
      currentServings++;
      const r = recipes.find(x => x.slug === currentSlug);
      if (r) renderIngredients(r);
    });

    function renderSteps(r) {
      const v = variantOf(r);
      const el = document.getElementById('modal-steps');

      if (fancyMode) {
        el.className = 'f-step-list';
        el.innerHTML = v.steps.map((s, i) =>
          '<li class="f-step"><span class="f-step-num">' + roman(i + 1) + '</span>' +
          '<p class="f-step-text">' + esc(s) + '</p></li>'
        ).join('');
        return;
      }

      el.className = 'space-y-5';
      el.innerHTML = v.steps.map((s, i) =>
        '<li class="flex gap-4 sm:gap-5"><span class="display shrink-0 w-8 text-[22px] leading-none text-accent/70 pt-0.5 text-right">' + (i + 1) + '</span>' +
        '<p class="text-[15px] text-text-muted leading-[1.7]">' + esc(s) + '</p></li>'
      ).join('');
    }

    // Everything that is not the ingredient/step lists: headings, meta, note.
    function renderModeChrome(r) {
      const v = variantOf(r);
      const headIng  = document.getElementById('head-ingredients');
      const headStep = document.getElementById('head-steps');
      const fleuron  = document.getElementById('modal-fleuron');
      const note     = document.getElementById('modal-note');
      const tipEl    = document.getElementById('modal-tip');

      modal.classList.toggle('is-fancy', fancyMode);
      document.querySelectorAll('#mode-toggle .mode-opt').forEach(b =>
        b.classList.toggle('is-on', (b.dataset.mode === 'fancy') === fancyMode)
      );

      document.getElementById('modal-description').textContent = v.description;
      document.getElementById('modal-meta').innerHTML =
        (v.time ? '<span>' + esc(v.time) + '</span><span class="opacity-40">/</span>' : '') +
        '<span>' + esc(r.difficulty || '') + '</span><span class="opacity-40">/</span>' +
        '<span>' + esc(r.servings || '?') + ' porcí</span>';

      if (fancyMode) {
        headIng.className  = 'f-head';
        headStep.className = 'f-head';
        headIng.innerHTML  = '<span>Suroviny</span>';
        headStep.innerHTML = '<span>Postup</span>';
        fleuron.classList.remove('hidden');
        if (v.own) { note.classList.add('hidden'); }
        else {
          note.classList.remove('hidden');
          note.textContent = 'Pro tento recept zatím není vlastní Fancy verze — vidíš základní postup.';
        }
      } else {
        headIng.className  = 'label text-accent mb-4';
        headStep.className = 'label text-accent mb-5';
        headIng.textContent  = 'Ingredience';
        headStep.textContent = 'Postup';
        fleuron.classList.add('hidden');
        note.classList.add('hidden');
      }

      if (v.tip) { tipEl.classList.remove('hidden'); document.getElementById('modal-tip-text').textContent = v.tip; }
      else { tipEl.classList.add('hidden'); }
    }

    // The switch. Content changes behind a sweep of gold light.
    let morphing = false;
    function setRecipeMode(next) {
      if (morphing || next === fancyMode) return;
      const r = recipes.find(x => x.slug === currentSlug);
      if (!r) return;

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      fancyMode = next;
      Store.setRecipeMode(next ? 'fancy' : 'basic');

      const paint = () => {
        renderIngredients(r);
        renderSteps(r);
        renderModeChrome(r);
        // Tlacitko "chci vyzkouset" patri k receptu, ne k rezimu - ale
        // prekresluje se s nim, at je stav videt i po prepnuti.
        paintWishBtn(currentSlug);
        if (reduce) return;
        const body = document.getElementById('modal-body');
        body.classList.remove('mode-rise');
        void body.offsetWidth;
        body.classList.add('mode-rise');
      };

      if (reduce) { paint(); return; }

      morphing = true;
      modal.classList.remove('is-morphing');
      void modal.offsetWidth;
      modal.classList.add('is-morphing');
      setTimeout(paint, 250);
      setTimeout(() => { modal.classList.remove('is-morphing'); morphing = false; }, 900);
    }

    document.querySelectorAll('#mode-toggle .mode-opt').forEach(btn =>
      btn.addEventListener('click', () => setRecipeMode(btn.dataset.mode === 'fancy'))
    );

    function openDetailModal(slug) {
      const r = recipes.find(x => x.slug === slug);
      if (!r) return;
      currentSlug = slug;
      currentServings = r.servings || 4;
      setPhoto(document.getElementById('modal-image'), r);
      document.getElementById('modal-title').textContent = r.title;
      document.getElementById('modal-description').textContent = r.description || '';
      document.getElementById('modal-meta').innerHTML =
        `${r.time ? `<span>${esc(r.time)}</span><span class="opacity-40">/</span>` : ''}` +
        `<span>${esc(r.difficulty || '')}</span><span class="opacity-40">/</span><span>${esc(r.servings || '?')} porcí</span>`;

      renderIngredients(r);
      renderSteps(r);
      renderModeChrome(r);
      renderStars(slug);

      overlay.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => { overlay.classList.remove('opacity-0'); modal.classList.remove('translate-x-full'); });
    }

    function closeDetailModal() {
      overlay.classList.add('opacity-0');
      modal.classList.add('translate-x-full');
      setTimeout(() => { overlay.classList.add('hidden'); document.body.style.overflow = ''; modal.scrollTop = 0; }, 300);
    }
    document.getElementById('modal-close').addEventListener('click', closeDetailModal);
    overlay.addEventListener('click', e => { if (e.target === overlay) closeDetailModal(); });

    // --- Settings ---
    const settingsOverlay = document.getElementById('settings-overlay');
    const settingsModal = document.getElementById('settings-modal');

    function highlightActiveTheme() {
      const current = Store.getTheme();
      document.querySelectorAll('.theme-swatch').forEach(btn => {
        const ring = btn.querySelector('div');
        const isActive = btn.dataset.theme === current;
        ring.classList.toggle('ring-2', isActive);
        ring.classList.toggle('ring-accent', isActive);
      });
    }

    document.querySelectorAll('.theme-swatch').forEach(btn => {
      btn.addEventListener('click', () => {
        const theme = btn.dataset.theme;
        if (theme) {
          Store.setTheme(theme);
          document.documentElement.setAttribute('data-theme', theme);
        } else {
          Store.setTheme(null);
          document.documentElement.removeAttribute('data-theme');
        }
        highlightActiveTheme();
      });
    });

    document.getElementById('settings-btn').addEventListener('click', () => {
      highlightActiveTheme();
      settingsOverlay.classList.remove('hidden');
      requestAnimationFrame(() => { settingsOverlay.classList.remove('opacity-0'); settingsModal.classList.remove('scale-95', 'opacity-0'); });
    });
    function closeSettings() {
      settingsOverlay.classList.add('opacity-0');
      settingsModal.classList.add('scale-95', 'opacity-0');
      setTimeout(() => settingsOverlay.classList.add('hidden'), 200);
    }
    document.getElementById('settings-close').addEventListener('click', closeSettings);
    settingsOverlay.addEventListener('click', e => { if (e.target === settingsOverlay) closeSettings(); });

    // --- Chef AI ---
    const chefOverlay = document.getElementById('chef-overlay');
    const chefModal = document.getElementById('chef-modal');
    const chefInput = document.getElementById('chef-input');
    const chefResults = document.getElementById('chef-results');
    const chefMatches = document.getElementById('chef-matches');
    const chefAiResult = document.getElementById('chef-ai-result');
    const chefAiText = document.getElementById('chef-ai-text');
    const chefLoading = document.getElementById('chef-loading');

    document.getElementById('chef-btn').addEventListener('click', () => {
      chefOverlay.classList.remove('hidden');
      requestAnimationFrame(() => { chefOverlay.classList.remove('opacity-0'); chefModal.classList.remove('translate-x-full'); });
      chefInput.focus();
    });

    function closeChef() {
      chefOverlay.classList.add('opacity-0');
      chefModal.classList.add('translate-x-full');
      setTimeout(() => chefOverlay.classList.add('hidden'), 300);
    }
    document.getElementById('chef-close').addEventListener('click', closeChef);
    chefOverlay.addEventListener('click', e => { if (e.target === chefOverlay) closeChef(); });

    document.getElementById('chef-search').addEventListener('click', () => {
      const userIngs = parseIngredients(chefInput.value);
      if (userIngs.length === 0) return;

      const scored = recipes.map(r => {
        const total = (r.ingredients || []).length;
        if (total === 0) return null;
        const matched = (r.ingredients || []).filter(ing => ingredientMatch(userIngs, ing)).length;
        return { recipe: r, matched, total, pct: Math.round((matched / total) * 100) };
      }).filter(s => s && s.matched > 0).sort((a, b) => b.pct - a.pct || b.matched - a.matched);

      if (scored.length === 0) {
        chefMatches.innerHTML = '<p class="text-text-muted text-[14px]">Žádný recept neodpovídá tvým ingrediencím.</p>';
      } else {
        chefMatches.innerHTML = scored.map(s => `
          <button class="chef-match w-full text-left p-4 rounded-xl bg-surface border border-border hover:border-accent transition-colors" data-slug="${escAttr(s.recipe.slug)}">
            <div class="flex items-center justify-between mb-1">
              <span class="text-[15px] font-medium text-text">${esc(s.recipe.title)}</span>
              <span class="text-[13px] font-semibold ${s.pct >= 75 ? 'text-green-400' : s.pct >= 40 ? 'text-amber-400' : 'text-red-400'}">${s.pct}%</span>
            </div>
            <div class="text-[13px] text-text-muted">${s.matched} z ${s.total} ingrediencí • ${esc(s.recipe.time || '?')} • ${esc(s.recipe.difficulty || 'Snadné')}</div>
          </button>
        `).join('');
        chefMatches.querySelectorAll('.chef-match').forEach(btn => {
          btn.addEventListener('click', () => { closeChef(); setTimeout(() => openDetailModal(btn.dataset.slug), 350); });
        });
      }
      chefResults.classList.remove('hidden');
      chefAiResult.classList.add('hidden');
    });

    document.getElementById('chef-ai').addEventListener('click', async () => {
      const userIngs = parseIngredients(chefInput.value);
      if (userIngs.length === 0) return;

      chefLoading.classList.remove('hidden');
      chefAiResult.classList.add('hidden');

      // Text dotazu sklada Worker. Odsud jdou ven jen data.
      try {
        const res = await fetch(AI_WORKER, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'recommend',
            ingredients: userIngs.join(', '),
            recipes: recipes.map(r => ({
              slug: r.slug,
              title: r.title,
              ingredients: r.ingredients || [],
            })),
          })
        });

        if (!res.ok) throw new Error('Worker chyba ' + res.status);

        chefAiResult.classList.remove('hidden');
        chefAiText.innerHTML = '';

        let chefRawText = '';
        const chefReader = res.body.getReader();
        const chefDecoder = new TextDecoder();
        let chefBuffer = '';

        while (true) {
          const { done, value } = await chefReader.read();
          if (done) break;
          chefBuffer += chefDecoder.decode(value, { stream: true });
          const chefLines = chefBuffer.split('\n');
          chefBuffer = chefLines.pop();
          for (const line of chefLines) {
            if (!line.startsWith('data: ')) continue;
            const data = line.slice(6).trim();
            if (data === '[DONE]') break;
            try {
              const parsed = JSON.parse(data);
              const delta = parsed.delta?.text || parsed.choices?.[0]?.delta?.content || '';
              if (delta) chefRawText += delta;
            } catch {}
          }
          // Zobraz průběžně bez SLUGS řádku
          const displayText = chefRawText.replace(/%%SLUGS:[^%]*%%?\s*$/, '').trimEnd();
          chefAiText.innerHTML = renderMarkdown(displayText);
        }

        if (!chefRawText) throw new Error('Prázdná odpověď od AI.');

        // Po dokončení – najdi zmíněné recepty v textu a přidej kartičky
        const cleanText = chefRawText.replace(/%%SLUGS:[^%]+%%/g, '').trimEnd();
        let finalHtml = renderMarkdown(cleanText);

        // Priorita: SLUGS tag → fallback: hledej slug v textu
        let foundSlugs = [];
        const slugTagMatch = chefRawText.match(/%%SLUGS:([^%]+)%%/);
        if (slugTagMatch) {
          foundSlugs = slugTagMatch[1].split(',').map(s => s.trim()).filter(Boolean);
        } else {
          // Fallback – hledej každý slug z recipes v textu AI
          recipes.forEach(r => {
            if (chefRawText.includes(r.slug) || chefRawText.toLowerCase().includes(r.title.toLowerCase())) {
              foundSlugs.push(r.slug);
            }
          });
        }

        if (foundSlugs.length > 0) {
          finalHtml += '<div class="mt-5 space-y-3">';
          foundSlugs.forEach(slug => {
            const recipe = recipes.find(r => r.slug === slug);
            if (!recipe) return;
            const img = recipe.image || '';
            finalHtml += '<div class="chef-card rounded-xl border border-border overflow-hidden bg-surface flex cursor-pointer hover:border-accent transition-colors group" data-slug="' + escAttr(recipe.slug) + '">';
            if (img) finalHtml += '<img src="' + escAttr(img) + '" alt="' + escAttr(recipe.title) + '" class="w-20 h-20 object-cover shrink-0" />';
            finalHtml += '<div class="p-3 flex flex-col justify-center gap-0.5">';
            finalHtml += '<span class="text-[15px] font-semibold text-text group-hover:text-accent transition-colors">' + esc(recipe.title) + ' →</span>';
            const meta = [recipe.time, recipe.difficulty].filter(Boolean).join(' · ');
            if (meta) finalHtml += '<span class="text-[12px] text-text-muted">' + esc(meta) + '</span>';
            finalHtml += '</div></div>';
          });
          finalHtml += '</div>';
        }

        chefAiText.innerHTML = finalHtml;
        // Karty se vesi posluchacem, ne inline onclick atributem.
        chefAiText.querySelectorAll('.chef-card').forEach(card => {
          const slug = card.dataset.slug;
          card.addEventListener('click', () => {
            closeChef();
            setTimeout(() => openDetailModal(slug), 350);
          });
        });
      } catch (err) {
        chefAiText.textContent = 'Chyba: ' + err.message;
        chefAiResult.classList.remove('hidden');
      }
      chefLoading.classList.add('hidden');
    });

    // --- Cooking mode ---
    const cookOverlay   = document.getElementById('cook-overlay');
    const cookTitle     = document.getElementById('cook-title');
    const cookProgress  = document.getElementById('cook-progress');
    const cookStepNum   = document.getElementById('cook-step-num');
    const cookStepText  = document.getElementById('cook-step-text');
    const cookStepTimer = document.getElementById('cook-step-timer');
    const cookSlide     = document.getElementById('cook-slide');
    const cookStage     = document.getElementById('cook-stage');
    const cookTimersBar = document.getElementById('cook-timers');
    const cookPrev      = document.getElementById('cook-prev');
    const cookNext      = document.getElementById('cook-next');
    // Kde v receptu jsme - rozhoduje mozek (cook-session.js).
    let cookSession = createSession([]);
    let cookRecipe = null;
    let cookServings = 4;
    let cookAnimating = false;
    let wakeLock = null;

    async function requestWakeLock() {
      try { if ('wakeLock' in navigator) wakeLock = await navigator.wakeLock.request('screen'); } catch {}
    }
    function releaseWakeLock() {
      try { if (wakeLock) { wakeLock.release(); wakeLock = null; } } catch {}
    }
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && cookOverlay && !cookOverlay.classList.contains('hidden')) requestWakeLock();
    });

    // -- Parallel timers --
    // Casovace drzi mozek (cook-timers.js), hodiny tikaji tady ve vzhledu.
    let cookTimers = createTimers();
    let timerTick = null;
    let audioCtx = null;

    function beep() {
      try {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (AC) {
          audioCtx = audioCtx || new AC();
          if (audioCtx.state === 'suspended') audioCtx.resume();
          [0, 0.3, 0.6].forEach(off => {
            const o = audioCtx.createOscillator(), g = audioCtx.createGain();
            o.connect(g); g.connect(audioCtx.destination);
            o.type = 'sine'; o.frequency.value = 880;
            const t = audioCtx.currentTime + off;
            g.gain.setValueAtTime(0.0001, t);
            g.gain.exponentialRampToValueAtTime(0.4, t + 0.02);
            g.gain.exponentialRampToValueAtTime(0.0001, t + 0.25);
            o.start(t); o.stop(t + 0.27);
          });
        }
      } catch {}
      try { if (navigator.vibrate) navigator.vibrate([300, 130, 300, 130, 300]); } catch {}
    }

    function notifyDone(t) {
      beep();
      try {
        if ('Notification' in window && Notification.permission === 'granted') {
          new Notification('\u010casova\u010d dob\u011bhl \u2014 krok ' + t.step, { body: t.label, tag: 'cook-' + t.id });
        }
      } catch {}
    }

    function startTimer(secs, label, stepNo) {
      const res = addTimer(cookTimers, secs, label, stepNo);
      if (!res.added) return;   // duplicitu odmitl mozek
      cookTimers = res.state;
      // O povoleni k oznamenim si tady ZAMERNE nerikame. Prohlizec zna
      // jen jedno spolecne povoleni, a kdyz ho clovek udelil casovaci,
      // nabidka push oznameni (`zvazNabidkuOznameni`) uz se neukazala -
      // takze mu pripominka pred varenim nikdy nepipla. Ptame se na
      // jednom miste, u te nabidky; casovac pouzije povoleni, kdyz uz je.
      try { const AC = window.AudioContext || window.webkitAudioContext; if (AC) { audioCtx = audioCtx || new AC(); if (audioCtx.state === 'suspended') audioCtx.resume(); } } catch {}
      if (!timerTick) timerTick = setInterval(tickTimers, 1000);
      renderTimers(); renderStepTimerBtns();
    }

    // Hodiny. Odpocet uz nepocitame tady - jen rekneme mozku, ze
    // uplynula vterina, a on vrati, co prave dobehlo.
    function tickTimers() {
      const res = tickTimerState(cookTimers, 1);
      cookTimers = res.state;
      res.finished.forEach(notifyDone);
      if (!hasRunning(cookTimers) && timerTick) { clearInterval(timerTick); timerTick = null; }
      renderTimers();
    }

    function renderTimers() {
      if (!cookTimersBar) return;
      if (noTimers(cookTimers)) { cookTimersBar.classList.add('hidden'); cookTimersBar.classList.remove('flex'); cookTimersBar.innerHTML = ''; return; }
      cookTimersBar.classList.remove('hidden'); cookTimersBar.classList.add('flex');
      // Procenta i text uz spocital mozek - tady se jen vykresluje.
      cookTimersBar.innerHTML = timerViews(cookTimers).map(t =>
        '<button class="timer-chip' + (t.done ? ' is-done' : '') + '" data-tid="' + escAttr(t.id) + '" style="--p:' + t.percent + '%">' +
        '<span class="timer-step">' + esc(t.step) + '</span>' +
        '<span class="timer-clock">' + esc(t.clock) + '</span>' +
        '<span class="timer-x">×</span></button>'
      ).join('');
      cookTimersBar.querySelectorAll('.timer-chip').forEach(c => {
        c.addEventListener('click', e => {
          e.stopPropagation();
          cookTimers = removeTimer(cookTimers, c.dataset.tid);
          if (!hasRunning(cookTimers) && timerTick) { clearInterval(timerTick); timerTick = null; }
          renderTimers(); renderStepTimerBtns();
        });
      });
    }

    function renderStepTimerBtns() {
      if (!cookStepTimer) return;
      const ds = parseDurations(currentStep(cookSession));
      if (ds.length === 0) { cookStepTimer.classList.add('hidden'); cookStepTimer.classList.remove('flex'); cookStepTimer.innerHTML = ''; return; }
      cookStepTimer.classList.remove('hidden'); cookStepTimer.classList.add('flex');
      cookStepTimer.innerHTML = ds.map(d => {
        const running = isRunning(cookTimers, stepNumber(cookSession), d.secs);
        return '<button class="timer-start' + (running ? ' is-running' : '') + '" data-secs="' + d.secs + '" data-label="' + d.label.replace(/"/g, '&quot;') + '"' + (running ? ' disabled' : '') + '>' +
               '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>' +
               (running ? 'B\u011b\u017e\u00ed' : fmtClock(d.secs)) + '</button>';
      }).join('');
      cookStepTimer.querySelectorAll('.timer-start').forEach(b => {
        b.addEventListener('click', e => {
          e.stopPropagation();
          startTimer(parseInt(b.dataset.secs, 10), b.dataset.label, stepNumber(cookSession));
        });
      });
    }

    // -- Step rendering + transition --
    function paintStep() {
      // Vsechny popisky i procenta dodava mozek - tady se jen dosazuji.
      cookStepNum.textContent = stepLabel(cookSession, fancyMode);
      const ghost = document.getElementById('cook-ghost');
      if (ghost) ghost.textContent = ghostLabel(cookSession, fancyMode);
      cookStepText.textContent = currentStep(cookSession);
      cookProgress.textContent = progressLabel(cookSession, fancyMode);
      document.getElementById('cook-bar').style.width = progressPercent(cookSession) + '%';
      if (cookPrev) cookPrev.disabled = stepNumber(cookSession) === 1;
      if (cookNext) cookNext.textContent = nextLabel(cookSession);
      renderStepTimerBtns();
    }

    // Prechod mezi kroky. Kam se smi jit rozhoduje mozek, tady je jen animace.
    function goStep(target, dir) {
      if (cookAnimating) return;
      const moved = goTo(cookSession, target);
      if (moved === cookSession) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { cookSession = moved; paintStep(); return; }
      cookAnimating = true;
      cookSlide.style.setProperty('--dir', dir > 0 ? '-1' : '1');
      cookSlide.classList.add('is-out');
      setTimeout(() => {
        cookSession = moved;
        paintStep();
        cookSlide.classList.remove('is-out');
        cookSlide.style.setProperty('--dir', dir > 0 ? '1' : '-1');
        cookSlide.classList.add('is-pre');
        requestAnimationFrame(() => requestAnimationFrame(() => {
          cookSlide.classList.remove('is-pre');
          setTimeout(() => { cookAnimating = false; }, 280);
        }));
      }, 175);
    }

    function nextStep() { if (!isLast(cookSession)) goStep(cookSession.index + 1, 1); else finishCooking(); }
    function prevStep() { goStep(cookSession.index - 1, -1); }

    // -- Confetti --
    function fireConfetti() {
      const cv = document.getElementById('cook-confetti');
      if (!cv || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const w = cookStage.clientWidth, h = cookStage.clientHeight;
      if (!w || !h) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      cv.width = w * dpr; cv.height = h * dpr;
      cv.style.width = w + 'px'; cv.style.height = h + 'px';
      cv.classList.remove('hidden');
      const ctx = cv.getContext('2d');
      ctx.scale(dpr, dpr);
      let accent = '';
      try { accent = getComputedStyle(document.documentElement).getPropertyValue('--color-accent').trim(); } catch {}
      const colors = [accent || '#e07850', '#ffffff', '#ffd166', '#06d6a0', '#ef476f'];
      const parts = [];
      for (let i = 0; i < 150; i++) {
        parts.push({
          x: w / 2 + (Math.random() - 0.5) * w * 0.5,
          y: h * 0.58,
          vx: (Math.random() - 0.5) * 14,
          vy: -Math.random() * 17 - 7,
          s: 4 + Math.random() * 7,
          rot: Math.random() * Math.PI,
          vr: (Math.random() - 0.5) * 0.4,
          c: colors[Math.floor(Math.random() * colors.length)],
          life: 1
        });
      }
      let f = 0;
      (function loop() {
        f++;
        ctx.clearRect(0, 0, w, h);
        parts.forEach(p => {
          if (p.life <= 0) return;
          p.vy += 0.44; p.vx *= 0.995;
          p.x += p.vx; p.y += p.vy; p.rot += p.vr;
          if (p.y > h * 0.7) p.life -= 0.022;
          ctx.save();
          ctx.globalAlpha = Math.max(p.life, 0);
          ctx.translate(p.x, p.y); ctx.rotate(p.rot);
          ctx.fillStyle = p.c;
          ctx.fillRect(-p.s / 2, -p.s / 2, p.s, p.s * 0.62);
          ctx.restore();
        });
        if (f < 200) requestAnimationFrame(loop);
        else { ctx.clearRect(0, 0, w, h); cv.classList.add('hidden'); }
      })();
    }

    let uzDovareno = false;
    function finishCooking() {
      // Tlacitko se po dokonceni prejmenuje na "Zavrit", ale porad vede
      // do nextStep -> finishCooking. Bez pojistky by druhe tuknuti
      // pustilo dalsi konfety a dalsi odpocet do zavreni.
      if (uzDovareno) return closeCookMode();
      uzDovareno = true;
      fireConfetti();
      try { if (navigator.vibrate) navigator.vibrate([60, 50, 60]); } catch {}
      cookStepText.textContent = finishText(fancyMode);
      cookStepNum.textContent = finishLabel(fancyMode);
      cookStepTimer.classList.add('hidden');
      if (cookNext) cookNext.textContent = 'Zav\u0159\u00edt';
      setTimeout(() => { if (!cookOverlay.classList.contains('hidden')) closeCookMode(); }, 2600);
    }

    // -- Ingredients drawer --
    const cookIngPanel    = document.getElementById('cook-ing-panel');
    const cookIngBackdrop = document.getElementById('cook-ing-backdrop');
    const cookIngList     = document.getElementById('cook-ing-list');
    const cookIngValue    = document.getElementById('cook-ing-value');
    let cookIngOpen = false;

    function renderCookIngredients() {
      if (!cookRecipe || !cookIngList) return;
      const base = cookRecipe.servings || 4;
      const factor = cookServings / base;
      cookIngValue.textContent = cookServings + ' ' + (cookServings < 5 ? 'porce' : 'porc\u00ed');
      cookIngList.innerHTML = (variantOf(cookRecipe).ingredients || []).map(raw =>
        '<li class="cook-ing"><span class="cook-ing-box"></span><span class="cook-ing-txt">' + esc(scaleIngredient(raw, factor)) + '</span></li>'
      ).join('');
      cookIngList.querySelectorAll('.cook-ing').forEach(li =>
        li.addEventListener('click', () => li.classList.toggle('is-done'))
      );
    }

    function setCookIng(open) {
      cookIngOpen = open;
      cookIngPanel.classList.toggle('translate-y-full', !open);
      cookIngBackdrop.classList.toggle('hidden', !open);
    }
    document.getElementById('cook-ing-btn').addEventListener('click', () => { renderCookIngredients(); setCookIng(true); });
    document.getElementById('cook-ing-close').addEventListener('click', () => setCookIng(false));
    cookIngBackdrop.addEventListener('click', () => setCookIng(false));
    document.getElementById('cook-ing-minus').addEventListener('click', () => { if (cookServings > 1) { cookServings--; renderCookIngredients(); } });
    document.getElementById('cook-ing-plus').addEventListener('click', () => { if (cookServings < 20) { cookServings++; renderCookIngredients(); } });

    // -- Open / close --
    document.getElementById('cook-mode-btn').addEventListener('click', () => {
      const r = recipes.find(x => x.slug === currentSlug);
      if (!r || !variantOf(r).steps.length) return;
      cookRecipe = r;
      uzDovareno = false;
      cookSession = createSession(variantOf(r).steps);
      cookServings = currentServings || r.servings || 4;
      cookTimers = clearTimers(cookTimers);
      if (timerTick) { clearInterval(timerTick); timerTick = null; }
      renderTimers();
      cookTitle.textContent = r.title;
      cookOverlay.classList.toggle('is-fancy', fancyMode);
      paintStep();
      setCookIng(false);
      cookOverlay.classList.remove('hidden');
      cookOverlay.classList.add('flex');
      document.body.style.overflow = 'hidden';
      requestWakeLock();
    });

    function closeCookMode() {
      cookOverlay.classList.add('hidden');
      cookOverlay.classList.remove('flex');
      document.body.style.overflow = '';
      setCookIng(false);
      cookTimers = clearTimers(cookTimers);
      if (timerTick) { clearInterval(timerTick); timerTick = null; }
      renderTimers();
      releaseWakeLock();
    }
    document.getElementById('cook-close').addEventListener('click', closeCookMode);

    // -- Tap zones: left third back, right two-thirds forward --
    cookStage.addEventListener('click', e => {
      if (cookIngOpen) return;
      if (e.target.closest('button, a')) return;
      const rect = cookStage.getBoundingClientRect();
      if ((e.clientX - rect.left) < rect.width * 0.34) prevStep(); else nextStep();
    });

    // -- Swipe --
    let touchX = null, touchY = null;
    cookStage.addEventListener('touchstart', e => { touchX = e.touches[0].clientX; touchY = e.touches[0].clientY; }, { passive: true });
    cookStage.addEventListener('touchend', e => {
      if (touchX === null || cookIngOpen) { touchX = null; return; }
      const dx = e.changedTouches[0].clientX - touchX;
      const dy = e.changedTouches[0].clientY - touchY;
      touchX = null;
      if (Math.abs(dx) < 55 || Math.abs(dx) < Math.abs(dy)) return;
      if (dx < 0) nextStep(); else prevStep();
    }, { passive: true });

    if (cookPrev) cookPrev.addEventListener('click', prevStep);
    if (cookNext) cookNext.addEventListener('click', nextStep);

    // -- Keyboard --
    document.addEventListener('keydown', e => {
      if (cookOverlay.classList.contains('hidden')) return;
      if (e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); nextStep(); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); prevStep(); }
    });

    // --- Shopping list ---
    const shoppingOverlay = document.getElementById('shopping-overlay');
    const shoppingModal = document.getElementById('shopping-modal');
    const shoppingItems = document.getElementById('shopping-items');
    const shoppingEmpty = document.getElementById('shopping-empty');
    const shoppingClear = document.getElementById('shopping-clear');
    const shoppingCount = document.getElementById('shopping-count');
    let shopList = Store.getShoppingList();

    /**
     * Ulozeni. Prihlaseny pise do databaze (tam pise i Cron), neprihlaseny
     * do prohlizece - at appka funguje i bez uctu.
     */
    function saveShopList() {
      if (!currentUser) Store.setShoppingList(shopList);
      updateShoppingBadge();
    }

    /** Stahne seznam z databaze. Bez prihlaseni nedela nic. */
    async function nactiNakup() {
      if (!currentUser) return;
      try {
        const data = await api('/api/shopping');
        shopList = (data.items || []).map(x => ({ id: x.id, text: x.text, done: !!x.done, source: x.source }));
        updateShoppingBadge();
        renderShopList();
      } catch {}
    }

    /** Zmena polozky v databazi. Vraci nove cely seznam. */
    async function nakupAkce(akce, dalsi) {
      try {
        const data = await api('/api/shopping', { action: akce, ...dalsi });
        shopList = (data.items || []).map(x => ({ id: x.id, text: x.text, done: !!x.done, source: x.source }));
        updateShoppingBadge();
        renderShopList();
      } catch (e) { alert(e.message); }
    }

    function updateShoppingBadge() {
      const remaining = shopList.filter(i => !i.done).length;
      shoppingCount.textContent = remaining;
      shoppingCount.classList.toggle('hidden', remaining === 0);
      const navBadge = document.getElementById('nav-shop-count');
      if (navBadge) {
        navBadge.textContent = remaining;
        navBadge.classList.toggle('hidden', remaining === 0);
      }
    }

    function renderShopList() {
      shoppingEmpty.classList.toggle('hidden', shopList.length > 0);
      shoppingClear.classList.toggle('hidden', shopList.length === 0);
      const copyBtn = document.getElementById('shopping-copy');
      if (copyBtn) copyBtn.classList.toggle('hidden', shopList.filter(i => !i.done).length === 0);
      shoppingItems.innerHTML = shopList.map((item, i) => `
        <li class="flex items-center gap-3 group">
          <button class="shop-toggle w-[18px] h-[18px] shrink-0 rounded border ${item.done ? 'border-accent bg-accent' : 'border-border'} flex items-center justify-center transition-colors" data-i="${i}">
            ${item.done ? '<svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>' : ''}
          </button>
          <span class="flex-1 text-[14px] ${item.done ? 'line-through opacity-40' : ''} text-text">${esc(item.text)}${item.source === 'auto' ? '<span class="nakup-auto" title="Doplnila appka podle plánu vaření">z plánu</span>' : ''}</span>
          <button class="shop-remove opacity-0 group-hover:opacity-100 text-text-muted hover:text-red-400 transition-all" data-i="${i}">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </li>`).join('');
      shoppingItems.querySelectorAll('.shop-toggle').forEach(b =>
        b.addEventListener('click', () => {
          const polozka = shopList[b.dataset.i];
          if (currentUser && polozka.id) return nakupAkce('toggle', { id: polozka.id });
          polozka.done = !polozka.done; saveShopList(); renderShopList();
        })
      );
      shoppingItems.querySelectorAll('.shop-remove').forEach(b =>
        b.addEventListener('click', () => {
          const polozka = shopList[b.dataset.i];
          if (currentUser && polozka.id) return nakupAkce('remove', { id: polozka.id });
          shopList.splice(b.dataset.i, 1); saveShopList(); renderShopList();
        })
      );
    }

    document.getElementById('shopping-btn').addEventListener('click', () => {
      if (currentUser) nactiNakup();
      renderShopList();
      shoppingOverlay.classList.remove('hidden');
      requestAnimationFrame(() => { shoppingOverlay.classList.remove('opacity-0'); shoppingModal.classList.remove('scale-95', 'opacity-0'); });
    });
    function closeShopping() {
      shoppingOverlay.classList.add('opacity-0');
      shoppingModal.classList.add('scale-95', 'opacity-0');
      setTimeout(() => shoppingOverlay.classList.add('hidden'), 200);
    }
    document.getElementById('shopping-close').addEventListener('click', closeShopping);
    shoppingOverlay.addEventListener('click', e => { if (e.target === shoppingOverlay) closeShopping(); });
    shoppingClear.addEventListener('click', () => {
      if (currentUser) return nakupAkce('clear', {});
      shopList = []; saveShopList(); renderShopList();
    });

    document.getElementById('shopping-copy').addEventListener('click', () => {
      const text = shopList.filter(i => !i.done).map(i => '• ' + i.text).join('\n');
      if (!text) return;
      navigator.clipboard.writeText(text).then(() => {
        const btn = document.getElementById('shopping-copy');
        const orig = btn.textContent;
        btn.textContent = 'Zkopírováno ✓';
        setTimeout(() => { btn.textContent = orig; }, 2000);
      });
    });

    document.getElementById('add-shop-btn').addEventListener('click', () => {
      const r = recipes.find(x => x.slug === currentSlug);
      if (!r) return;
      const base = r.servings || 4;
      const factor = currentServings / base;
      const polozky = variantOf(r).ingredients.map(raw => scaleIngredient(raw, factor));

      if (currentUser) {
        // Duplicity odchytne server, at se seznam nezdvoji mezi zarizenimi.
        nakupAkce('add', { items: polozky });
      } else {
        polozky.forEach(text => {
          const norm = text.toLowerCase().trim();
          if (!shopList.some(i => i.text.toLowerCase().trim() === norm)) shopList.push({ text, done: false });
        });
        saveShopList();
      }

      const btn = document.getElementById('add-shop-btn');
      const orig = btn.textContent;
      btn.textContent = 'Přidáno ✓';
      setTimeout(() => { btn.textContent = orig; }, 1500);
    });

    updateShoppingBadge();

    // --- Bottom nav (mobile) ---
    document.getElementById('nav-all').addEventListener('click', () => {
      activeCategory = 'all'; updateFilters(); renderGrid();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    document.getElementById('nav-fav').addEventListener('click', () => {
      activeCategory = '__fav'; updateFilters(); renderGrid();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    document.getElementById('nav-chef').addEventListener('click', () => document.getElementById('chef-btn').click());
    document.getElementById('nav-shop').addEventListener('click', () => document.getElementById('shopping-btn').click());

    // --- Zavirani oken: Escape a tlacitko zpet ----------------------------
    //
    // V nainstalovane appce neni adresni radek ani sipka zpet, takze
    // systemove gesto "zpet" by zavrelo rovnou CELOU aplikaci. Kdo si
    // otevrel spiz, nemel jak z ni odejit jinak nez krizkem.
    //
    // Reseni: pri startu si do historie prohlizece polozime jeden krok
    // navic. Gesto zpet ho spotrebuje, my zavreme nejvrchnejsi okno
    // a krok zase polozime - takze dalsi "zpet" zavre dalsi okno.
    // Kdyz uz nic otevreneho neni, krok nedoplnime a appka se zavre,
    // jak uzivatel ceka.

    /** Okna od nejvrchnejsiho po nejspodnejsi. Poradi = poradi zavirani. */
    function oknaOdVrchu() {
      return [
        [cookOverlay, closeCookMode],
        [bookOverlay, zavriBooking],
        [checklistOverlay, closeChecklist],
        [profilOverlay, zavriProfil],
        [calOverlay, zavriKalendar],
        [pantryOverlay, closePantry],
        [shoppingOverlay, closeShopping],
        [chefOverlay, closeChef],
        [substOverlay, closeSubst],
        [nutritionOverlay, closeNutrition],
        [settingsOverlay, closeSettings],
        [overlay, closeDetailModal],
      ];
    }

    /** Zavre nejvrchnejsi otevrene okno. Vraci, jestli bylo co zavrit. */
    function zavriNejvrchnejsiOkno() {
      for (const [prvek, zavri] of oknaOdVrchu()) {
        if (prvek && !prvek.classList.contains('hidden')) {
          zavri();
          return true;
        }
      }
      return false;
    }

    function jeNecoOtevrene() {
      return oknaOdVrchu().some(([prvek]) => prvek && !prvek.classList.contains('hidden'));
    }

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') zavriNejvrchnejsiOkno();
    });

    // Krok v historii se pokláda AZ ve chvili, kdy je co zavirat, a
    // zase se uklidi, jakmile je vsechno zavrene. Kdyby lezel v historii
    // porad, prvni "zpet" na hlavni obrazovce by nedelalo nic - a to je
    // presne ten druh drobnosti, ktera na telefonu vypada jako zaseknuta
    // appka.
    let zpetPripraveno = false;
    let uklizimeKrok = false;

    function pripravZpet() {
      if (zpetPripraveno) return;
      zpetPripraveno = true;
      history.pushState({ mcOkno: true }, '');
    }

    function uklidZpet() {
      if (!zpetPripraveno) return;
      zpetPripraveno = false;
      uklizimeKrok = true;
      history.back();
    }

    window.addEventListener('popstate', () => {
      // Krok jsme prave uklidili sami - nic se zavirat nema.
      if (uklizimeKrok) { uklizimeKrok = false; return; }

      zpetPripraveno = false;
      zavriNejvrchnejsiOkno();
      // Kdyz pod zavrenym oknem lezi dalsi, chceme mit co spotrebovat
      // priste.
      if (jeNecoOtevrene()) pripravZpet();
    });

    // Okna se otviraji z desitek mist. Misto abychom kazde z nich
    // upravovali, sledujeme, kdy se prestanou skryvat - drzi se to samo
    // i u oken, ktera pribudou pozdeji.
    // setTimeout schvalne: casti oken se deklaruji AZ nize v souboru
    // (8.16). Kdybychom na ne sahli hned ted, spadne to na "Cannot
    // access before initialization" jeste pred prvnim vykreslenim.
    setTimeout(function () {
      const hlidac = new MutationObserver(() => {
        if (jeNecoOtevrene()) pripravZpet(); else uklidZpet();
      });
      oknaOdVrchu().forEach(([prvek]) => {
        if (prvek) hlidac.observe(prvek, { attributes: true, attributeFilter: ['class'] });
      });
    }, 0);


    // --- Rating & notes ---
    //
    // Hodnoceni se cte pri kazdem vykresleni mrizky nekolikrat na recept.
    // Kdyz slo pokazde do localStorage, znamenalo to par stovek volani
    // JSON.parse na KAZDE pismeno ve vyhledavani. Drzime si tedy kopii
    // v pameti; zapisuje se porad do localStorage, aby to prezilo reload.
    const reviewCache = new Map();

    function getReview(slug) {
      let r = reviewCache.get(slug);
      if (!r) { r = Store.getReview(slug); reviewCache.set(slug, r); }
      return r;
    }
    function saveReview(slug, review) {
      reviewCache.set(slug, review);
      Store.setReview(slug, review);
      posliStav();
    }
    function getUserRating(slug) {
      return getReview(slug).stars || 0;
    }

    function renderStars(slug) {
      const review = getReview(slug);
      const stars = review.stars || 0;
      const row = document.getElementById('star-row');
      if (!row) return;
      row.querySelectorAll('.star-btn').forEach(btn => {
        const n = parseInt(btn.dataset.star);
        btn.textContent = n <= stars ? '★' : '☆';
        btn.style.color = n <= stars ? 'var(--color-accent)' : 'var(--color-text-muted)';
      });
      const stats = document.getElementById('cook-stats');
      if (stats) {
        const parts = [];
        if (review.cooked) parts.push('Uvařeno ' + review.cooked + '×');
        if (review.lastCooked) {
          const d = new Date(review.lastCooked);
          parts.push('naposledy ' + d.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' }));
        }
        stats.textContent = parts.join(', ');
      }
      const noteEl = document.getElementById('personal-note');
      if (noteEl) noteEl.value = review.note || '';
    }

    /**
     * Navazuje se JEDNOU pri startu, ne pri kazdem otevreni receptu.
     *
     * Tlacitka v detailu jsou porad tytez prvky - kdyby se posluchac
     * pridaval znovu s kazdym otevrenim, jedno kliknuti by po chvili
     * zapsalo uvareni vsem drive otevrenym receptum.
     *
     * Proto se uvnitr cte `currentSlug`, ne slug zachyceny pri navazani.
     */
    function bindRatingEvents() {
      const row = document.getElementById('star-row');
      if (!row) return;

      row.querySelectorAll('.star-btn').forEach(btn => {
        btn.addEventListener('mouseenter', () => {
          const n = parseInt(btn.dataset.star);
          row.querySelectorAll('.star-btn').forEach(b => {
            const bn = parseInt(b.dataset.star);
            b.textContent = bn <= n ? '★' : '☆';
            b.style.color = bn <= n ? 'var(--color-accent)' : 'var(--color-text-muted)';
          });
        });
        btn.addEventListener('mouseleave', () => renderStars(currentSlug));
        btn.addEventListener('click', () => {
          if (!currentSlug) return;
          const review = getReview(currentSlug);
          const n = parseInt(btn.dataset.star);
          review.stars = review.stars === n ? 0 : n;
          saveReview(currentSlug, review);
          renderStars(currentSlug);
          renderGrid();
        });
      });

      const cooked = document.getElementById('cooked-btn');
      // Puvodni podoba tlacitka se pamatuje jednou. Kdyby se cetla az pri
      // kliknuti, druhe kliknuti behem hlasky by si zapamatovalo hlasku.
      const cookedPuvodni = cooked.innerHTML;
      let cookedTimer = null;

      cooked.addEventListener('click', () => {
        if (!currentSlug) return;
        const review = getReview(currentSlug);
        review.cooked = (review.cooked || 0) + 1;
        review.lastCooked = new Date().toISOString();
        saveReview(currentSlug, review);
        renderStars(currentSlug);
        renderGrid();

        cooked.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" ' +
          'viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" ' +
          'stroke-width="3" d="M5 13l4 4L19 7"/></svg> Zaznamenáno!';
        cooked.style.color = 'var(--color-accent)';
        clearTimeout(cookedTimer);
        cookedTimer = setTimeout(() => {
          cooked.innerHTML = cookedPuvodni;
          cooked.style.color = '';
        }, 2000);
      });

      const poznamka = document.getElementById('save-note-btn');
      poznamka.addEventListener('click', () => {
        if (!currentSlug) return;
        const review = getReview(currentSlug);
        review.note = document.getElementById('personal-note').value;
        saveReview(currentSlug, review);
        const saved = document.getElementById('note-saved');
        saved.classList.remove('hidden');
        setTimeout(() => saved.classList.add('hidden'), 2000);
      });
    }

    bindRatingEvents();

    // --- Init ---
    updateFilters();
    renderGrid();

    // --- Naplanovani vareni ("TO UVAŘÍM!") ---------------------------------
    //
    // 4.2: booking surovinu NEODECTE, jen ji zamkne. Odecet prijde az
    // po "DOVAŘENO" - do te doby ji uzivatel musi ve spizi videt.

    const bookOverlay = document.getElementById('book-overlay');
    const bookModal = document.getElementById('book-modal');
    let bookSlug = null;

    function otevriBooking() {
      const r = recipes.find(x => x.slug === currentSlug);
      if (!r) return;
      if (!currentUser) {
        alert('Na plánování se musíš přihlásit — ať víme, komu to uložit.');
        return;
      }
      bookSlug = r.slug;
      document.getElementById('book-recept').textContent = r.title;
      document.getElementById('book-date').value = dnesniDatum();
      document.getElementById('book-chyba').classList.add('hidden');
      ukazZamky(r);
      vykresliRychle();
      document.getElementById('book-podrobne').classList.add('hidden');
      document.getElementById('book-jindy').classList.remove('hidden');
      vykresliBookingy();

      bookOverlay.classList.remove('hidden');
      requestAnimationFrame(() => {
        bookOverlay.classList.remove('opacity-0');
        bookModal.classList.remove('scale-95', 'opacity-0');
      });
    }

    function zavriBooking() {
      bookOverlay.classList.add('opacity-0');
      bookModal.classList.add('scale-95', 'opacity-0');
      setTimeout(() => bookOverlay.classList.add('hidden'), 200);
    }

    /** Ukaze dopredu, co se ve spizi zamkne - at to neni prekvapeni. */
    function ukazZamky(recept) {
      const blok = document.getElementById('book-zamky');
      const zamky = coZamknout(recept, pantryItems, sediSurovina);
      if (!zamky.length) { blok.classList.add('hidden'); return; }
      document.getElementById('book-zamky-seznam').textContent =
        zamky.map(z => z.ingredient).join(', ');
      blok.classList.remove('hidden');
    }

    document.getElementById('book-cely-den').addEventListener('change', e => {
      document.getElementById('book-cas-radek').classList.toggle('hidden', e.target.checked);
    });

    document.getElementById('book-ulozit').addEventListener('click', () => ulozBooking(false));

    document.getElementById('book-jindy').addEventListener('click', e => {
      document.getElementById('book-podrobne').classList.remove('hidden');
      e.target.classList.add('hidden');
    });

    /** Rychle terminy - jeden tap misto vyplnovani data a casu. */
    function vykresliRychle() {
      const blok = document.getElementById('book-rychle');
      const nabidka = rychleTerminy();

      // Prvni volba je ta nejpravdepodobnejsi, tak at je i videt jako
      // prvni. Tri stejne barevne knofliky pod sebou vypadaji jako
      // nabidka, ve ktere si mate vybrat - a to je presne naopak.
      blok.innerHTML = nabidka.map((o, i) =>
        '<button class="book-rychly flex items-center justify-between gap-2 w-full py-3 px-4 rounded-xl text-[14px] font-medium active:scale-[0.98] transition-all ' +
        (i === 0
          ? 'bg-accent text-white hover:bg-accent-hover'
          : 'bg-surface border border-border text-text hover:border-accent hover:text-accent') + '" ' +
        'data-datum="' + escAttr(o.datum) + '" data-cas="' + escAttr(o.cas) + '">' +
        '<span>' + esc(o.popis) + '</span>' +
        '<span class="' + (i === 0 ? 'text-white/70' : 'text-text-muted') + ' text-[12px]">' + esc(o.cas) + '</span>' +
        '</button>'
      ).join('');

      blok.querySelectorAll('.book-rychly').forEach(b =>
        b.addEventListener('click', () => ulozBooking(false, { datum: b.dataset.datum, cas: b.dataset.cas })));
    }

    /**
     * Ulozi booking. Volaji ji tri mista, ktera se lisi jen tim, odkud
     * berou termin a kam hlasi chybu:
     *
     *   ulozBooking(false)                          -- podrobny formular
     *   ulozBooking(false, { datum, cas })          -- rychla nabidka
     *   ulozBooking(false, { datum, cas, slug, ... }) -- kalendar
     *
     * Logika konfliktu, zamku a ulozeni je tim na jednom miste. Kdyby
     * existovala dvakrat, do tydne se rozejde a kalendar bude zamykat
     * jine suroviny nez detail receptu.
     */
    async function ulozBooking(force, volby) {
      const v = volby || {};
      const zvenku = !!v.datum;
      const chybaEl = document.getElementById(v.chyba || 'book-chyba');
      const ukazChybu = (text) => {
        chybaEl.textContent = text;
        chybaEl.classList.remove('hidden');
      };

      const datum = zvenku ? v.datum : document.getElementById('book-date').value;
      const celyDen = zvenku ? !v.cas : document.getElementById('book-cely-den').checked;
      const cas = zvenku ? (v.cas || null) : (celyDen ? null : document.getElementById('book-time').value);

      chybaEl.classList.add('hidden');
      if (!jeDatum(datum)) return ukazChybu('Vyber datum.');
      if (!celyDen && !jeCas(cas)) return ukazChybu('Vyber čas.');

      // Konflikt zkontrolujeme rovnou tady, at se uzivatel nemusi ptat serveru.
      if (!force && cas) {
        const srazky = konflikty({ cook_date: datum, cook_time: cas }, bookings.map(b => ({
          ...b, recipe_title: (recipes.find(r => r.slug === b.recipe_slug) || {}).title,
        })));
        if (srazky.length && !confirm(popisKonfliktu(srazky))) return;
        if (srazky.length) force = true;
      }

      const slug = v.slug || bookSlug;
      const recept = recipes.find(r => r.slug === slug);
      // Porce bereme z posuvniku JEN kdyz planujeme prave otevreny recept.
      // Z kalendare se da naplanovat cokoliv - a ulozit k nemu porce
      // nejakeho jineho jidla je nesmysl, ktery pak vyjede i v Google
      // kalendari ("Porcí: 12" u receptu pro dva).
      const porce = slug === currentSlug
        ? (currentServings || null)
        : ((recept && recept.servings) || null);
      try {
        const data = await api('/api/bookings', {
          slug: slug,
          date: datum,
          time: cas,
          servings: porce,
          force: !!force,
          locks: coZamknout(recept, pantryItems, sediSurovina),
        });
        bookings = data.items || [];
        vykresliBookingy();
        // Zamek se hned promitne do spize, at je videt volne mnozstvi.
        loadPantry();
        renderGrid();
        // Z rychle nabidky okno zavreme: uzivatel udelal jeden tap a je
        // hotovo. U podrobneho formulare zustava otevrene, at je videt
        // seznam naplanovaneho.
        if (v.hotovo) v.hotovo();
        else if (zvenku) zavriBooking();
      } catch (e) {
        ukazChybu(e.message);
      }
    }

    function vykresliBookingy() {
      const blok = document.getElementById('book-seznam-blok');
      const seznam = document.getElementById('book-seznam');
      const nadchazi = nadchazejici(bookings);

      blok.classList.toggle('hidden', nadchazi.length === 0);
      seznam.innerHTML = nadchazi.map(b => {
        const r = recipes.find(x => x.slug === b.recipe_slug);
        return '<li class="flex items-center gap-2 text-[13px]">' +
          '<span class="flex-1 min-w-0"><span class="text-text">' + esc(r ? r.title : b.recipe_slug) + '</span>' +
          '<span class="text-text-muted"> — ' + esc(popisBookingu(b)) + '</span></span>' +
          '<button class="book-hotovo px-2 py-1 rounded-md bg-surface border border-border text-text-muted text-[11px] hover:text-accent hover:border-accent transition-colors" data-id="' + escAttr(b.id) + '">Dovařeno</button>' +
          '<button class="book-zrusit w-6 h-6 rounded-md text-text-muted hover:text-red-400 transition-colors" data-id="' + escAttr(b.id) + '" title="Zrušit">&times;</button>' +
          '</li>';
      }).join('');

      seznam.querySelectorAll('.book-hotovo').forEach(b =>
        b.addEventListener('click', () => bookingAkce('done', b.dataset.id)));
      seznam.querySelectorAll('.book-zrusit').forEach(b =>
        b.addEventListener('click', () => bookingAkce('cancel', b.dataset.id)));
    }

    async function bookingAkce(akce, id) {
      if (akce === 'done' && !confirm('Uvařeno? Suroviny se teď odečtou ze spíže.')) return;
      try {
        const data = await api('/api/bookings', { action: akce, id: Number(id) });
        bookings = data.items || [];
        vykresliBookingy();
        loadPantry();
        renderGrid();
      } catch (e) { alert(e.message); }
    }

    async function nactiBookingy() {
      if (!currentUser) { bookings = []; return; }
      try {
        const data = await api('/api/bookings');
        bookings = data.items || [];
      } catch { bookings = []; }
    }

    document.getElementById('book-btn').addEventListener('click', otevriBooking);
    document.getElementById('book-close').addEventListener('click', zavriBooking);
    bookOverlay.addEventListener('click', e => { if (e.target === bookOverlay) zavriBooking(); });

    // --- Kalendar vareni ----------------------------------------------------
    //
    // Mrizka mesice s tim, co kdy varis. Rozhodovani o dnech dela mozek
    // (kalendar.js), tady se jen kresli a kliká.

    const calOverlay = document.getElementById('cal-overlay');
    const calModal = document.getElementById('cal-modal');
    let calRok = new Date().getFullYear();
    let calMesic = new Date().getMonth() + 1;
    let calVybranyDen = null;

    function otevriKalendar() {
      document.getElementById('cal-signedout').classList.toggle('hidden', !!currentUser);
      document.getElementById('cal-body').classList.toggle('hidden', !currentUser);

      calOverlay.classList.remove('hidden');
      requestAnimationFrame(() => {
        calOverlay.classList.remove('opacity-0');
        calModal.classList.remove('scale-95', 'opacity-0');
      });

      if (currentUser) {
        nactiBookingy().then(() => { vykresliKalendar(); paintCalBadge(); });
      }
    }

    function zavriKalendar() {
      calOverlay.classList.add('opacity-0');
      calModal.classList.add('scale-95', 'opacity-0');
      setTimeout(() => calOverlay.classList.add('hidden'), 200);
    }

    function vykresliKalendar() {
      const mrizka = mesicniMrizka(calRok, calMesic, bookings, dnesniDatum());
      document.getElementById('cal-nazev').textContent = mrizka.nazev;

      const kolik = pocetVMesici(mrizka);
      document.getElementById('cal-souhrn').textContent =
        kolik === 0 ? 'nic naplánováno' : kolik + ' vaření';

      document.getElementById('cal-dny').innerHTML =
        DNY_ZKRATKY.map(d => '<div class="kal-den-zkratka">' + esc(d) + '</div>').join('');

      document.getElementById('cal-mrizka').innerHTML = mrizka.tydny.map(tyden =>
        '<div class="kal-tyden">' + tyden.map(bunkaKalendare).join('') + '</div>'
      ).join('');

      document.getElementById('cal-mrizka').querySelectorAll('.kal-bunka').forEach(b =>
        b.addEventListener('click', () => vyberDen(b.dataset.datum))
      );

      if (calVybranyDen) vyberDen(calVybranyDen, true);
    }

    /** Jedna bunka mrizky. Vic nez tri vareni na den se schova pod "+N". */
    function bunkaKalendare(d) {
      const tridy = ['kal-bunka'];
      if (d.jinyMesic) tridy.push('je-jiny-mesic');
      if (d.dnes) tridy.push('je-dnes');
      if (d.minulost) tridy.push('je-minulost');
      if (d.bookingy.length) tridy.push('ma-vareni');
      if (d.datum === calVybranyDen) tridy.push('je-vybrany');
      // Vareni, ktere uz melo probehnout a nikdo ho neodklikl. Neni to
      // kosmetika: dokud booking visi jako 'planned', drzi ve spizi
      // zamcene suroviny (4.2) a "co muzu uvarit" s nimi nepocita.
      if (d.minulost && d.bookingy.some(b => b.state === 'planned')) tridy.push('ma-propadle');

      const stitky = d.bookingy.slice(0, 3).map(b => {
        const r = recipes.find(x => x.slug === b.recipe_slug);
        const nazev = r ? r.title : b.recipe_slug;
        const cas = b.cook_time ? b.cook_time + ' ' : '';
        return '<span class="kal-stitek' + (b.state === 'done' ? ' je-hotovo' : '') + '" title="' +
          escAttr(cas + nazev) + '">' + esc(cas) + esc(nazev) + '</span>';
      }).join('');

      const vic = d.bookingy.length > 3
        ? '<span class="kal-vic">+' + (d.bookingy.length - 3) + '</span>' : '';

      return '<button type="button" class="' + tridy.join(' ') + '" data-datum="' + escAttr(d.datum) + '">' +
        '<span class="kal-cislo">' + d.den + '</span>' + stitky + vic + '</button>';
    }

    function vyberDen(datum, jenPrekreslit) {
      calVybranyDen = datum;
      if (!jenPrekreslit) {
        document.getElementById('cal-mrizka').querySelectorAll('.kal-bunka').forEach(b =>
          b.classList.toggle('je-vybrany', b.dataset.datum === datum));
      }

      const blok = document.getElementById('cal-den');
      const seznam = document.getElementById('cal-den-seznam');
      const dneska = bookingyDne(bookings, datum);

      blok.classList.remove('hidden');
      zavriVyber();
      document.getElementById('cal-den-nazev').textContent =
        popisDatumu(datum, dnesniDatum()).replace(/^./, c => c.toUpperCase());
      document.getElementById('cal-den-prazdno').classList.toggle('hidden', dneska.length > 0);
      document.getElementById('cal-do-nakupu').classList.toggle('hidden', dneska.length === 0);
      document.getElementById('cal-nakup-hlaska').classList.add('hidden');

      seznam.innerHTML = dneska.map(b => {
        const r = recipes.find(x => x.slug === b.recipe_slug);
        const p = r ? pripravenost(r, pantryItems) : null;
        const odznak = p && p.stav !== 'nevim'
          ? '<span class="odznak odznak-' + p.stav + '">' + esc(p.popisek) + '</span>' : '';
        return '<li class="flex items-center gap-2 text-[13px]">' +
          '<span class="flex-1 min-w-0">' +
            '<span class="text-text">' + esc(r ? r.title : b.recipe_slug) + '</span>' +
            '<span class="text-text-muted"> — ' + esc(b.cook_time || 'celý den') + '</span> ' + odznak +
          '</span>' +
          '<button class="cal-hotovo px-2 py-1 rounded-md bg-surface border border-border text-text-muted text-[11px] hover:text-accent hover:border-accent transition-colors" data-id="' + escAttr(b.id) + '">Dovařeno</button>' +
          '<button class="cal-zrusit w-6 h-6 rounded-md text-text-muted hover:text-red-400 transition-colors" data-id="' + escAttr(b.id) + '" title="Zrušit">&times;</button>' +
        '</li>';
      }).join('');

      seznam.querySelectorAll('.cal-hotovo').forEach(b =>
        b.addEventListener('click', () => calBookingAkce('done', b.dataset.id)));
      seznam.querySelectorAll('.cal-zrusit').forEach(b =>
        b.addEventListener('click', () => calBookingAkce('cancel', b.dataset.id)));
    }

    // --- Planovani primo z kalendare ------------------------------------
    //
    // Ukladani resi `ulozBooking` se stejnymi zamky a kontrolou
    // konfliktu jako z detailu receptu - tohle je jen jiny zpusob, jak
    // do ni dostat datum a slug.

    let calHledane = '';

    /** Nahoru to, k cemu chybi nejmin. 'nevim' (prazdna spiz) az nakonec. */
    function porovnejPripravenost(a, b) {
      const poradi = { vse: 0, skoro: 1, daleko: 2, nevim: 3 };
      const rozdil = (poradi[a.stav] ?? 3) - (poradi[b.stav] ?? 3);
      return rozdil !== 0 ? rozdil : (a.chybi || 0) - (b.chybi || 0);
    }

    function zavriVyber() {
      document.getElementById('cal-vyber').classList.add('hidden');
      document.getElementById('cal-pridat').classList.remove('hidden');
      calHledane = '';
    }

    function vykresliVyber() {
      const seznam = document.getElementById('cal-vyber-seznam');
      const hledat = fold(calHledane.trim());

      // Nahore to, co jde uvarit z toho, co je doma - to je duvod,
      // proc clovek planuje z kalendare a ne z receptu.
      const nabidka = recipes
        .filter(r => !hledat || fold(r.title).includes(hledat))
        .map(r => ({ r: r, p: pripravenost(r, pantryItems) }))
        // Kdo ma prazdnou spiz, ma u vseho stav 'nevim' - pak se
        // neradi vubec a poradi zustane puvodni.
        .sort((a, b) => porovnejPripravenost(a.p, b.p))
        .slice(0, 40);

      if (!nabidka.length) {
        seznam.innerHTML = '<li class="text-[13px] text-text-muted py-2">Nic takového tu není.</li>';
        return;
      }

      seznam.innerHTML = nabidka.map(({ r, p }) =>
        '<li><button type="button" class="cal-vyber-recept w-full flex items-center gap-2 text-left px-2 py-2 rounded-lg hover:bg-surface-hover transition-colors" data-slug="' + escAttr(r.slug) + '">' +
          '<span class="flex-1 min-w-0 text-[13px] text-text truncate">' + esc(r.title) + '</span>' +
          (p && p.stav !== 'nevim'
            ? '<span class="odznak odznak-' + p.stav + ' shrink-0">' + esc(p.popisek) + '</span>' : '') +
        '</button></li>'
      ).join('');

      seznam.querySelectorAll('.cal-vyber-recept').forEach(b =>
        b.addEventListener('click', () => naplanujZKalendare(b.dataset.slug)));
    }

    async function naplanujZKalendare(slug) {
      const celyDen = document.getElementById('cal-vyber-celyden').checked;
      const cas = celyDen ? null : document.getElementById('cal-vyber-cas').value;

      await ulozBooking(false, {
        datum: calVybranyDen,
        cas: cas,
        slug: slug,
        chyba: 'cal-vyber-chyba',
        hotovo: () => {
          zavriVyber();
          vykresliKalendar();
          paintCalBadge();
        },
      });
    }

    (function () {
      const pridat = document.getElementById('cal-pridat');
      if (!pridat) return;

      pridat.addEventListener('click', () => {
        document.getElementById('cal-vyber').classList.remove('hidden');
        pridat.classList.add('hidden');
        document.getElementById('cal-vyber-chyba').classList.add('hidden');
        const h = document.getElementById('cal-vyber-hledat');
        h.value = '';
        calHledane = '';
        vykresliVyber();
        h.focus();
      });

      document.getElementById('cal-vyber-hledat').addEventListener('input', e => {
        calHledane = e.target.value;
        vykresliVyber();
      });

      document.getElementById('cal-vyber-celyden').addEventListener('change', e => {
        document.getElementById('cal-vyber-cas').classList.toggle('hidden', e.target.checked);
      });
    })();

    async function calBookingAkce(akce, id) {
      if (akce === 'done' && !confirm('Uvařeno? Suroviny se teď odečtou ze spíže.')) return;
      try {
        const data = await api('/api/bookings', { action: akce, id: Number(id) });
        bookings = data.items || [];
        vykresliKalendar();
        paintCalBadge();
        loadPantry();
        renderGrid();
      } catch (e) { alert(e.message); }
    }

    /**
     * Chybejici suroviny vybraneho dne rovnou do nakupniho seznamu.
     * Tohle dela Cron kazdou noc na zitrek (4.6) - tady si to uzivatel
     * muze vyzadat pro libovolny den dopredu.
     */
    document.getElementById('cal-do-nakupu').addEventListener('click', async () => {
      const hlaska = document.getElementById('cal-nakup-hlaska');
      const dneska = bookingyDne(bookings, calVybranyDen);

      const chybi = [];
      dneska.forEach(b => {
        const r = recipes.find(x => x.slug === b.recipe_slug);
        if (!r) return;
        chybejici(r, pantryItems).chybi.forEach(sur => {
          if (!chybi.includes(sur)) chybi.push(sur);
        });
      });

      if (!chybi.length) {
        hlaska.textContent = 'Nic ti nechybí. Nakupovat nemusíš.';
        hlaska.classList.remove('hidden');
        return;
      }

      try {
        const data = await api('/api/shopping', { action: 'add', items: chybi });
        shopList = data.items || [];
        updateShoppingBadge();
        renderShopList();
        hlaska.textContent = 'Přidáno do nákupního seznamu: ' + chybi.join(', ');
        hlaska.classList.remove('hidden');
      } catch (e) {
        hlaska.textContent = e.message;
        hlaska.classList.remove('hidden');
      }
    });

    /** Kolik vareni te jeste ceka - cislo na tlacitku kalendare. */
    function paintCalBadge() {
      const odznak = document.getElementById('cal-badge');
      if (!odznak) return;
      const kolik = nadchazejici(bookings, dnesniDatum()).length;
      odznak.textContent = kolik;
      odznak.classList.toggle('hidden', kolik === 0);
    }

    document.getElementById('cal-btn').addEventListener('click', otevriKalendar);
    document.getElementById('cal-close').addEventListener('click', zavriKalendar);
    calOverlay.addEventListener('click', e => { if (e.target === calOverlay) zavriKalendar(); });
    document.getElementById('cal-login').addEventListener('click', startGoogleLogin);

    document.getElementById('cal-zpet').addEventListener('click', () => {
      const m = posunMesic(calRok, calMesic, -1);
      calRok = m.rok; calMesic = m.mesic; vykresliKalendar();
    });
    document.getElementById('cal-vpred').addEventListener('click', () => {
      const m = posunMesic(calRok, calMesic, 1);
      calRok = m.rok; calMesic = m.mesic; vykresliKalendar();
    });
    document.getElementById('cal-dnes').addEventListener('click', () => {
      const d = new Date();
      calRok = d.getFullYear(); calMesic = d.getMonth() + 1;
      calVybranyDen = dnesniDatum();
      vykresliKalendar();
    });

    // --- Uvitaci obrazovka pro neprihlasene ---------------------------------
    //
    // Ukazuje se hned pri nacteni, jeste nez se overi prihlaseni na serveru -
    // jinak by na okamzik problikla cela aplikace. Rozhoduje se podle listku
    // v prohlizeci, protoze ten je k dispozici okamzite.

    const brana = document.getElementById('brana');

    function ukazBranu(ukaz) {
      if (!brana) return;
      brana.classList.toggle('je-pryc', !ukaz);
      document.body.style.overflow = ukaz ? 'hidden' : '';
    }

    document.getElementById('brana-prihlasit').addEventListener('click', startGoogleLogin);

    // Cas na listku je skutecny - "dnesni situace" je fakt dnesni.
    const branaCas = document.getElementById('brana-cas');
    if (branaCas) branaCas.textContent =
      new Date().toLocaleTimeString('cs-CZ', { hour: '2-digit', minute: '2-digit' });

    // Kdo ma listek, tomu branu nezobrazujeme vubec. Kdyby uz neplatil,
    // loadUser ji vrati zpatky.
    ukazBranu(!Store.getSession());

    // --- Uvodni okno a prohlidka ------------------------------------------

    const uvodOverlay = document.getElementById('uvod-overlay');
    const uvodOkno = document.getElementById('uvod-okno');

    function otevriUvod() {
      uvodOverlay.classList.remove('hidden');
      requestAnimationFrame(() => {
        uvodOverlay.classList.remove('opacity-0');
        uvodOkno.classList.remove('scale-95', 'opacity-0');
      });
      document.body.style.overflow = 'hidden';
    }

    function zavriUvod() {
      uvodOverlay.classList.add('opacity-0');
      uvodOkno.classList.add('scale-95', 'opacity-0');
      setTimeout(() => uvodOverlay.classList.add('hidden'), 300);
      document.body.style.overflow = '';
      // At uz prohlidku prijal nebo ne, podruhe uz se samo neotevre.
      api('/api/intro-done', {}).catch(() => {});
      if (currentUser) currentUser.intro_done = 1;
    }

    document.getElementById('uvod-preskocit').addEventListener('click', zavriUvod);
    document.getElementById('uvod-projit').addEventListener('click', () => {
      zavriUvod();
      setTimeout(spustProhlidku, 350);
    });

    // -- Prohlidka --

    const tour = document.getElementById('tour');
    const tourDira = document.getElementById('tour-dira');
    const tourBublina = document.getElementById('tour-bublina');
    let tourKrok = 0;

    /**
     * Akce, ktere si kroky vyzadaji, aby bylo na co ukazovat.
     * Nazvy jsou dohodnute s tour.js.
     */
    const TOUR_AKCE = {
      otevriRecept: () => {
        const prvni = document.querySelector('.menu-row, .recipe-card');
        if (prvni) prvni.click();
      },
      zavriRecept: () => closeDetailModal(),
      otevriSpiz: () => openPantry(),
      zavriSpiz: () => closePantry(),
      otevriNastaveni: () => document.getElementById('settings-btn').click(),
      zavriNastaveni: () => closeSettings(),
    };

    function spustProhlidku() {
      tourKrok = 0;
      tour.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      vykresliKrok();
    }

    function ukonciProhlidku() {
      tour.classList.add('hidden');
      document.body.style.overflow = '';
      // Uklid po krocich, ktere neco otevrely.
      try { closeDetailModal(); } catch {}
      try { closePantry(); } catch {}
      try { closeSettings(); } catch {}
    }

    function vykresliKrok() {
      const k = tourKrokData(tourKrok);
      if (!k) return ukonciProhlidku();

      const akce = tourAkce(tourKrok);
      if (akce && TOUR_AKCE[akce]) TOUR_AKCE[akce]();

      // Modaly maji vlastni animaci, tak chvili pockame, nez zmerime misto.
      setTimeout(() => umistiKrok(k), akce ? 380 : 60);

      document.getElementById('tour-postup').textContent = tourPostup(tourKrok);
      document.getElementById('tour-nadpis').textContent = k.nadpis;
      document.getElementById('tour-text').textContent = k.text;
      document.getElementById('tour-dal').textContent = tourDopredu(tourKrok);
      document.getElementById('tour-zpet').disabled = tourPrvni(tourKrok);
    }

    /** Zvyrazni prvek a postavi k nemu bublinu. */
    function umistiKrok(k) {
      const cil = document.querySelector(k.cil);
      if (!cil) {
        // Krok, ktery na teto obrazovce nema co ukazovat, radeji preskocime.
        tourKrok = tourOmez(tourKrok + 1);
        return vykresliKrok();
      }

      // Skok bez animace: kdyby se rolovalo plynule, merili bychom pozici
      // driv, nez se stranka zastavi - a bublina by skoncila jinde nez cil.
      cil.scrollIntoView({ block: 'center', behavior: 'auto' });

      // Kratka prodleva staci na prepocet rozvrzeni po skoku.
      setTimeout(() => umistiBublinu(cil), 60);
    }

    /**
     * Postavi zvyrazneni na prvek a bublinu k nemu.
     *
     * Bublina musi byt VZDY cela videt - jinak se uzivatel nedostane na
     * tlacitko "Dál" a prohlidka pro nej skonci.
     */
    function umistiBublinu(cil) {
      const r = cil.getBoundingClientRect();
      const okrajDiry = 8;
      const mezera = 14;
      const okraj = 12;

      tourDira.style.left = (r.left - okrajDiry) + 'px';
      tourDira.style.top = (r.top - okrajDiry) + 'px';
      tourDira.style.width = (r.width + okrajDiry * 2) + 'px';
      tourDira.style.height = (r.height + okrajDiry * 2) + 'px';

      const vyska = tourBublina.offsetHeight || 220;
      const sirka = tourBublina.offsetWidth || 300;

      // Nejdriv pod prvek, pak nad nej, a kdyz se nevejde ani tam,
      // vedle nej - v tom pripade uz jen srovnane do okna.
      const podNim = r.bottom + mezera;
      const nadNim = r.top - vyska - mezera;
      let y;
      if (podNim + vyska <= window.innerHeight - okraj) y = podNim;
      else if (nadNim >= okraj) y = nadNim;
      else y = r.top;

      // Pojistka pro kazdy pripad: dovnitr okna, at uz vyslo cokoliv.
      y = Math.max(okraj, Math.min(y, window.innerHeight - vyska - okraj));
      tourBublina.style.top = y + 'px';

      let x = r.left + r.width / 2 - sirka / 2;
      x = Math.max(okraj, Math.min(x, window.innerWidth - sirka - okraj));
      tourBublina.style.left = x + 'px';
    }

    // Pri zmene velikosti okna se bublina musi srovnat znovu.
    window.addEventListener('resize', () => {
      if (tour.classList.contains('hidden')) return;
      const k = tourKrokData(tourKrok);
      const cil = k && document.querySelector(k.cil);
      if (cil) umistiBublinu(cil);
    });

    document.getElementById('tour-dal').addEventListener('click', () => {
      if (tourPosledni(tourKrok)) return ukonciProhlidku();
      tourKrok = tourOmez(tourKrok + 1);
      vykresliKrok();
    });

    document.getElementById('tour-zpet').addEventListener('click', () => {
      tourKrok = tourOmez(tourKrok - 1);
      vykresliKrok();
    });

    document.getElementById('tour-konec').addEventListener('click', ukonciProhlidku);

    // Prihlasime se prihlasovacimu kodu, ktery bezi mimo tenhle blok.
    branaHook = ukazBranu;
    profilHook = otevriProfil;
    poPrihlaseni = () => {
      paintProfile();
      nactiUpozorneni();
      nactiStav();
      // Spiz potrebujeme i mimo okno spize - pocita se z ni pripravenost
      // receptu a co booking zamkne.
      loadPantry().then(renderGrid);
      nactiBookingy().then(paintCalBadge);
      nactiNakup();
      zvazUvod();
    };

    /** Otevre uvod: po registraci, nebo kdyz na to vede odkaz z e-mailu. */
    function zvazUvod() {
      const zEmailu = new URLSearchParams(location.search).get('uvod') === '1';
      if (zEmailu) {
        history.replaceState(null, '', location.pathname);
        // Nepřihlášený vidí bránu; přání otevřít úvod si schováme na potom,
        // ať odkaz z e-mailu neskončí schovaný pod ní.
        if (!currentUser) { Store.setUvodPoPrihlaseni(true); return; }
        return otevriUvod();
      }
      if (!currentUser) return;
      if (Store.getUvodPoPrihlaseni()) {
        Store.setUvodPoPrihlaseni(false);
        return otevriUvod();
      }
      if (!currentUser.intro_done) otevriUvod();
    }

    // --- Spiz a profil -----------------------------------------------------

    /** Dotaz na Worker s prihlasovacim listkem. */
    async function api(path, body) {
      const token = Store.getSession();
      if (!token) throw new Error('Nepřihlášeno');
      const res = await fetch(AI_WORKER + path, {
        method: body ? 'POST' : 'GET',
        headers: {
          Authorization: 'Bearer ' + token,
          ...(body ? { 'Content-Type': 'application/json' } : {}),
        },
        body: body ? JSON.stringify(body) : undefined,
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || ('Chyba ' + res.status));
      return data;
    }

    const pantryOverlay = document.getElementById('pantry-overlay');
    const pantryModal   = document.getElementById('pantry-modal');
    const pantryList    = document.getElementById('pantry-list');

    function openPantry() {
      pantryOverlay.classList.remove('hidden');
      requestAnimationFrame(() => {
        pantryOverlay.classList.remove('opacity-0');
        pantryModal.classList.remove('scale-95', 'opacity-0');
      });
      document.getElementById('pantry-detail').checked = Store.getPantryDetail();
      document.getElementById('pantry-signedout').classList.toggle('hidden', !!currentUser);
      document.getElementById('pantry-body').classList.toggle('hidden', !currentUser);
      if (currentUser) loadPantry();
    }

    function closePantry() {
      pantryOverlay.classList.add('opacity-0');
      pantryModal.classList.add('scale-95', 'opacity-0');
      setTimeout(() => pantryOverlay.classList.add('hidden'), 200);
    }

    async function loadPantry() {
      if (!currentUser) return;
      try {
        const data = await api('/api/inventory');
        pantryItems = data.items || [];
        renderPantry();
      } catch (e) {
        if (pantryList) pantryList.innerHTML = '<li class="py-4 text-[13px] text-red-400">' + esc(e.message) + '</li>';
      }
    }

    /**
     * Mnozstvi s tlacitky - a +. Krok se ridi jednotkou (100 g u masa,
     * pul kila u brambor, jeden kus u vajec) - viz krokMnozstvi.
     *
     * Pole zustava psatelne, aby slo hodnotu i prepsat rovnou.
     */
    function krokovadlo(trida, id, hodnota, jednotka, krok) {
      const dataId = 'data-id="' + escAttr(id) + '"';
      return '<div class="krokovadlo">' +
        '<button type="button" class="' + trida + '-minus krok-btn" ' + dataId +
          ' aria-label="O ' + escAttr(krok) + ' míň">&minus;</button>' +
        '<input class="' + trida + '-qty krok-pole" type="number" min="0" step="any" ' +
          'inputmode="decimal" placeholder="—" value="' + escAttr(hodnota) + '" ' + dataId + ' />' +
        '<button type="button" class="' + trida + '-plus krok-btn" ' + dataId +
          ' aria-label="O ' + escAttr(krok) + ' víc">+</button>' +
        '</div>';
    }

    let pantryHledane = '';

    function renderPantry() {
      const views = pantryView(pantryItems, Store.getPantryDetail());
      document.getElementById('pantry-empty').classList.toggle('hidden', views.length > 0);
      document.getElementById('pantry-count').textContent =
        views.length === 0 ? '' : views.length + (views.length < 5 ? ' suroviny' : ' surovin');

      // Stav kazde polozky se pocita stejne jako v radku nize, at
      // prehled a prouzky nikdy neukazuji neco jineho.
      const stavy = views.map(v => v.showQuantity
        ? (Number(v.quantity) > 0 ? 'mam' : 'doslo')
        : (v.status || 'doslo'));
      const kolik = st => stavy.filter(x => x === st).length;
      document.getElementById('spiz-pocet-mam').textContent = kolik('mam');
      document.getElementById('spiz-pocet-dochazi').textContent = kolik('dochazi');
      document.getElementById('spiz-pocet-doslo').textContent = kolik('doslo');
      document.getElementById('spiz-prehled').classList.toggle('hidden', views.length === 0);

      // Odznak u tlacitka: kolik veci dochazi nebo doslo. Nula se
      // neukazuje - prazdny krouzek nikomu nic nerekne.
      const odznak = document.getElementById('pantry-badge');
      if (odznak) {
        const dochazi = kolik('dochazi') + kolik('doslo');
        odznak.textContent = dochazi > 99 ? '99+' : dochazi;
        odznak.classList.toggle('hidden', dochazi === 0);
      }

      const sekce = spizPodleSekci(views, pantryHledane);
      const nenalezeno = document.getElementById('pantry-nenalezeno');
      nenalezeno.classList.toggle('hidden', sekce.length > 0 || views.length === 0);
      if (pantryHledane && !sekce.length) {
        nenalezeno.textContent = 'Ve spíži nic jako „' + pantryHledane + '“ nemáš.';
      }

      const radek = v => {
        const polozka = pantryItems.find(x => String(x.id) === String(v.id)) || v;
        const ovladani = v.showQuantity
          ? '<div class="flex items-center gap-1.5">' +
              krokovadlo('pantry', v.id, v.quantity, v.unit, krokMnozstvi(polozka)) +
              '<input class="pantry-unit w-14 bg-surface border border-border rounded-lg py-1.5 px-2 text-text-muted text-[13px] focus:outline-none focus:border-accent" ' +
              'type="text" maxlength="20" placeholder="' + (v.countable ? 'ks' : 'g') + '" value="' + escAttr(v.unit) + '" data-id="' + escAttr(v.id) + '" />' +
            '</div>'
          : '<div class="flex gap-1">' + STATUSES.map(st =>
              '<button class="pantry-status px-2.5 py-1.5 rounded-lg text-[12px] border transition-colors ' +
              (v.status === st ? 'bg-accent text-white border-accent' : 'bg-surface text-text-muted border-border hover:border-accent') +
              '" data-id="' + escAttr(v.id) + '" data-status="' + escAttr(st) + '">' + esc(statusLabel(st)) + '</button>'
            ).join('') + '</div>';

        // Stav se pozna barvou proužku i tvarem popisku - barva sama
        // by u "dochází" a "došlo" splynula (4.7: barva nesmi byt
        // jediny signal).
        const stav = v.showQuantity
          ? (Number(v.quantity) > 0 ? 'mam' : 'doslo')
          : (v.status || 'doslo');

        return '<li class="spiz-radek je-' + stav + (v.staple ? ' je-staple' : '') + '">' +
          '<div class="min-w-0 flex-1">' +
            '<p class="spiz-nazev">' + esc(v.name) + '</p>' +
            '<button type="button" class="pantry-staple spiz-staple" data-id="' + escAttr(v.id) + '"' +
              ' aria-pressed="' + (v.staple ? 'true' : 'false') + '"' +
              ' title="Mám doma standardně — nikdy se nepřidá do nákupu">' +
              (v.staple ? '&#8962; vždycky doma' : 'mám vždycky') +
            '</button>' +
          '</div>' +
          ovladani +
          '<button class="pantry-del w-8 h-8 rounded-lg text-text-muted hover:text-red-400 transition-colors shrink-0" data-id="' + escAttr(v.id) + '" title="Odebrat">&times;</button>' +
        '</li>';
      };

      pantryList.innerHTML = sekce.map(sek =>
        '<section class="spiz-sekce">' +
          '<h4 class="spiz-nadpis">' + esc(sek.nazev) +
            '<span class="spiz-pocet">' + sek.polozky.length + '</span></h4>' +
          '<ul class="spiz-seznam">' + sek.polozky.map(radek).join('') + '</ul>' +
        '</section>'
      ).join('');

      bindPantryRows();
    }

    function itemById(id) {
      return pantryItems.find(x => String(x.id) === String(id));
    }

    async function savePantryItem(item) {
      try {
        const data = await api('/api/inventory', { item: item });
        pantryItems = data.items || [];
        renderPantry();
      } catch (e) { alert(e.message); }
    }

    (function () {
      const h = document.getElementById('pantry-hledat');
      if (h) h.addEventListener('input', () => {
        pantryHledane = h.value;
        renderPantry();
      });
    })();

    function bindPantryRows() {
      pantryList.querySelectorAll('.pantry-status').forEach(b =>
        b.addEventListener('click', () => {
          const it = itemById(b.dataset.id);
          if (it) savePantryItem({ ...it, status: b.dataset.status });
        })
      );
      // Uz to neni zaskrtavatko, ale prepinaci pilulka - stav se cte
      // z aria-pressed, ne z .checked.
      pantryList.querySelectorAll('.pantry-staple').forEach(c =>
        c.addEventListener('click', () => {
          const it = itemById(c.dataset.id);
          if (it) savePantryItem({ ...it, staple: c.getAttribute('aria-pressed') === 'true' ? 0 : 1 });
        })
      );
      // Ukladame az pri odchodu z policka, ne pri kazde stisknute klavese.
      pantryList.querySelectorAll('.pantry-minus, .pantry-plus').forEach(b =>
        b.addEventListener('click', () => {
          const it = itemById(b.dataset.id);
          if (!it) return;
          const smer = b.classList.contains('pantry-plus') ? 1 : -1;
          savePantryItem({ ...it, quantity: posunMnozstvi(it, smer) });
        })
      );
      pantryList.querySelectorAll('.pantry-qty, .pantry-unit').forEach(inp =>
        inp.addEventListener('change', () => {
          const it = itemById(inp.dataset.id);
          if (!it) return;
          const qty = pantryList.querySelector('.pantry-qty[data-id="' + inp.dataset.id + '"]');
          const unit = pantryList.querySelector('.pantry-unit[data-id="' + inp.dataset.id + '"]');
          savePantryItem({ ...it, quantity: qty ? qty.value : '', unit: unit ? unit.value : '' });
        })
      );
      pantryList.querySelectorAll('.pantry-del').forEach(b =>
        b.addEventListener('click', async () => {
          const it = itemById(b.dataset.id);
          if (!it || !confirm('Odebrat ' + it.name + ' ze spíže?')) return;
          try {
            const data = await api('/api/inventory', { action: 'delete', id: it.id });
            pantryItems = data.items || [];
            renderPantry();
          } catch (e) { alert(e.message); }
        })
      );
    }

    document.getElementById('pantry-btn').addEventListener('click', openPantry);
    document.getElementById('pantry-close').addEventListener('click', closePantry);
    pantryOverlay.addEventListener('click', e => { if (e.target === pantryOverlay) closePantry(); });
    document.getElementById('pantry-login').addEventListener('click', startGoogleLogin);

    document.getElementById('pantry-add').addEventListener('click', addFromInput);
    document.getElementById('pantry-new').addEventListener('keydown', e => {
      if (e.key === 'Enter') addFromInput();
    });

    function addFromInput() {
      const input = document.getElementById('pantry-new');
      const name = input.value.trim();
      if (!name) return;
      input.value = '';
      // Mozek rozhodne, jestli se surovina vazi, nebo staci mam/dochazi/doslo.
      savePantryItem({ name: name, kind: guessKind(name), status: 'mam', staple: 0 });
    }

    document.getElementById('pantry-seed').addEventListener('click', async () => {
      const items = starterList(recipes).slice(0, 120);
      if (!items.length) return;
      try {
        const data = await api('/api/inventory', { action: 'seed', items: items });
        pantryItems = data.items || [];
        renderPantry();
      } catch (e) { alert(e.message); }
    });

    // --- Dlouhy seznam k proklikani (4.9) ---
    const checklistOverlay = document.getElementById('checklist-overlay');
    const checklistModal   = document.getElementById('checklist-modal');
    const checklistBody    = document.getElementById('checklist-body');
    let checklistGroups = [];

    function openChecklist() {
      document.getElementById('checklist-detail').checked = Store.getPantryDetail();
      checklistGroups = buildChecklist(recipes, pantryItems);
      renderChecklist();
      checklistOverlay.classList.remove('hidden');
      requestAnimationFrame(() => {
        checklistOverlay.classList.remove('opacity-0');
        checklistModal.classList.remove('scale-95', 'opacity-0');
      });
    }

    function closeChecklist() {
      checklistOverlay.classList.add('opacity-0');
      checklistModal.classList.add('scale-95', 'opacity-0');
      setTimeout(() => checklistOverlay.classList.add('hidden'), 200);
      document.getElementById('checklist-filter').value = '';
    }

    function renderChecklist() {
      const detail = Store.getPantryDetail();
      const hledat = fold(document.getElementById('checklist-filter').value.trim());
      const postup = checklistProgress(checklistGroups);
      document.getElementById('checklist-progress').textContent =
        'Vyplněno ' + postup.label;

      let html = '';
      checklistGroups.forEach(skupina => {
        const items = hledat
          ? skupina.items.filter(it => fold(it.name).includes(hledat))
          : skupina.items;
        if (!items.length) return;

        html += '<h3 class="label text-accent sticky top-0 bg-bg py-2 z-10">' + esc(skupina.group) + '</h3>';
        html += '<ul class="divide-y divide-border mb-3">' + items.map(it => radek(it, detail)).join('') + '</ul>';
      });

      checklistBody.innerHTML = html ||
        '<p class="py-8 text-center text-[13px] text-text-muted">Nic takového v seznamu není. Přidat vlastní jde ve spíži.</p>';
      bindChecklistRows();
    }

    /**
     * Jeden radek seznamu.
     *
     * - priblizna surovina  -> jen Mam / Dochazi / Nemam
     * - pocitana (vejce)    -> pocet a "ks"
     * - vazena (maso)       -> mnozstvi a jednotka
     *
     * `detail` = uzivatel si nahore rekl, ze chce mnozstvi uplne u vseho.
     */
    function radek(it, detail) {
      const klic = escAttr(it.name);
      const ptatSeNaMnozstvi = detail || it.kind !== 'approx';

      // Kdyz katalog zna vic jednotek (brambory kg/ks), nabidneme vyber.
      const jednotka = it.units && it.units.length
        ? '<select class="chk-unit bg-surface border border-border rounded-lg py-1.5 px-1 text-text-muted text-[12px] focus:outline-none focus:border-accent" data-name="' + klic + '">' +
            it.units.map(u => '<option value="' + escAttr(u) + '"' + ((it.unit || it.units[0]) === u ? ' selected' : '') + '>' + esc(u) + '</option>').join('') +
          '</select>'
        : '<input class="chk-unit w-14 bg-surface border border-border rounded-lg py-1.5 px-2 text-text-muted text-[13px] focus:outline-none focus:border-accent" ' +
          'type="text" maxlength="20" placeholder="' + (it.kind === 'count' ? 'ks' : 'g') + '" value="' + escAttr(it.unit) + '" data-name="' + klic + '" />';

      const ovladani = !ptatSeNaMnozstvi
        ? '<div class="flex gap-1 shrink-0">' + STATUSES.map(st =>
            '<button class="chk-status px-2 py-1.5 rounded-lg text-[12px] border transition-colors ' +
            (it.status === st ? 'bg-accent text-white border-accent' : 'bg-surface text-text-muted border-border hover:border-accent') +
            '" data-name="' + klic + '" data-status="' + escAttr(st) + '">' + esc(statusLabel(st)) + '</button>'
          ).join('') + '</div>'
        : '<div class="flex items-center gap-1.5 shrink-0">' +
            krokovadloSeznam(it, klic) +
            jednotka +
          '</div>';

      return '<li class="py-2.5 flex items-center gap-3">' +
        '<span class="w-2 h-2 rounded-full shrink-0 ' + (it.inPantry ? 'bg-accent' : 'bg-border') + '"></span>' +
        '<span class="flex-1 min-w-0 text-[14px] text-text truncate">' + esc(it.name) + '</span>' +
        ovladani +
      '</li>';
    }

    /** Krokovadlo v dlouhem seznamu. Klic je nazev, ne id - polozka
     *  jeste nemusi ve spizi existovat. */
    function krokovadloSeznam(it, klic) {
      const krok = krokMnozstvi({ kind: it.kind, unit: it.unit || (it.units && it.units[0]) });
      return '<div class="krokovadlo">' +
        '<button type="button" class="chk-minus krok-btn" data-name="' + klic + '" aria-label="O ' + escAttr(krok) + ' míň">&minus;</button>' +
        '<input class="chk-qty krok-pole" type="number" min="0" step="any" inputmode="decimal" ' +
          'placeholder="—" value="' + escAttr(it.quantity) + '" data-name="' + klic + '" />' +
        '<button type="button" class="chk-plus krok-btn" data-name="' + klic + '" aria-label="O ' + escAttr(krok) + ' víc">+</button>' +
        '</div>';
    }

    function checklistItem(name) {
      for (const g of checklistGroups) {
        for (const it of g.items) if (it.name === name) return it;
      }
      return null;
    }

    /** Ulozi radek. Kdyz surovina ve spizi jeste neni, tenhle zapis ji zalozi. */
    async function saveChecklistRow(it, zmena) {
      const novy = { ...it, ...zmena };
      // Kdyz uzivatel vyplni mnozstvi u priblizne suroviny (protoze si
      // zapnul detail), prestava byt priblizna - jinak by se mu to neulozilo.
      if (novy.kind === 'approx' && zmena.quantity !== undefined && zmena.quantity !== '') {
        novy.kind = 'exact';
      }
      try {
        const data = await api('/api/inventory', {
          item: {
            id: it.id || undefined,
            name: it.name,
            kind: novy.kind,
            quantity: novy.quantity,
            unit: novy.unit,
            status: novy.status,
            staple: novy.staple ? 1 : 0,
          },
        });
        pantryItems = data.items || [];
        // Seznam prestavime nad novou spizi, at sedi id a teckky u polozek.
        const hledat = document.getElementById('checklist-filter').value;
        checklistGroups = buildChecklist(recipes, pantryItems);
        document.getElementById('checklist-filter').value = hledat;
        renderChecklist();
        renderPantry();
      } catch (e) { alert(e.message); }
    }

    function bindChecklistRows() {
      checklistBody.querySelectorAll('.chk-status').forEach(b =>
        b.addEventListener('click', () => {
          const it = checklistItem(b.dataset.name);
          if (it) saveChecklistRow(it, { status: b.dataset.status });
        })
      );
      checklistBody.querySelectorAll('.chk-minus, .chk-plus').forEach(b =>
        b.addEventListener('click', () => {
          const it = checklistItem(b.dataset.name);
          if (!it) return;
          const smer = b.classList.contains('chk-plus') ? 1 : -1;
          const jednotka = it.unit || (it.units && it.units[0]) || '';
          saveChecklistRow(it, {
            quantity: posunMnozstvi({ kind: it.kind, unit: jednotka, quantity: it.quantity }, smer),
            unit: jednotka,
          });
        })
      );
      checklistBody.querySelectorAll('.chk-qty, .chk-unit').forEach(inp =>
        inp.addEventListener('change', () => {
          const it = checklistItem(inp.dataset.name);
          if (!it) return;
          const q = checklistBody.querySelector('.chk-qty[data-name="' + CSS.escape(inp.dataset.name) + '"]');
          const u = checklistBody.querySelector('.chk-unit[data-name="' + CSS.escape(inp.dataset.name) + '"]');
          saveChecklistRow(it, { quantity: q ? q.value : '', unit: u ? u.value : '' });
        })
      );
    }

    function nastavDetail(on) {
      Store.setPantryDetail(on);
      const a = document.getElementById('pantry-detail');
      const b = document.getElementById('checklist-detail');
      if (a) a.checked = on;
      if (b) b.checked = on;
      renderPantry();
      if (!checklistOverlay.classList.contains('hidden')) renderChecklist();
    }

    document.getElementById('pantry-detail').addEventListener('change', e => nastavDetail(e.target.checked));
    document.getElementById('checklist-detail').addEventListener('change', e => nastavDetail(e.target.checked));

    document.getElementById('checklist-open').addEventListener('click', openChecklist);
    document.getElementById('checklist-close').addEventListener('click', closeChecklist);
    checklistOverlay.addEventListener('click', e => { if (e.target === checklistOverlay) closeChecklist(); });
    document.getElementById('checklist-filter').addEventListener('input', renderChecklist);

    // --- Stav receptu: oblibene, hodnoceni, "chci vyzkouset" ---------------
    // Zatim se drzi v prohlizeci a do databaze se posila navic - diky tomu
    // appka funguje i bez prihlaseni a data se srovnaji mezi zarizenimi.


    function jeVeWishlistu(slug) {
      return wishlist.indexOf(slug) >= 0;
    }

    function prepniWishlist(slug) {
      const i = wishlist.indexOf(slug);
      if (i >= 0) wishlist.splice(i, 1); else wishlist.push(slug);
      Store.setWishlist(wishlist);
      paintWishBtn(slug);
      posliStav();
    }

    function paintWishBtn(slug) {
      const btn = document.getElementById('wish-btn');
      const label = document.getElementById('wish-label');
      if (!btn || !label) return;
      const je = jeVeWishlistu(slug);
      label.textContent = je ? 'Chci vyzkoušet ✓' : 'Chci vyzkoušet';
      btn.classList.toggle('text-accent', je);
      btn.classList.toggle('border-accent', je);
    }

    /** Slozi stav vsech receptu, o kterych appka nebo databaze neco vi. */
    function sberStavu() {
      const slugy = new Set([...favorites, ...wishlist, ...znameServeru]);
      recipes.forEach(r => {
        const rev = getReview(r.slug);
        if (rev.stars || rev.note || rev.cooked) slugy.add(r.slug);
      });
      return [...slugy].map(slug => {
        const rev = getReview(slug);
        return {
          slug: slug,
          favorite: favorites.indexOf(slug) >= 0,
          status: rev.cooked > 0 ? 'uvareno' : (jeVeWishlistu(slug) ? 'wishlist' : 'neuvareno'),
          stars: rev.stars || 0,
          note: rev.note || '',
          cooked: rev.cooked || 0,
          lastCooked: rev.lastCooked || null,
        };
      });
    }

    /** Posle stav do databaze. Kdyz nejsi prihlasen, tise se nic nedeje. */
    let posilaniStavu = null;
    function posliStav() {
      if (!currentUser) return;
      clearTimeout(posilaniStavu);
      posilaniStavu = setTimeout(() => {
        api('/api/state', { items: sberStavu() }).catch(() => {});
      }, 800);
    }

    /** Po prihlaseni stahne, co uz o uzivateli databaze vi, a doplni to. */
    async function nactiStav() {
      if (!currentUser) return;
      try {
        const data = await api('/api/state', { items: sberStavu() });
        (data.items || []).forEach(it => {
          znameServeru.add(it.slug);
          if (it.favorite && favorites.indexOf(it.slug) < 0) favorites.push(it.slug);
          if (it.status === 'wishlist' && wishlist.indexOf(it.slug) < 0) wishlist.push(it.slug);

          // Slucuje se po polozkach a vzdycky - drive se cely radek
          // prepsal jen tehdy, kdyz mel server vic uvareni nebo hvezdicek,
          // takze poznamka z jineho telefonu se sem nikdy nedostala.
          const rev = getReview(it.slug);
          const slouceny = {
            stars: Math.max(it.stars || 0, rev.stars || 0),
            note: rev.note || it.note || '',
            cooked: Math.max(it.cooked || 0, rev.cooked || 0),
            lastCooked: it.lastCooked || rev.lastCooked || null,
          };
          if (JSON.stringify(slouceny) !== JSON.stringify(rev)) {
            reviewCache.set(it.slug, slouceny);
            Store.setReview(it.slug, slouceny);
          }
        });
        Store.setFavorites(favorites);
        Store.setWishlist(wishlist);
        renderGrid();
      } catch {}
    }

    document.getElementById('wish-btn')?.addEventListener('click', () => {
      if (currentSlug) prepniWishlist(currentSlug);
    });

    // --- Co komu chodi ----------------------------------------------------
    //
    // Nic se nezapina ani nevypina v appce. E-maily maji odhlasovaci
    // odkaz, oznameni se vypinaji v telefonu a kalendar v uctu Google -
    // tam je clovek hleda, kdyz ho neco otravuje.
    //
    // /api/notify se porad vola: nese verejny klic k oznamenim.
    async function nactiUpozorneni() {
      if (!currentUser) return;
      try {
        await zvazNabidkuOznameni(await api('/api/notify'));
      } catch {}
    }

    // --- Oznameni na telefon ----------------------------------------------
    //
    // Zapnuto je od zacatku - stejne jako e-maily a kalendar. Jenze
    // prohlizec nepusti nikoho k oznamenim bez povoleni a zeptat se na
    // nej smi POUZE jako reakce na kliknuti. "Od zacatku" tedy prakticky
    // znamena: zeptame se jednou, hned jak je koho se ptat, a odpoved
    // respektujeme.
    //
    // Kdo odmitne, uz se nedozvi nic - zadne pripominani, zadny prepinac
    // v nastaveni. Zapnout to jde pak uz jen v nastaveni prohlizece,
    // protoze odtamtud to taky vyplo.

    let pushVapid = '';

    const jdePush = () =>
      'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window;

    /** Klic ze serveru je text, prohlizec chce bajty. */
    function klicNaBajty(base64) {
      const s = String(base64).replace(/-/g, '+').replace(/_/g, '/');
      const bin = atob(s + '='.repeat((4 - s.length % 4) % 4));
      const out = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
      return out;
    }

    /**
     * Prihlasi tenhle prohlizec k odberu oznameni.
     * Musi bezet z kliknuti, jinak prohlizec dotaz na povoleni zahodi.
     */
    async function prihlasPush() {
      const povoleni = await Notification.requestPermission();
      if (povoleni !== 'granted') return false;

      const reg = await navigator.serviceWorker.ready;
      // Stara prihlaska muze byt k jinemu klici (kdyby se klice menily).
      const stara = await reg.pushManager.getSubscription();
      if (stara) await stara.unsubscribe().catch(() => {});

      const sub = await reg.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: klicNaBajty(pushVapid),
      });

      const json = sub.toJSON();
      await api('/api/push', {
        endpoint: sub.endpoint,
        p256dh: json.keys && json.keys.p256dh,
        auth: json.keys && json.keys.auth,
      });
      return true;
    }

    /**
     * Jednorazova nabidka. Ukaze se jen tehdy, kdyz ma smysl:
     * prihlaseny clovek, prohlizec to umi, server ma klice a uzivatel
     * se jeste nerozhodl.
     */
    async function zvazNabidkuOznameni(stav) {
      pushVapid = (stav && stav.vapid) || '';
      const pruh = document.getElementById('push-nabidka');
      if (!pruh) return;

      if (!currentUser || !jdePush() || !pushVapid) return;
      if (Notification.permission === 'denied') return;       // rekl ne prohlizeci
      if (Store.getPushOdmitnuto()) return;                   // rekl ne nam

      const reg = await navigator.serviceWorker.ready.catch(() => null);
      if (reg && await reg.pushManager.getSubscription()) return;   // uz odebira

      // Povoleni uz udelene, ale odber zadny: nema smysl se ptat znovu -
      // prohlizec by se stejne uz nezeptal a pruh by nesel odklepnout.
      // Prihlasime k odberu rovnou a tise.
      if (Notification.permission === 'granted') {
        prihlasPush().catch(() => {});
        return;
      }

      pruh.classList.remove('hidden');
      requestAnimationFrame(() => pruh.classList.remove('translate-y-32', 'opacity-0'));
    }

    function schovejNabidkuOznameni() {
      const pruh = document.getElementById('push-nabidka');
      if (!pruh) return;
      pruh.classList.add('translate-y-32', 'opacity-0');
      setTimeout(() => pruh.classList.add('hidden'), 250);
    }

