    // -- Duration parsing (Czech) --
    function parseDurations(text) {
      const out = [];
      const re = /(\d+)(?:\s*[\u2013\u2014-]\s*(\d+))?\s*(hodin\w*|hod\.?|minut\w*|min\.?|sekund\w*|vte\u0159in\w*|sek\.?)/gi;
      let m;
      while ((m = re.exec(text)) !== null) {
        const hi = parseInt(m[2] || m[1], 10);
        const u = m[3].toLowerCase();
        let secs;
        if (u.indexOf('hod') === 0) secs = hi * 3600;
        else if (u.indexOf('sek') === 0 || u.indexOf('vte') === 0) secs = hi;
        else secs = hi * 60;
        if (!secs || secs < 5 || secs > 6 * 3600) continue;
        if (out.some(o => o.secs === secs)) continue;
        out.push({ secs: secs, label: m[0].trim() });
      }
      return out.slice(0, 3);
    }

    function fmtClock(s) {
      const m = Math.floor(s / 60), sec = s % 60;
      if (m >= 60) return Math.floor(m / 60) + ':' + String(m % 60).padStart(2, '0') + ':' + String(sec).padStart(2, '0');
      return m + ':' + String(sec).padStart(2, '0');
    }

    // -- Parallel timers --
    let timers = [];
    let timerTick = null;
    let audioCtx = null;

    function beep() {
      try {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (AC) {
          audioCtx = audioCtx || new AC();
          if (audioCtx.state === 'suspended') audioCtx.resume();
          [0, 0.3, 0.6].forEach(off => {
            const o = audioCtx.createOscillator(), g = audioCtx.createGain();
            o.connect(g); g.connect(audioCtx.destination);
            o.type = 'sine'; o.frequency.value = 880;
            const t = audioCtx.currentTime + off;
            g.gain.setValueAtTime(0.0001, t);
            g.gain.exponentialRampToValueAtTime(0.4, t + 0.02);
            g.gain.exponentialRampToValueAtTime(0.0001, t + 0.25);
            o.start(t); o.stop(t + 0.27);
          });
        }
      } catch {}
      try { if (navigator.vibrate) navigator.vibrate([300, 130, 300, 130, 300]); } catch {}
    }

    function notifyDone(t) {
      beep();
      try {
        if ('Notification' in window && Notification.permission === 'granted') {
          new Notification('\u010casova\u010d dob\u011bhl \u2014 krok ' + t.step, { body: t.label, tag: 'cook-' + t.id });
        }
      } catch {}
    }

    function startTimer(secs, label, stepNo) {
      if (timers.some(t => t.step === stepNo && t.total === secs && !t.done)) return;
      try { if ('Notification' in window && Notification.permission === 'default') Notification.requestPermission(); } catch {}
      try { const AC = window.AudioContext || window.webkitAudioContext; if (AC) { audioCtx = audioCtx || new AC(); if (audioCtx.state === 'suspended') audioCtx.resume(); } } catch {}
      timers.push({ id: String(Date.now()) + Math.floor(Math.random() * 1000), total: secs, left: secs, label: label, step: stepNo, done: false });
      if (!timerTick) timerTick = setInterval(tickTimers, 1000);
      renderTimers(); renderStepTimerBtns();
    }

    function tickTimers() {
      if (timers.length === 0) { clearInterval(timerTick); timerTick = null; return; }
      timers.forEach(t => {
        if (t.done) return;
        t.left--;
        if (t.left <= 0) { t.left = 0; t.done = true; notifyDone(t); }
      });
      renderTimers();
    }

    function renderTimers() {
      if (!cookTimersBar) return;
      if (timers.length === 0) { cookTimersBar.classList.add('hidden'); cookTimersBar.classList.remove('flex'); cookTimersBar.innerHTML = ''; return; }
      cookTimersBar.classList.remove('hidden'); cookTimersBar.classList.add('flex');
      cookTimersBar.innerHTML = timers.map(t => {
        const pct = t.total ? Math.round((1 - t.left / t.total) * 100) : 100;
        return '<button class="timer-chip' + (t.done ? ' is-done' : '') + '" data-tid="' + t.id + '" style="--p:' + pct + '%">' +
               '<span class="timer-step">' + t.step + '</span>' +
               '<span class="timer-clock">' + (t.done ? 'Hotovo' : fmtClock(t.left)) + '</span>' +
               '<span class="timer-x">\u00d7</span></button>';
      }).join('');
      cookTimersBar.querySelectorAll('.timer-chip').forEach(c => {
        c.addEventListener('click', e => {
          e.stopPropagation();
          timers = timers.filter(t => t.id !== c.dataset.tid);
          if (timers.length === 0 && timerTick) { clearInterval(timerTick); timerTick = null; }
          renderTimers(); renderStepTimerBtns();
        });
      });
    }

    function renderStepTimerBtns() {
      if (!cookStepTimer) return;
      const ds = parseDurations(cookSteps[cookIndex] || '');
      if (ds.length === 0) { cookStepTimer.classList.add('hidden'); cookStepTimer.classList.remove('flex'); cookStepTimer.innerHTML = ''; return; }
      cookStepTimer.classList.remove('hidden'); cookStepTimer.classList.add('flex');
      cookStepTimer.innerHTML = ds.map(d => {
        const running = timers.some(t => t.step === cookIndex + 1 && t.total === d.secs && !t.done);
        return '<button class="timer-start' + (running ? ' is-running' : '') + '" data-secs="' + d.secs + '" data-label="' + d.label.replace(/"/g, '&quot;') + '"' + (running ? ' disabled' : '') + '>' +
               '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>' +
               (running ? 'B\u011b\u017e\u00ed' : fmtClock(d.secs)) + '</button>';
      }).join('');
      cookStepTimer.querySelectorAll('.timer-start').forEach(b => {
        b.addEventListener('click', e => {
          e.stopPropagation();
          startTimer(parseInt(b.dataset.secs, 10), b.dataset.label, cookIndex + 1);
        });
      });
    }

    // -- Step rendering + transition --
    function paintStep() {
      const n = cookIndex + 1;
      cookStepNum.textContent = fancyMode
        ? 'Chod ' + roman(n) + ' z ' + roman(cookSteps.length)
        : 'Krok ' + n + ' / ' + cookSteps.length;
      const ghost = document.getElementById('cook-ghost');
      if (ghost) ghost.textContent = fancyMode ? roman(n) : n;
      cookStepText.textContent = cookSteps[cookIndex] || '';
      cookProgress.textContent = fancyMode
        ? 'Chod ' + roman(n) + ' z ' + roman(cookSteps.length)
        : 'Krok ' + n + ' z ' + cookSteps.length;
      document.getElementById('cook-bar').style.width = ((cookIndex + 1) / cookSteps.length * 100) + '%';
      if (cookPrev) cookPrev.disabled = cookIndex === 0;
      if (cookNext) cookNext.textContent = cookIndex === cookSteps.length - 1 ? 'Hotovo \u2713' : 'Dal\u0161\u00ed \u2192';
      renderStepTimerBtns();
    }

    function goStep(target, dir) {
      if (cookAnimating || target < 0 || target >= cookSteps.length) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { cookIndex = target; paintStep(); return; }
      cookAnimating = true;
      cookSlide.style.setProperty('--dir', dir > 0 ? '-1' : '1');
      cookSlide.classList.add('is-out');
      setTimeout(() => {
        cookIndex = target;
        paintStep();
        cookSlide.classList.remove('is-out');
        cookSlide.style.setProperty('--dir', dir > 0 ? '1' : '-1');
        cookSlide.classList.add('is-pre');
        requestAnimationFrame(() => requestAnimationFrame(() => {
          cookSlide.classList.remove('is-pre');
          setTimeout(() => { cookAnimating = false; }, 280);
        }));
      }, 175);
    }

    function nextStep() { if (cookIndex < cookSteps.length - 1) goStep(cookIndex + 1, 1); else finishCooking(); }
    function prevStep() { if (cookIndex > 0) goStep(cookIndex - 1, -1); }

    // -- Confetti --
    function fireConfetti() {
      const cv = document.getElementById('cook-confetti');
      if (!cv || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const w = cookStage.clientWidth, h = cookStage.clientHeight;
      if (!w || !h) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      cv.width = w * dpr; cv.height = h * dpr;
      cv.style.width = w + 'px'; cv.style.height = h + 'px';
      cv.classList.remove('hidden');
      const ctx = cv.getContext('2d');
      ctx.scale(dpr, dpr);
      let accent = '';
      try { accent = getComputedStyle(document.documentElement).getPropertyValue('--color-accent').trim(); } catch {}
      const colors = [accent || '#e07850', '#ffffff', '#ffd166', '#06d6a0', '#ef476f'];
      const parts = [];
      for (let i = 0; i < 150; i++) {
        parts.push({
          x: w / 2 + (Math.random() - 0.5) * w * 0.5,
          y: h * 0.58,
          vx: (Math.random() - 0.5) * 14,
          vy: -Math.random() * 17 - 7,
          s: 4 + Math.random() * 7,
          rot: Math.random() * Math.PI,
          vr: (Math.random() - 0.5) * 0.4,
          c: colors[Math.floor(Math.random() * colors.length)],
          life: 1
        });
      }
      let f = 0;
      (function loop() {
        f++;
        ctx.clearRect(0, 0, w, h);
        parts.forEach(p => {
          if (p.life <= 0) return;
          p.vy += 0.44; p.vx *= 0.995;
          p.x += p.vx; p.y += p.vy; p.rot += p.vr;
          if (p.y > h * 0.7) p.life -= 0.022;
          ctx.save();
          ctx.globalAlpha = Math.max(p.life, 0);
          ctx.translate(p.x, p.y); ctx.rotate(p.rot);
          ctx.fillStyle = p.c;
          ctx.fillRect(-p.s / 2, -p.s / 2, p.s, p.s * 0.62);
          ctx.restore();
        });
        if (f < 200) requestAnimationFrame(loop);
        else { ctx.clearRect(0, 0, w, h); cv.classList.add('hidden'); }
      })();
    }

    function finishCooking() {
      fireConfetti();
      try { if (navigator.vibrate) navigator.vibrate([60, 50, 60]); } catch {}
      cookStepText.textContent = fancyMode ? 'Servírováno. Dobrou chu\u0165!' : 'Hotovo. Dobrou chu\u0165!';
      cookStepNum.textContent = fancyMode ? 'Dokon\u010deno' : 'Uva\u0159eno';
      cookStepTimer.classList.add('hidden');
      if (cookNext) cookNext.textContent = 'Zav\u0159\u00edt';
      setTimeout(() => { if (!cookOverlay.classList.contains('hidden')) closeCookMode(); }, 2600);
    }

    // -- Ingredients drawer --
    const cookIngPanel    = document.getElementById('cook-ing-panel');
    const cookIngBackdrop = document.getElementById('cook-ing-backdrop');
    const cookIngList     = document.getElementById('cook-ing-list');
    const cookIngValue    = document.getElementById('cook-ing-value');
    let cookIngOpen = false;

    function renderCookIngredients() {
      if (!cookRecipe || !cookIngList) return;
      const base = cookRecipe.servings || 4;
      const factor = cookServings / base;
      cookIngValue.textContent = cookServings + ' ' + (cookServings < 5 ? 'porce' : 'porc\u00ed');
      cookIngList.innerHTML = (variantOf(cookRecipe).ingredients || []).map(raw =>
        '<li class="cook-ing"><span class="cook-ing-box"></span><span class="cook-ing-txt">' + scaleIngredient(raw, factor) + '</span></li>'
      ).join('');
      cookIngList.querySelectorAll('.cook-ing').forEach(li =>
        li.addEventListener('click', () => li.classList.toggle('is-done'))
      );
    }

    function setCookIng(open) {
      cookIngOpen = open;
      cookIngPanel.classList.toggle('translate-y-full', !open);
      cookIngBackdrop.classList.toggle('hidden', !open);
    }
    document.getElementById('cook-ing-btn').addEventListener('click', () => { renderCookIngredients(); setCookIng(true); });
    document.getElementById('cook-ing-close').addEventListener('click', () => setCookIng(false));
    cookIngBackdrop.addEventListener('click', () => setCookIng(false));
    document.getElementById('cook-ing-minus').addEventListener('click', () => { if (cookServings > 1) { cookServings--; renderCookIngredients(); } });
    document.getElementById('cook-ing-plus').addEventListener('click', () => { if (cookServings < 20) { cookServings++; renderCookIngredients(); } });

    // -- Open / close --
    document.getElementById('cook-mode-btn').addEventListener('click', () => {
      const r = recipes.find(x => x.slug === currentSlug);
      if (!r || !variantOf(r).steps.length) return;
      cookRecipe = r;
      cookSteps = variantOf(r).steps;
      cookIndex = 0;
      cookServings = currentServings || r.servings || 4;
      timers = [];
      if (timerTick) { clearInterval(timerTick); timerTick = null; }
      renderTimers();
      cookTitle.textContent = r.title;
      cookOverlay.classList.toggle('is-fancy', fancyMode);
      paintStep();
      setCookIng(false);
      cookOverlay.classList.remove('hidden');
      cookOverlay.classList.add('flex');
      document.body.style.overflow = 'hidden';
      requestWakeLock();
    });

    function closeCookMode() {
      cookOverlay.classList.add('hidden');
      cookOverlay.classList.remove('flex');
      document.body.style.overflow = '';
      setCookIng(false);
      timers = [];
      if (timerTick) { clearInterval(timerTick); timerTick = null; }
      renderTimers();
      releaseWakeLock();
    }
    document.getElementById('cook-close').addEventListener('click', closeCookMode);

    // -- Tap zones: left third back, right two-thirds forward --
    cookStage.addEventListener('click', e => {
      if (cookIngOpen) return;
      if (e.target.closest('button, a')) return;
      const rect = cookStage.getBoundingClientRect();
      if ((e.clientX - rect.left) < rect.width * 0.34) prevStep(); else nextStep();
    });

    // -- Swipe --
    let touchX = null, touchY = null;
    cookStage.addEventListener('touchstart', e => { touchX = e.touches[0].clientX; touchY = e.touches[0].clientY; }, { passive: true });
    cookStage.addEventListener('touchend', e => {
      if (touchX === null || cookIngOpen) { touchX = null; return; }
      const dx = e.changedTouches[0].clientX - touchX;
      const dy = e.changedTouches[0].clientY - touchY;
      touchX = null;
      if (Math.abs(dx) < 55 || Math.abs(dx) < Math.abs(dy)) return;
      if (dx < 0) nextStep(); else prevStep();
    }, { passive: true });

    if (cookPrev) cookPrev.addEventListener('click', prevStep);
    if (cookNext) cookNext.addEventListener('click', nextStep);

    // -- Keyboard --
    document.addEventListener('keydown', e => {
      if (cookOverlay.classList.contains('hidden')) return;
      if (e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); nextStep(); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); prevStep(); }
    });

    // --- Shopping list ---
    const shoppingOverlay = document.getElementById('shopping-overlay');
    const shoppingModal = document.getElementById('shopping-modal');
    const shoppingItems = document.getElementById('shopping-items');
    const shoppingEmpty = document.getElementById('shopping-empty');
    const shoppingClear = document.getElementById('shopping-clear');
    const shoppingCount = document.getElementById('shopping-count');
    let shopList = JSON.parse(localStorage.getItem('shopping_list') || '[]');

    function saveShopList() {
      localStorage.setItem('shopping_list', JSON.stringify(shopList));
      updateShoppingBadge();
    }

    function updateShoppingBadge() {
      const remaining = shopList.filter(i => !i.done).length;
      shoppingCount.textContent = remaining;
      shoppingCount.classList.toggle('hidden', remaining === 0);
      const navBadge = document.getElementById('nav-shop-count');
      if (navBadge) {
        navBadge.textContent = remaining;
        navBadge.classList.toggle('hidden', remaining === 0);
      }
    }

    function renderShopList() {
      shoppingEmpty.classList.toggle('hidden', shopList.length > 0);
      shoppingClear.classList.toggle('hidden', shopList.length === 0);
      shoppingItems.innerHTML = shopList.map((item, i) => `
        <li class="flex items-center gap-3 group">
          <button class="shop-toggle w-[18px] h-[18px] shrink-0 rounded border ${item.done ? 'border-accent bg-accent' : 'border-border'} flex items-center justify-center transition-colors" data-i="${i}">
            ${item.done ? '<svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>' : ''}
          </button>
          <span class="flex-1 text-[14px] ${item.done ? 'line-through opacity-40' : ''} text-text">${item.text}</span>
          <button class="shop-remove opacity-0 group-hover:opacity-100 text-text-muted hover:text-red-400 transition-all" data-i="${i}">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </li>`).join('');
      shoppingItems.querySelectorAll('.shop-toggle').forEach(b =>
        b.addEventListener('click', () => { shopList[b.dataset.i].done = !shopList[b.dataset.i].done; saveShopList(); renderShopList(); })
      );
      shoppingItems.querySelectorAll('.shop-remove').forEach(b =>
        b.addEventListener('click', () => { shopList.splice(b.dataset.i, 1); saveShopList(); renderShopList(); })
      );
    }

    document.getElementById('shopping-btn').addEventListener('click', () => {
      renderShopList();
      shoppingOverlay.classList.remove('hidden');
      requestAnimationFrame(() => { shoppingOverlay.classList.remove('opacity-0'); shoppingModal.classList.remove('scale-95', 'opacity-0'); });
    });
    function closeShopping() {
      shoppingOverlay.classList.add('opacity-0');
      shoppingModal.classList.add('scale-95', 'opacity-0');
      setTimeout(() => shoppingOverlay.classList.add('hidden'), 200);
    }
    document.getElementById('shopping-close').addEventListener('click', closeShopping);
    shoppingOverlay.addEventListener('click', e => { if (e.target === shoppingOverlay) closeShopping(); });
    shoppingClear.addEventListener('click', () => { shopList = []; saveShopList(); renderShopList(); });

    document.getElementById('add-shop-btn').addEventListener('click', () => {
      const r = recipes.find(x => x.slug === currentSlug);
      if (!r) return;
      const base = r.servings || 4;
      const factor = currentServings / base;
      variantOf(r).ingredients.forEach(raw => {
        const text = scaleIngredient(raw, factor);
        if (!shopList.some(i => i.text === text)) shopList.push({ text, done: false });
      });
      saveShopList();
      const btn = document.getElementById('add-shop-btn');
      const orig = btn.textContent;
      btn.textContent = 'Přidáno ✓';
      setTimeout(() => { btn.textContent = orig; }, 1500);
    });

    updateShoppingBadge();

    // --- Bottom nav (mobile) ---
    document.getElementById('nav-all').addEventListener('click', () => {
      activeCategory = 'all'; updateFilters(); renderGrid();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    document.getElementById('nav-fav').addEventListener('click', () => {
      activeCategory = '__fav'; updateFilters(); renderGrid();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    document.getElementById('nav-chef').addEventListener('click', () => document.getElementById('chef-btn').click());
    document.getElementById('nav-shop').addEventListener('click', () => document.getElementById('shopping-btn').click());
    document.getElementById('nav-add').addEventListener('click', () => document.getElementById('add-btn').click());

    // --- Escape key ---
    document.addEventListener('keydown', e => {
      if (e.key !== 'Escape') return;
      if (!cookOverlay.classList.contains('hidden')) closeCookMode();
      else if (!shoppingOverlay.classList.contains('hidden')) closeShopping();
      else if (!settingsOverlay.classList.contains('hidden')) closeSettings();
      else if (!chefOverlay.classList.contains('hidden')) closeChef();
      else if (!editOverlay.classList.contains('hidden')) closeEditModal();
      else if (!overlay.classList.contains('hidden')) closeDetailModal();
    });


    // --- Rating & notes ---
    function getReview(slug) {
      return JSON.parse(localStorage.getItem('review_' + slug) || 'null') || { stars: 0, note: '', cooked: 0, lastCooked: null };
    }
    function saveReview(slug, review) {
      localStorage.setItem('review_' + slug, JSON.stringify(review));
    }
    function getUserRating(slug) {
      return getReview(slug).stars || 0;
    }

    function renderStars(slug) {
      const review = getReview(slug);
      const stars = review.stars || 0;
      const row = document.getElementById('star-row');
      if (!row) return;
      row.querySelectorAll('.star-btn').forEach(btn => {
        const n = parseInt(btn.dataset.star);
        btn.textContent = n <= stars ? '★' : '☆';
        btn.style.color = n <= stars ? 'var(--color-accent)' : 'var(--color-text-muted)';
      });
      const stats = document.getElementById('cook-stats');
      if (stats) {
        const parts = [];
        if (review.cooked) parts.push('Uvařeno ' + review.cooked + '×');
        if (review.lastCooked) {
          const d = new Date(review.lastCooked);
          parts.push('naposledy ' + d.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' }));
        }
        stats.textContent = parts.join(', ');
      }
      const noteEl = document.getElementById('personal-note');
      if (noteEl) noteEl.value = review.note || '';
    }

    function bindRatingEvents(slug) {
      const row = document.getElementById('star-row');
      if (!row) return;

      row.querySelectorAll('.star-btn').forEach(btn => {
        btn.addEventListener('mouseenter', () => {
          const n = parseInt(btn.dataset.star);
          row.querySelectorAll('.star-btn').forEach(b => {
            const bn = parseInt(b.dataset.star);
            b.textContent = bn <= n ? '★' : '☆';
            b.style.color = bn <= n ? 'var(--color-accent)' : 'var(--color-text-muted)';
          });
        });
        btn.addEventListener('mouseleave', () => renderStars(slug));
        btn.addEventListener('click', () => {
          const review = getReview(slug);
          const n = parseInt(btn.dataset.star);
          review.stars = review.stars === n ? 0 : n;
          saveReview(slug, review);
          renderStars(slug);
          renderGrid();
        });
      });

      document.getElementById('cooked-btn').addEventListener('click', () => {
        const review = getReview(slug);
        review.cooked = (review.cooked || 0) + 1;
        review.lastCooked = new Date().toISOString();
        saveReview(slug, review);
        renderStars(slug);
        const btn = document.getElementById('cooked-btn');
        const orig = btn.innerHTML;
        btn.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg> Zaznamenáno!';
        btn.style.color = 'var(--color-accent)';
        setTimeout(() => { btn.innerHTML = orig; btn.style.color = ''; }, 2000);
      });

      document.getElementById('save-note-btn').addEventListener('click', () => {
        const review = getReview(slug);
        review.note = document.getElementById('personal-note').value;
        saveReview(slug, review);
        const saved = document.getElementById('note-saved');
        saved.classList.remove('hidden');
        setTimeout(() => saved.classList.add('hidden'), 2000);
      });
    }

    // --- Init ---
    updateFilters();
    renderGrid();

    // --- Nutrition modal ---
    const nutritionOverlay = document.getElementById('nutrition-overlay');
    const nutritionModal = document.getElementById('nutrition-modal');

    const NUTR_MAX = { protein: 80, carbs: 120, sugar: 60, fat: 60, fiber: 15, sodium: 2000, calcium: 400, iron: 10, vitamin_c: 60 };

    function setNutrBar(id, value, max) {
      const el = document.getElementById(id);
      if (el) el.style.width = Math.min(Math.round((value / max) * 100), 100) + '%';
    }

    function openNutrition() {
      const r = recipes.find(x => x.slug === currentSlug);
      const noData = document.getElementById('nutrition-no-data');
      const content = document.getElementById('nutrition-content');
      const label = document.getElementById('nutrition-serving-label');

      if (!r || !r.nutrition) {
        noData.classList.remove('hidden');
        content.classList.add('hidden');
        label.textContent = '';
      } else {
        const n = r.nutrition;
        noData.classList.add('hidden');
        content.classList.remove('hidden');
        label.textContent = 'na 1 porci (' + (n.serving_g || '?') + ' g)';
        document.getElementById('nutr-calories').textContent = n.calories ?? '—';
        document.getElementById('nutr-protein').textContent = n.protein ?? '—';
        document.getElementById('nutr-carbs').textContent = n.carbs ?? '—';
        document.getElementById('nutr-sugar').textContent = n.sugar ?? '—';
        document.getElementById('nutr-fat').textContent = n.fat ?? '—';
        document.getElementById('nutr-fiber').textContent = n.fiber ?? '—';
        document.getElementById('nutr-sodium').textContent = n.sodium ?? '—';
        document.getElementById('nutr-calcium').textContent = n.calcium ?? '—';
        document.getElementById('nutr-iron').textContent = n.iron ?? '—';
        document.getElementById('nutr-vitc').textContent = n.vitamin_c ?? '—';
        setNutrBar('nutr-bar-protein', n.protein, NUTR_MAX.protein);
        setNutrBar('nutr-bar-carbs', n.carbs, NUTR_MAX.carbs);
        setNutrBar('nutr-bar-sugar', n.sugar, NUTR_MAX.sugar);
        setNutrBar('nutr-bar-fat', n.fat, NUTR_MAX.fat);
        setNutrBar('nutr-bar-fiber', n.fiber, NUTR_MAX.fiber);
        setNutrBar('nutr-bar-sodium', n.sodium, NUTR_MAX.sodium);
        setNutrBar('nutr-bar-calcium', n.calcium, NUTR_MAX.calcium);
        setNutrBar('nutr-bar-iron', n.iron * 10, NUTR_MAX.iron * 10);
        setNutrBar('nutr-bar-vitc', n.vitamin_c, NUTR_MAX.vitamin_c);
      }

      nutritionOverlay.classList.remove('hidden');
      requestAnimationFrame(() => {
        nutritionOverlay.classList.remove('opacity-0');
        nutritionModal.classList.remove('scale-95', 'opacity-0');
      });
    }

    function closeNutrition() {
      nutritionOverlay.classList.add('opacity-0');
      nutritionModal.classList.add('scale-95', 'opacity-0');
      setTimeout(() => nutritionOverlay.classList.add('hidden'), 200);
    }

    document.getElementById('nutrition-btn').addEventListener('click', openNutrition);
    document.getElementById('nutrition-close').addEventListener('click', closeNutrition);
    nutritionOverlay.addEventListener('click', e => { if (e.target === nutritionOverlay) closeNutrition(); });

    }); // DOMContentLoaded
  </script>

  <!-- Nutrition modal -->
  <div id="nutrition-overlay" class="fixed inset-0 bg-black/70 z-[70] hidden opacity-0 transition-opacity duration-200">
    <div class="fixed inset-0 flex items-center justify-center p-6">
