      const ne = document.getElementById('push-ne');
      if (!ano || !ne) return;

      ano.addEventListener('click', async () => {
        ano.disabled = true;
        try { await prihlasPush(); } catch (e) { /* odmitnuti neni chyba */ }
        ano.disabled = false;
        schovejNabidkuOznameni();
      });

      ne.addEventListener('click', () => {
        Store.setPushOdmitnuto(true);
        schovejNabidkuOznameni();
      });
    })();


