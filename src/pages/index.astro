            <span class="text-[13px] text-text-muted self-end mb-1">kcal</span>
          </div>
          <!-- Macros -->
          <div class="text-[11px] font-semibold text-text-muted uppercase tracking-wider mb-2">Makronutrienty</div>
          <div class="rounded-xl border border-border overflow-hidden mb-4">
            <div class="nutr-row border-b border-border">
              <span class="nutr-label">Bílkoviny</span>
              <div class="nutr-bar-wrap"><div class="nutr-bar bg-blue-400" id="nutr-bar-protein"></div></div>
              <span class="nutr-val" id="nutr-protein">—</span>
              <span class="nutr-unit">g</span>
            </div>
            <div class="nutr-row border-b border-border">
              <span class="nutr-label">Sacharidy</span>
              <div class="nutr-bar-wrap"><div class="nutr-bar bg-amber-400" id="nutr-bar-carbs"></div></div>
              <span class="nutr-val" id="nutr-carbs">—</span>
              <span class="nutr-unit">g</span>
            </div>
            <div class="nutr-row border-b border-border">
              <span class="nutr-label text-text-muted/70 pl-6 text-[12px]">z toho cukry</span>
              <div class="nutr-bar-wrap"><div class="nutr-bar bg-amber-300/60" id="nutr-bar-sugar"></div></div>
              <span class="nutr-val text-text-muted" id="nutr-sugar">—</span>
              <span class="nutr-unit text-text-muted">g</span>
            </div>
            <div class="nutr-row border-b border-border">
              <span class="nutr-label">Tuky</span>
              <div class="nutr-bar-wrap"><div class="nutr-bar bg-rose-400" id="nutr-bar-fat"></div></div>
              <span class="nutr-val" id="nutr-fat">—</span>
              <span class="nutr-unit">g</span>
            </div>
            <div class="nutr-row">
              <span class="nutr-label">Vláknina</span>
              <div class="nutr-bar-wrap"><div class="nutr-bar bg-green-400" id="nutr-bar-fiber"></div></div>
              <span class="nutr-val" id="nutr-fiber">—</span>
              <span class="nutr-unit">g</span>
            </div>
          </div>
          <!-- Micros -->
          <div class="text-[11px] font-semibold text-text-muted uppercase tracking-wider mb-2">Mikronutrienty</div>
          <div class="rounded-xl border border-border overflow-hidden">
            <div class="nutr-row border-b border-border">
              <span class="nutr-label">Sodík</span>
              <div class="nutr-bar-wrap"><div class="nutr-bar bg-purple-400" id="nutr-bar-sodium"></div></div>
              <span class="nutr-val" id="nutr-sodium">—</span>
              <span class="nutr-unit">mg</span>
            </div>
            <div class="nutr-row border-b border-border">
              <span class="nutr-label">Vápník</span>
              <div class="nutr-bar-wrap"><div class="nutr-bar bg-cyan-400" id="nutr-bar-calcium"></div></div>
              <span class="nutr-val" id="nutr-calcium">—</span>
              <span class="nutr-unit">mg</span>
            </div>
            <div class="nutr-row border-b border-border">
              <span class="nutr-label">Železo</span>
              <div class="nutr-bar-wrap"><div class="nutr-bar bg-orange-400" id="nutr-bar-iron"></div></div>
              <span class="nutr-val" id="nutr-iron">—</span>
              <span class="nutr-unit">mg</span>
            </div>
            <div class="nutr-row">
              <span class="nutr-label">Vitamín C</span>
              <div class="nutr-bar-wrap"><div class="nutr-bar bg-yellow-400" id="nutr-bar-vitc"></div></div>
              <span class="nutr-val" id="nutr-vitc">—</span>
              <span class="nutr-unit">mg</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

