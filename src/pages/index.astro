  <script define:vars={{ recipesData }}>
    document.addEventListener("DOMContentLoaded", function() {
    const REPO = 'vorlis08/masterchef-vorlis';
    const FILE_PATH = 'src/data/recipes.json';

    let recipes = JSON.parse(JSON.stringify(recipesData));
    let originalJson = JSON.stringify(recipesData);
    let dirty = false;
    let currentSlug = null;

    // --- DOM refs ---
    const grid = document.getElementById('recipe-grid');
    const noResults = document.getElementById('no-results');
    const searchInput = document.getElementById('search');
    const unsavedBadge = document.getElementById('unsaved-badge');
    const saveBtn = document.getElementById('save-btn');
    let activeCategory = 'all';
    let favorites = JSON.parse(localStorage.getItem('favorites') || '[]');

    function toggleFavorite(slug) {
      const i = favorites.indexOf(slug);
      if (i >= 0) favorites.splice(i, 1);
      else favorites.push(slug);
      localStorage.setItem('favorites', JSON.stringify(favorites));
      renderGrid();
    }

    // --- Scroll reveal ---
    let revealObserver = null;
    function revealCards() {
      const items = grid.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) {
        items.forEach(el => el.classList.add('in'));
        return;
      }
      if (!revealObserver) {
        revealObserver = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            const el = entry.target;
            const delay = Math.min(parseInt(el.dataset.i || '0', 10), 5) * 70;
            setTimeout(() => el.classList.add('in'), delay);
            obs.unobserve(el);
          });
        }, { rootMargin: '0px 0px -40px 0px', threshold: 0.05 });
      }
      items.forEach((el, i) => { el.dataset.i = i % 6; revealObserver.observe(el); });
    }

    // --- Dnešní volba: one dish, chosen by the date, no browsing required ---
    function renderHero() {
      const hero = document.getElementById('hero');
      if (!hero) return;
      const browsing = activeCategory !== 'all' || searchInput.value.trim() !== '';
      if (browsing || recipes.length === 0) {
        hero.classList.add('hidden');
        hero.innerHTML = '';
        return;
      }
      const now = new Date();
      const dayIndex = Math.floor((now - new Date(now.getFullYear(), 0, 0)) / 86400000);
      const r = recipes[dayIndex % recipes.length];
      if (hero.dataset.slug === r.slug && !hero.classList.contains('hidden')) return;
      hero.dataset.slug = r.slug;
      hero.classList.remove('hidden');
      hero.innerHTML = `
        <div class="rise mb-12 sm:mb-16 grid sm:grid-cols-[1.05fr_1fr] gap-5 sm:gap-9 items-center">
          <div class="card-media !aspect-[16/11] sm:!aspect-[4/3] order-1 sm:order-2">
            ${r.image
              ? `<img src="${r.image}" alt="${r.title}" />`
              : `<div class="w-full h-full flex items-center justify-center"><span class="display text-[64px] text-border">${(r.title || '?').charAt(0)}</span></div>`}
          </div>
          <div class="order-2 sm:order-1">
            <div class="label text-accent mb-3">Dnešní volba</div>
            <h2 class="display text-[30px] sm:text-[42px] text-text mb-3">${r.title}</h2>
            <p class="text-text-muted text-[14.5px] sm:text-[15px] leading-relaxed mb-5 max-w-[46ch]">${r.description || 'Otevři recept a uvidíš.'}</p>
            <div class="meta text-text-muted flex items-center gap-2.5 mb-6">
              ${r.time ? `<span>${r.time}</span><span class="opacity-40">/</span>` : ''}
              <span>${r.difficulty || 'Snadné'}</span><span class="opacity-40">/</span>
              <span>${r.servings || '?'} porcí</span>
            </div>
            <div class="flex gap-2.5">
              <button id="hero-open" class="px-5 py-3 rounded-xl bg-accent text-white text-[14px] font-medium hover:bg-accent-hover active:scale-[0.98] transition-all">Otevřít recept</button>
              <button id="hero-cook" class="px-5 py-3 rounded-xl border border-border text-text text-[14px] font-medium hover:border-accent hover:text-accent active:scale-[0.98] transition-all">Vařit hned</button>
            </div>
          </div>
        </div>`;
      document.getElementById('hero-open').addEventListener('click', () => openDetailModal(r.slug));
      document.getElementById('hero-cook').addEventListener('click', () => {
        openDetailModal(r.slug);
        setTimeout(() => document.getElementById('cook-mode-btn').click(), 340);
      });
    }

    // --- View mode ------------------------------------------------------
    let viewMode = localStorage.getItem('viewMode') || 'menu';

    function cardMarkup(r, isFav) {
      return `
          <article class="recipe-card reveal relative text-left cursor-pointer" data-slug="${r.slug}">
            <button class="fav-btn absolute top-2.5 right-2.5 z-10 w-9 h-9 rounded-full bg-black/45 backdrop-blur-sm flex items-center justify-center transition-colors ${isFav ? 'text-red-400' : 'text-white/70 hover:text-white'}" data-fav="${r.slug}" aria-label="Přidat do oblíbených">
              <svg class="w-[18px] h-[18px]" fill="${isFav ? 'currentColor' : 'none'}" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>
            </button>
            <div class="card-media mb-3">
              ${r.image
                ? `<img src="${r.image}" alt="${r.title}" loading="lazy" />`
                : `<div class="w-full h-full flex items-center justify-center"><span class="display text-[34px] text-border">${(r.title || '?').charAt(0)}</span></div>`}
            </div>
            ${r.category ? `<div class="label text-accent mb-1.5">${r.category}</div>` : ''}
            <h3 class="display text-[16px] sm:text-[19px] text-text mb-2">${r.title}</h3>
            <div class="card-rule mb-2"></div>
            <div class="meta text-text-muted flex items-center gap-2">
              ${r.time ? `<span>${r.time}</span><span class="opacity-40">/</span>` : ''}
              <span>${r.servings || '?'} porcí</span>
            </div>
          </article>`;
    }

    function rowMarkup(r, isFav, n) {
      const num = String(n).padStart(2, '0');
      return `
          <div class="menu-row reveal" data-slug="${r.slug}" data-img="${r.image || ''}">
            <span class="menu-num">${num}</span>
            <span class="menu-title">${r.title}${isFav ? ' <span class="text-accent align-middle" style="font-size:0.42em">♥</span>' : ''}</span>
            <span class="menu-time hidden sm:inline">${r.time || ''}</span>
            ${r.image ? `<img class="menu-thumb sm:hidden" src="${r.image}" alt="" loading="lazy" style="grid-row:1/span 2;grid-column:3" />` : ''}
            <span class="menu-sub">${[r.category, r.difficulty, (r.servings || '?') + ' porcí'].filter(Boolean).join(' · ')}</span>
          </div>`;
    }

    // --- Render grid ---
    function renderGrid() {
      const query = searchInput.value.toLowerCase();
      let html = '';
      let visible = 0;
      recipes.forEach(r => {
        const isFav = favorites.includes(r.slug);
        const matchCat = activeCategory === 'all'
          || (activeCategory === '__fav' && isFav)
          || r.category === activeCategory;
        const haystack = (r.title + ' ' + (r.tags || []).join(' ') + ' ' + (r.ingredients || []).join(' ')).toLowerCase();
        const matchSearch = !query || haystack.includes(query);
        if (!matchCat || !matchSearch) return;
        visible++;
        html += viewMode === 'grid' ? cardMarkup(r, isFav) : rowMarkup(r, isFav, visible);
      });

      grid.className = viewMode === 'grid'
        ? 'grid grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-8 sm:gap-x-6 sm:gap-y-10'
        : 'block';
      grid.innerHTML = html;
      noResults.classList.toggle('hidden', visible > 0);

      const gh = document.getElementById('grid-heading');
      const gc = document.getElementById('grid-count');
      const gt = document.getElementById('grid-title');
      if (gh) {
        gh.classList.toggle('hidden', visible === 0);
        if (visible > 0) gh.classList.add('flex');
      }
      if (gt) gt.textContent = activeCategory === '__fav' ? 'Oblíbené' : (activeCategory === 'all' ? 'Rejstřík' : activeCategory);
      if (gc) gc.textContent = visible === 1 ? '1 recept' : (visible < 5 ? visible + ' recepty' : visible + ' receptů');

      grid.querySelectorAll('.recipe-card, .menu-row').forEach(c =>
        c.addEventListener('click', () => openDetailModal(c.dataset.slug))
      );
      grid.querySelectorAll('.fav-btn').forEach(b =>
        b.addEventListener('click', e => { e.stopPropagation(); toggleFavorite(b.dataset.fav); })
      );

      bindHoverPreview();
      revealCards();
      renderHero();
    }

    // --- Cursor-following dish preview (pointer devices only) ------------
    const preview = document.getElementById('hover-preview');
    const previewImg = preview ? preview.querySelector('img') : null;
    let px = 0, py = 0, tx = 0, ty = 0, previewRaf = null;

    function previewLoop() {
      px += (tx - px) * 0.14;
      py += (ty - py) * 0.14;
      preview.style.translate = px + 'px ' + py + 'px';
      previewRaf = requestAnimationFrame(previewLoop);
    }

    function bindHoverPreview() {
      if (!preview || !window.matchMedia('(hover: hover)').matches) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      grid.querySelectorAll('.menu-row').forEach(row => {
        row.addEventListener('mouseenter', () => {
          const src = row.dataset.img;
          if (!src) return;
          previewImg.src = src;
          preview.classList.add('on');
          if (!previewRaf) previewLoop();
        });
        row.addEventListener('mouseleave', () => {
          preview.classList.remove('on');
        });
      });
    }

    document.addEventListener('mousemove', e => {
      tx = e.clientX + 150;
      ty = e.clientY;
      if (tx > window.innerWidth - 130) tx = e.clientX - 150;
    });

    // --- View toggle -----------------------------------------------------
    const viewToggle = document.getElementById('view-toggle');
    if (viewToggle) {
      viewToggle.querySelectorAll('button').forEach(b => {
        b.classList.toggle('on', b.dataset.view === viewMode);
        b.addEventListener('click', () => {
          viewMode = b.dataset.view;
          localStorage.setItem('viewMode', viewMode);
          viewToggle.querySelectorAll('button').forEach(x => x.classList.toggle('on', x.dataset.view === viewMode));
          preview.classList.remove('on');
          renderGrid();
        });
      });
    }

    function updateDirty() {
      dirty = JSON.stringify(recipes) !== originalJson;
      unsavedBadge.classList.toggle('hidden', !dirty);
      saveBtn.classList.toggle('hidden', !dirty);
    }

    function slugify(text) {
      return text.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    }

    // --- Filters ---
    function updateFilters() {
      const bar = document.getElementById('filter-bar');
      const cats = [...new Set(recipes.map(r => r.category).filter(Boolean))];
      bar.innerHTML = `<button class="filter-btn pill ${activeCategory === 'all' ? 'is-active' : ''}" data-category="all">Vše</button>`;
      bar.innerHTML += `<button class="filter-btn pill ${activeCategory === '__fav' ? 'is-active' : ''}" data-category="__fav">♥ Oblíbené</button>`;
      cats.forEach(cat => {
        bar.innerHTML += `<button class="filter-btn pill ${activeCategory === cat ? 'is-active' : ''}" data-category="${cat}">${cat}</button>`;
      });
      bar.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          activeCategory = btn.dataset.category;
          updateFilters();
          renderGrid();
        });
      });
      const navAll = document.getElementById('nav-all');
      const navFav = document.getElementById('nav-fav');
      if (navAll) navAll.classList.toggle('text-accent', activeCategory !== '__fav');
      if (navFav) navFav.classList.toggle('text-accent', activeCategory === '__fav');
    }

    searchInput.addEventListener('input', renderGrid);

    // --- Detail modal ---
    const overlay = document.getElementById('modal-overlay');
    const modal = document.getElementById('modal');

    let currentServings = 4;

    function formatNum(n) {
      const rounded = Math.round(n * 100) / 100;
      return String(rounded).replace('.', ',');
    }

    function scaleIngredient(text, factor) {
      if (factor === 1) return text;
      return text.replace(/(\d+(?:[.,]\d+)?)(\s*[–-]\s*)(\d+(?:[.,]\d+)?)|(\d+(?:[.,]\d+)?)/g, (m, a, dash, b, single) => {
        if (a !== undefined) {
          const na = parseFloat(a.replace(',', '.')) * factor;
          const nb = parseFloat(b.replace(',', '.')) * factor;
          return formatNum(na) + dash + formatNum(nb);
        }
        return formatNum(parseFloat(single.replace(',', '.')) * factor);
      });
    }

    function renderIngredients(r) {
      const base = r.servings || 4;
      const factor = currentServings / base;
      document.getElementById('portion-value').textContent =
        currentServings + ' ' + (currentServings === 1 ? 'porce' : currentServings < 5 ? 'porce' : 'porcí');
      const ingList = document.getElementById('modal-ingredients');
      ingList.innerHTML = (r.ingredients || []).map(raw => {
        const ing = scaleIngredient(raw, factor);
        return `<li class="flex items-start gap-3 cursor-pointer group ingredient-item">
          <span class="mt-[3px] w-[18px] h-[18px] shrink-0 rounded border border-border group-hover:border-accent flex items-center justify-center transition-colors checkbox">
            <svg class="w-3 h-3 text-accent opacity-0 check-icon transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
          </span>
          <span class="text-[15px] text-text-muted group-hover:text-text transition-colors ing-text">${ing}</span>
        </li>`;
      }).join('');
      ingList.querySelectorAll('.ingredient-item').forEach(item => {
        item.addEventListener('click', () => {
          const ck = item.querySelector('.check-icon');
          const txt = item.querySelector('.ing-text');
          const on = ck.style.opacity === '1';
          ck.style.opacity = on ? '0' : '1';
          item.querySelector('.checkbox').classList.toggle('border-accent', !on);
          txt.classList.toggle('line-through', !on);
          txt.classList.toggle('opacity-40', !on);
        });
      });
    }

    document.getElementById('portion-minus').addEventListener('click', () => {
      if (currentServings <= 1) return;
      currentServings--;
      const r = recipes.find(x => x.slug === currentSlug);
      if (r) renderIngredients(r);
    });
    document.getElementById('portion-plus').addEventListener('click', () => {
      if (currentServings >= 20) return;
      currentServings++;
      const r = recipes.find(x => x.slug === currentSlug);
      if (r) renderIngredients(r);
    });

    function openDetailModal(slug) {
      const r = recipes.find(x => x.slug === slug);
      if (!r) return;
      currentSlug = slug;
      currentServings = r.servings || 4;
      document.getElementById('modal-image').src = r.image || '';
      document.getElementById('modal-title').textContent = r.title;
      document.getElementById('modal-description').textContent = r.description || '';
      document.getElementById('modal-meta').innerHTML =
        `${r.time ? `<span>${r.time}</span><span class="opacity-40">/</span>` : ''}` +
        `<span>${r.difficulty || ''}</span><span class="opacity-40">/</span><span>${r.servings || '?'} porcí</span>`;

      renderIngredients(r);

      document.getElementById('modal-steps').innerHTML = (r.steps || []).map((s, i) =>
        `<li class="flex gap-4 sm:gap-5"><span class="display shrink-0 w-8 text-[22px] leading-none text-accent/70 pt-0.5 text-right">${i+1}</span><p class="text-[15px] text-text-muted leading-[1.7]">${s}</p></li>`
      ).join('');

      const tipEl = document.getElementById('modal-tip');
      if (r.tip) { tipEl.classList.remove('hidden'); document.getElementById('modal-tip-text').textContent = r.tip; }
      else { tipEl.classList.add('hidden'); }

      overlay.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => { overlay.classList.remove('opacity-0'); modal.classList.remove('translate-x-full'); });
    }

    function closeDetailModal() {
      overlay.classList.add('opacity-0');
      modal.classList.add('translate-x-full');
      setTimeout(() => { overlay.classList.add('hidden'); document.body.style.overflow = ''; modal.scrollTop = 0; }, 300);
    }
    document.getElementById('modal-close').addEventListener('click', closeDetailModal);
    overlay.addEventListener('click', e => { if (e.target === overlay) closeDetailModal(); });

    // --- Edit modal ---
    const editOverlay = document.getElementById('edit-overlay');
    const editModal = document.getElementById('edit-modal');
    const editForm = document.getElementById('edit-form');

    function openEditModal(recipe) {
      document.getElementById('edit-heading').textContent = recipe ? 'Upravit recept' : 'Nový recept';
      const f = editForm;
      f.title.value = recipe?.title || '';
      f.description.value = recipe?.description || '';
      f.image.value = recipe?.image || '';
      f.time.value = recipe?.time || '';
      f.servings.value = recipe?.servings || '';
      f.difficulty.value = recipe?.difficulty || 'Snadné';
      f.category.value = recipe?.category || '';
      f.tags.value = (recipe?.tags || []).join(', ');
      f.ingredients.value = (recipe?.ingredients || []).join('\n');
      f.steps.value = (recipe?.steps || []).join('\n');
      f.tip.value = recipe?.tip || '';
      f.slug.value = recipe?.slug || '';

      editOverlay.classList.remove('hidden');
      requestAnimationFrame(() => { editOverlay.classList.remove('opacity-0'); editModal.classList.remove('translate-x-full'); });
    }

    function closeEditModal() {
      editOverlay.classList.add('opacity-0');
      editModal.classList.add('translate-x-full');
      setTimeout(() => { editOverlay.classList.add('hidden'); editModal.scrollTop = 0; }, 300);
    }
    document.getElementById('edit-close').addEventListener('click', closeEditModal);
    editOverlay.addEventListener('click', e => { if (e.target === editOverlay) closeEditModal(); });

    editForm.addEventListener('submit', e => {
      e.preventDefault();
      const f = editForm;
      const existingSlug = f.slug.value;
      const newRecipe = {
        slug: existingSlug || slugify(f.title.value),
        title: f.title.value,
        description: f.description.value,
        image: f.image.value,
        time: f.time.value,
        servings: parseInt(f.servings.value) || 4,
        difficulty: f.difficulty.value,
        category: f.category.value,
        tags: f.tags.value.split(',').map(t => t.trim()).filter(Boolean),
        ingredients: f.ingredients.value.split('\n').map(s => s.trim()).filter(Boolean),
        steps: f.steps.value.split('\n').map(s => s.trim()).filter(Boolean),
        tip: f.tip.value || undefined,
      };

      if (existingSlug) {
        const idx = recipes.findIndex(r => r.slug === existingSlug);
        if (idx >= 0) recipes[idx] = newRecipe;
      } else {
        recipes.push(newRecipe);
      }

      updateDirty();
      updateFilters();
      renderGrid();
      closeEditModal();
      closeDetailModal();
    });

    // --- Buttons ---
    document.getElementById('add-btn').addEventListener('click', () => openEditModal(null));
    document.getElementById('modal-edit').addEventListener('click', () => {
      const r = recipes.find(x => x.slug === currentSlug);
      if (r) openEditModal(r);
    });
    document.getElementById('modal-delete').addEventListener('click', () => {
      if (!confirm('Opravdu smazat tento recept?')) return;
      recipes = recipes.filter(r => r.slug !== currentSlug);
      updateDirty();
      updateFilters();
      renderGrid();
      closeDetailModal();
    });

    // --- Settings ---
    const settingsOverlay = document.getElementById('settings-overlay');
    const settingsModal = document.getElementById('settings-modal');
    const tokenInput = document.getElementById('token-input');
    const tokenStatus = document.getElementById('token-status');

    function highlightActiveTheme() {
      const current = localStorage.getItem('theme') || '';
      document.querySelectorAll('.theme-swatch').forEach(btn => {
        const ring = btn.querySelector('div');
        const isActive = btn.dataset.theme === current;
        ring.classList.toggle('ring-2', isActive);
        ring.classList.toggle('ring-accent', isActive);
      });
    }

    document.querySelectorAll('.theme-swatch').forEach(btn => {
      btn.addEventListener('click', () => {
        const theme = btn.dataset.theme;
        if (theme) {
          localStorage.setItem('theme', theme);
          document.documentElement.setAttribute('data-theme', theme);
        } else {
          localStorage.removeItem('theme');
          document.documentElement.removeAttribute('data-theme');
        }
        highlightActiveTheme();
      });
    });

    document.getElementById('settings-btn').addEventListener('click', () => {
      tokenInput.value = localStorage.getItem('gh_token') || '';
      tokenStatus.classList.add('hidden');
      highlightActiveTheme();
      settingsOverlay.classList.remove('hidden');
      requestAnimationFrame(() => { settingsOverlay.classList.remove('opacity-0'); settingsModal.classList.remove('scale-95', 'opacity-0'); });
    });
    function closeSettings() {
      settingsOverlay.classList.add('opacity-0');
      settingsModal.classList.add('scale-95', 'opacity-0');
      setTimeout(() => settingsOverlay.classList.add('hidden'), 200);
    }
    document.getElementById('settings-close').addEventListener('click', closeSettings);
    settingsOverlay.addEventListener('click', e => { if (e.target === settingsOverlay) closeSettings(); });

    document.getElementById('token-save').addEventListener('click', () => {
      const token = tokenInput.value.trim();
      if (!token) { tokenStatus.textContent = 'Zadej token.'; tokenStatus.className = 'mt-3 text-[13px] text-red-400'; tokenStatus.classList.remove('hidden'); return; }
      localStorage.setItem('gh_token', token);
      tokenStatus.textContent = 'Token uložen.';
      tokenStatus.className = 'mt-3 text-[13px] text-green-400';
      tokenStatus.classList.remove('hidden');
      setTimeout(() => tokenStatus.classList.add('hidden'), 2000);
    });

    // --- Save to GitHub ---
    const savingOverlay = document.getElementById('saving-overlay');
    const savingText = document.getElementById('saving-text');

    saveBtn.addEventListener('click', async () => {
      const token = localStorage.getItem('gh_token');
      if (!token) { document.getElementById('settings-btn').click(); return; }

      savingOverlay.classList.remove('hidden');
      savingOverlay.classList.add('flex');
      savingText.textContent = 'Ukládám na GitHub...';

      try {
        const getRes = await fetch(`https://api.github.com/repos/${REPO}/contents/${FILE_PATH}`, {
          headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github.v3+json' }
        });
        if (!getRes.ok) throw new Error('Nepodařilo se načíst soubor z GitHubu. Zkontroluj token.');
        const fileData = await getRes.json();

        const content = btoa(unescape(encodeURIComponent(JSON.stringify(recipes, null, 2) + '\n')));

        const putRes = await fetch(`https://api.github.com/repos/${REPO}/contents/${FILE_PATH}`, {
          method: 'PUT',
          headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github.v3+json', 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: 'update recipes',
            content: content,
            sha: fileData.sha,
          })
        });
        if (!putRes.ok) { const err = await putRes.json(); throw new Error(err.message || 'Push selhal.'); }

        originalJson = JSON.stringify(recipes);
        updateDirty();
        savingText.textContent = 'Uloženo! Web se přestaví za ~30s.';
        setTimeout(() => { savingOverlay.classList.add('hidden'); savingOverlay.classList.remove('flex'); }, 2000);
      } catch (err) {
        savingText.textContent = 'Chyba: ' + err.message;
        setTimeout(() => { savingOverlay.classList.add('hidden'); savingOverlay.classList.remove('flex'); }, 3000);
      }
    });

    // --- Chef AI ---
    const chefOverlay = document.getElementById('chef-overlay');
    const chefModal = document.getElementById('chef-modal');
    const chefInput = document.getElementById('chef-input');
    const chefResults = document.getElementById('chef-results');
    const chefMatches = document.getElementById('chef-matches');
    const chefAiResult = document.getElementById('chef-ai-result');
    const chefAiText = document.getElementById('chef-ai-text');
    const chefLoading = document.getElementById('chef-loading');

    document.getElementById('chef-btn').addEventListener('click', () => {
      chefOverlay.classList.remove('hidden');
      requestAnimationFrame(() => { chefOverlay.classList.remove('opacity-0'); chefModal.classList.remove('translate-x-full'); });
      chefInput.focus();
    });

    function closeChef() {
      chefOverlay.classList.add('opacity-0');
      chefModal.classList.add('translate-x-full');
      setTimeout(() => chefOverlay.classList.add('hidden'), 300);
    }
    document.getElementById('chef-close').addEventListener('click', closeChef);
    chefOverlay.addEventListener('click', e => { if (e.target === chefOverlay) closeChef(); });

    function parseIngredients(text) {
      return text.toLowerCase().split(/[,;\n]+/).map(s => s.trim()).filter(Boolean);
    }

    function normalizeWord(w) {
      return w.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    }

    function ingredientMatch(userIngredients, recipeIngredient) {
      const ri = normalizeWord(recipeIngredient);
      return userIngredients.some(ui => {
        const nu = normalizeWord(ui);
        return ri.includes(nu) || nu.includes(ri);
      });
    }

    document.getElementById('chef-search').addEventListener('click', () => {
      const userIngs = parseIngredients(chefInput.value);
      if (userIngs.length === 0) return;

      const scored = recipes.map(r => {
        const total = (r.ingredients || []).length;
        if (total === 0) return null;
        const matched = (r.ingredients || []).filter(ing => ingredientMatch(userIngs, ing)).length;
        return { recipe: r, matched, total, pct: Math.round((matched / total) * 100) };
      }).filter(s => s && s.matched > 0).sort((a, b) => b.pct - a.pct || b.matched - a.matched);

      if (scored.length === 0) {
        chefMatches.innerHTML = '<p class="text-text-muted text-[14px]">Žádný recept neodpovídá tvým ingrediencím.</p>';
      } else {
        chefMatches.innerHTML = scored.map(s => `
          <button class="chef-match w-full text-left p-4 rounded-xl bg-surface border border-border hover:border-accent transition-colors" data-slug="${s.recipe.slug}">
            <div class="flex items-center justify-between mb-1">
              <span class="text-[15px] font-medium text-text">${s.recipe.title}</span>
              <span class="text-[13px] font-semibold ${s.pct >= 75 ? 'text-green-400' : s.pct >= 40 ? 'text-amber-400' : 'text-red-400'}">${s.pct}%</span>
            </div>
            <div class="text-[13px] text-text-muted">${s.matched} z ${s.total} ingrediencí • ${s.recipe.time || '?'} • ${s.recipe.difficulty || 'Snadné'}</div>
          </button>
        `).join('');
        chefMatches.querySelectorAll('.chef-match').forEach(btn => {
          btn.addEventListener('click', () => { closeChef(); setTimeout(() => openDetailModal(btn.dataset.slug), 350); });
        });
      }
      chefResults.classList.remove('hidden');
      chefAiResult.classList.add('hidden');
    });

    document.getElementById('chef-ai').addEventListener('click', async () => {
      const userIngs = parseIngredients(chefInput.value);
      if (userIngs.length === 0) return;

      chefLoading.classList.remove('hidden');
      chefAiResult.classList.add('hidden');

      const recipeList = recipes.map(r =>
        `- ${r.title} (ingredience: ${(r.ingredients || []).join(', ')})`
      ).join('\n');

      const prompt = `Jsi drzý, vtipný a přímočarý kuchařský asistent. Vždy tykáš, jsi neformální, občas sarkastický, ale vždy užitečný. Žádné nudné formality.

Uživatel má tyto ingredience: ${userIngs.join(', ')}

Tady jsou jeho recepty:
${recipeList}

Doporuč nejlepší recept(y) z jeho seznamu. U každého napiš:
1. Proč je vhodný (buď přímý, klidně ironický)
2. Co mu chybí a čím to nahradit
3. Jeden konkrétní tip na přípravu

Pokud žádný recept nesedí, navrhni něco jednoduchého z toho co má. Piš česky, stručně, s osobností – žádné suché seznamy bez duše.`;

      try {
        const res = await fetch('https://vorlis.honzavorel0.workers.dev', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            model: 'claude-sonnet-4-6',
            max_tokens: 1024,
            messages: [{ role: 'user', content: prompt }],
          })
        });

        if (!res.ok) {
          const err = await res.json();
          throw new Error(err.error?.message || 'API chyba');
        }

        const data = await res.json();
        const text = data.content?.[0]?.text;
        if (!text) throw new Error('Prázdná odpověď od AI.');
        function renderMarkdown(md) {
          const lines = md.split("\n");
          let html = '';
          let inList = false;
          let inTable = false;
          let tableRows = [];
          for (let i = 0; i < lines.length; i++) {
            let line = lines[i]
              .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
              .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
              .replace(/\*(.+?)\*/g, '<em>$1</em>');
            if (line.startsWith('|') && line.endsWith('|')) {
              if (!inTable) { inTable = true; tableRows = []; }
              tableRows.push(line); continue;
            } else if (inTable) {
              const filtered = tableRows.filter(r => !r.match(/^\|[-| ]+\|$/));
              html += '<div class="overflow-x-auto my-3"><table class="w-full text-[14px]">';
              filtered.forEach((row, ri) => {
                const cells = row.split('|').filter((_, ci) => ci > 0 && ci < row.split('|').length - 1);
                const tag = ri === 0 ? 'th' : 'td';
                const cls = ri === 0 ? 'font-semibold text-text pb-2 text-left' : 'text-text-muted py-1 pr-4';
                html += '<tr>' + cells.map(c => `<${tag} class="${cls}">${c.trim()}</${tag}>`).join('') + '</tr>';
              });
              html += '</table></div>';
              inTable = false; tableRows = [];
            }
            if (line.startsWith('# ')) {
              if (inList) { html += '</ul>'; inList = false; }
              html += `<h2 class="text-[18px] font-semibold text-text mt-5 mb-2">${line.slice(2)}</h2>`;
            } else if (line.startsWith('## ')) {
              if (inList) { html += '</ul>'; inList = false; }
              html += `<h3 class="text-[16px] font-semibold text-text mt-4 mb-2">${line.slice(3)}</h3>`;
            } else if (line.startsWith('### ')) {
              if (inList) { html += '</ul>'; inList = false; }
              html += `<h4 class="text-[14px] font-semibold text-accent mt-4 mb-1">${line.slice(4)}</h4>`;
            } else if (line.match(/^---+$/)) {
              if (inList) { html += '</ul>'; inList = false; }
              html += '<hr class="border-border my-3">';
            } else if (line.startsWith('> ')) {
              if (inList) { html += '</ul>'; inList = false; }
              html += `<blockquote class="border-l-2 border-accent pl-4 text-text-muted italic my-2">${line.slice(2)}</blockquote>`;
            } else if (line.match(/^[-*] /)) {
              if (!inList) { html += '<ul class="space-y-1 my-2 ml-4 list-disc text-text-muted">'; inList = true; }
              html += `<li>${line.slice(2)}</li>`;
            } else if (line.trim() === '') {
              if (inList) { html += '</ul>'; inList = false; }
            } else {
              if (inList) { html += '</ul>'; inList = false; }
              html += `<p class="text-text-muted leading-relaxed mb-2">${line}</p>`;
            }
          }
          if (inList) html += '</ul>';
          return html;
        }
        chefAiText.innerHTML = renderMarkdown(text);
        chefAiResult.classList.remove('hidden');
      } catch (err) {
        chefAiText.textContent = 'Chyba: ' + err.message;
        chefAiResult.classList.remove('hidden');
      }
      chefLoading.classList.add('hidden');
    });

    // --- Import JSON ---
    const importBtn = document.getElementById('import-btn');
    const importFile = document.getElementById('import-file');

    importBtn.addEventListener('click', () => importFile.click());

    importFile.addEventListener('change', e => {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = ev => {
        try {
          const data = JSON.parse(ev.target.result);
          const items = Array.isArray(data) ? data : [data];
          let added = 0;
          items.forEach(item => {
            if (!item.title) return;
            const recipe = {
              slug: item.slug || slugify(item.title),
              title: item.title,
              description: item.description || '',
              image: item.image || '',
              time: item.time || '',
              servings: parseInt(item.servings) || 4,
              difficulty: item.difficulty || 'Snadné',
              category: item.category || '',
              tags: Array.isArray(item.tags) ? item.tags : (item.tags ? String(item.tags).split(',').map(t => t.trim()).filter(Boolean) : []),
              ingredients: Array.isArray(item.ingredients) ? item.ingredients : [],
              steps: Array.isArray(item.steps) ? item.steps : [],
              tip: item.tip || undefined,
            };
            const existing = recipes.findIndex(r => r.slug === recipe.slug);
            if (existing >= 0) recipes[existing] = recipe;
            else recipes.push(recipe);
            added++;
          });
          if (added === 0) { alert('JSON neobsahuje žádný platný recept (chybí pole "title").'); return; }
          updateDirty();
          updateFilters();
          renderGrid();
          alert(`Importováno: ${added} ${added === 1 ? 'recept' : added < 5 ? 'recepty' : 'receptů'}.`);
        } catch {
          alert('Neplatný JSON soubor.');
        }
      };
      reader.readAsText(file);
      importFile.value = '';
    });

    // --- Cooking mode ---
    const cookOverlay = document.getElementById('cook-overlay');
    const cookTitle = document.getElementById('cook-title');
    const cookProgress = document.getElementById('cook-progress');
    const cookStepNum = document.getElementById('cook-step-num');
    const cookStepText = document.getElementById('cook-step-text');
    const cookPrev = document.getElementById('cook-prev');
    const cookNext = document.getElementById('cook-next');
    let cookSteps = [];
    let cookIndex = 0;
    let wakeLock = null;

    async function requestWakeLock() {
      try { if ('wakeLock' in navigator) wakeLock = await navigator.wakeLock.request('screen'); } catch {}
    }
    function releaseWakeLock() {
      try { if (wakeLock) { wakeLock.release(); wakeLock = null; } } catch {}
    }

    function renderCookStep() {
      cookStepNum.textContent = `Krok ${cookIndex + 1} / ${cookSteps.length}`;
      const ghost = document.getElementById('cook-ghost');
      if (ghost) ghost.textContent = cookIndex + 1;
      cookStepText.textContent = cookSteps[cookIndex] || '';
      cookProgress.textContent = `Krok ${cookIndex + 1} z ${cookSteps.length}`;
      document.getElementById('cook-bar').style.width = ((cookIndex + 1) / cookSteps.length * 100) + '%';
      cookPrev.disabled = cookIndex === 0;
      cookNext.textContent = cookIndex === cookSteps.length - 1 ? 'Hotovo ✓' : 'Další →';
    }

    document.getElementById('cook-mode-btn').addEventListener('click', () => {
      const r = recipes.find(x => x.slug === currentSlug);
      if (!r || !(r.steps || []).length) return;
      cookSteps = r.steps;
      cookIndex = 0;
      cookTitle.textContent = r.title;
      renderCookStep();
      cookOverlay.classList.remove('hidden');
      cookOverlay.classList.add('flex');
      document.body.style.overflow = 'hidden';
      requestWakeLock();
    });

    function closeCookMode() {
      cookOverlay.classList.add('hidden');
      cookOverlay.classList.remove('flex');
      document.body.style.overflow = '';
      releaseWakeLock();
    }
    document.getElementById('cook-close').addEventListener('click', closeCookMode);
    let touchX = null;
    cookOverlay.addEventListener('touchstart', e => { touchX = e.touches[0].clientX; }, { passive: true });
    cookOverlay.addEventListener('touchend', e => {
      if (touchX === null) return;
      const dx = e.changedTouches[0].clientX - touchX;
      touchX = null;
      if (Math.abs(dx) < 60) return;
      if (dx < 0 && cookIndex < cookSteps.length - 1) { cookIndex++; renderCookStep(); }
      else if (dx > 0 && cookIndex > 0) { cookIndex--; renderCookStep(); }
    }, { passive: true });
    cookPrev.addEventListener('click', () => { if (cookIndex > 0) { cookIndex--; renderCookStep(); } });
    cookNext.addEventListener('click', () => {
      if (cookIndex < cookSteps.length - 1) { cookIndex++; renderCookStep(); }
      else closeCookMode();
    });

    // --- Shopping list ---
    const shoppingOverlay = document.getElementById('shopping-overlay');
    const shoppingModal = document.getElementById('shopping-modal');
    const shoppingItems = document.getElementById('shopping-items');
    const shoppingEmpty = document.getElementById('shopping-empty');
    const shoppingClear = document.getElementById('shopping-clear');
    const shoppingCount = document.getElementById('shopping-count');
    let shopList = JSON.parse(localStorage.getItem('shopping_list') || '[]');

    function saveShopList() {
      localStorage.setItem('shopping_list', JSON.stringify(shopList));
      updateShoppingBadge();
    }

    function updateShoppingBadge() {
      const remaining = shopList.filter(i => !i.done).length;
      shoppingCount.textContent = remaining;
      shoppingCount.classList.toggle('hidden', remaining === 0);
      const navBadge = document.getElementById('nav-shop-count');
      if (navBadge) {
        navBadge.textContent = remaining;
        navBadge.classList.toggle('hidden', remaining === 0);
      }
    }

    function renderShopList() {
      shoppingEmpty.classList.toggle('hidden', shopList.length > 0);
      shoppingClear.classList.toggle('hidden', shopList.length === 0);
      shoppingItems.innerHTML = shopList.map((item, i) => `
        <li class="flex items-center gap-3 group">
          <button class="shop-toggle w-[18px] h-[18px] shrink-0 rounded border ${item.done ? 'border-accent bg-accent' : 'border-border'} flex items-center justify-center transition-colors" data-i="${i}">
            ${item.done ? '<svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>' : ''}
          </button>
          <span class="flex-1 text-[14px] ${item.done ? 'line-through opacity-40' : ''} text-text">${item.text}</span>
          <button class="shop-remove opacity-0 group-hover:opacity-100 text-text-muted hover:text-red-400 transition-all" data-i="${i}">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </li>`).join('');
      shoppingItems.querySelectorAll('.shop-toggle').forEach(b =>
        b.addEventListener('click', () => { shopList[b.dataset.i].done = !shopList[b.dataset.i].done; saveShopList(); renderShopList(); })
      );
      shoppingItems.querySelectorAll('.shop-remove').forEach(b =>
        b.addEventListener('click', () => { shopList.splice(b.dataset.i, 1); saveShopList(); renderShopList(); })
      );
    }

    document.getElementById('shopping-btn').addEventListener('click', () => {
      renderShopList();
      shoppingOverlay.classList.remove('hidden');
      requestAnimationFrame(() => { shoppingOverlay.classList.remove('opacity-0'); shoppingModal.classList.remove('scale-95', 'opacity-0'); });
    });
    function closeShopping() {
      shoppingOverlay.classList.add('opacity-0');
      shoppingModal.classList.add('scale-95', 'opacity-0');
      setTimeout(() => shoppingOverlay.classList.add('hidden'), 200);
    }
    document.getElementById('shopping-close').addEventListener('click', closeShopping);
    shoppingOverlay.addEventListener('click', e => { if (e.target === shoppingOverlay) closeShopping(); });
    shoppingClear.addEventListener('click', () => { shopList = []; saveShopList(); renderShopList(); });

    document.getElementById('add-shop-btn').addEventListener('click', () => {
      const r = recipes.find(x => x.slug === currentSlug);
      if (!r) return;
      const base = r.servings || 4;
      const factor = currentServings / base;
      (r.ingredients || []).forEach(raw => {
        const text = scaleIngredient(raw, factor);
        if (!shopList.some(i => i.text === text)) shopList.push({ text, done: false });
      });
      saveShopList();
      const btn = document.getElementById('add-shop-btn');
      const orig = btn.textContent;
      btn.textContent = 'Přidáno ✓';
      setTimeout(() => { btn.textContent = orig; }, 1500);
    });

    updateShoppingBadge();

    // --- Bottom nav (mobile) ---
    document.getElementById('nav-all').addEventListener('click', () => {
      activeCategory = 'all'; updateFilters(); renderGrid();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    document.getElementById('nav-fav').addEventListener('click', () => {
      activeCategory = '__fav'; updateFilters(); renderGrid();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    document.getElementById('nav-chef').addEventListener('click', () => document.getElementById('chef-btn').click());
    document.getElementById('nav-shop').addEventListener('click', () => document.getElementById('shopping-btn').click());
    document.getElementById('nav-add').addEventListener('click', () => document.getElementById('add-btn').click());

    // --- Escape key ---
    document.addEventListener('keydown', e => {
      if (e.key !== 'Escape') return;
      if (!cookOverlay.classList.contains('hidden')) closeCookMode();
      else if (!shoppingOverlay.classList.contains('hidden')) closeShopping();
      else if (!settingsOverlay.classList.contains('hidden')) closeSettings();
      else if (!chefOverlay.classList.contains('hidden')) closeChef();
      else if (!editOverlay.classList.contains('hidden')) closeEditModal();
      else if (!overlay.classList.contains('hidden')) closeDetailModal();
    });

    // --- Init ---
    updateFilters();
    renderGrid();
    }); // DOMContentLoaded
  </script>
</Layout>

