  <script define:vars={{ recipesData }}>
    document.addEventListener("DOMContentLoaded", function() {
    const REPO = 'vorlis08/masterchef-vorlis';
    const FILE_PATH = 'src/data/recipes.json';

    let recipes = JSON.parse(JSON.stringify(recipesData));
    let originalJson = JSON.stringify(recipesData);
    let dirty = false;
    let currentSlug = null;

    // --- DOM refs ---
    const grid = document.getElementById('recipe-grid');
    const noResults = document.getElementById('no-results');
    const searchInput = document.getElementById('search');
    const unsavedBadge = document.getElementById('unsaved-badge');
    const saveBtn = document.getElementById('save-btn');
    let activeCategory = 'all';
    let favorites = JSON.parse(localStorage.getItem('favorites') || '[]');

    function toggleFavorite(slug) {
      const i = favorites.indexOf(slug);
      if (i >= 0) favorites.splice(i, 1);
      else favorites.push(slug);
      localStorage.setItem('favorites', JSON.stringify(favorites));
      renderGrid();
    }

    // --- Scroll reveal ---
    let revealObserver = null;
    function revealCards() {
      const items = grid.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) {
        items.forEach(el => el.classList.add('in'));
        return;
      }
      if (!revealObserver) {
        revealObserver = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            const el = entry.target;
            const delay = Math.min(parseInt(el.dataset.i || '0', 10), 5) * 70;
            setTimeout(() => el.classList.add('in'), delay);
            obs.unobserve(el);
          });
        }, { rootMargin: '0px 0px -40px 0px', threshold: 0.05 });
      }
      items.forEach((el, i) => { el.dataset.i = i % 6; revealObserver.observe(el); });
    }

    // --- Dnešní volba: one dish, chosen by the date, no browsing required ---
    function renderHero() {
      const hero = document.getElementById('hero');
      if (!hero) return;
      const browsing = activeCategory !== 'all'
        || searchInput.value.trim() !== ''
        || activeMeal !== ''
        || activeTime !== '';
      if (browsing || recipes.length === 0) {
        hero.classList.add('hidden');
        hero.innerHTML = '';
        return;
      }
      const now = new Date();
      const dayIndex = Math.floor((now - new Date(now.getFullYear(), 0, 0)) / 86400000);
      const r = recipes[dayIndex % recipes.length];
      if (hero.dataset.slug === r.slug && !hero.classList.contains('hidden')) return;
      hero.dataset.slug = r.slug;
      hero.classList.remove('hidden');
      hero.innerHTML = `
        <div class="rise mb-12 sm:mb-16 grid sm:grid-cols-[1.05fr_1fr] gap-5 sm:gap-9 items-center">
          <div class="card-media !aspect-[16/11] sm:!aspect-[4/3] order-1 sm:order-2">
            ${r.image
              ? photoTag(r, { eager: true })
              : `<div class="w-full h-full flex items-center justify-center"><span class="display text-[64px] text-border">${(r.title || '?').charAt(0)}</span></div>`}
          </div>
          <div class="order-2 sm:order-1">
            <div class="label text-accent mb-3">Dnešní volba</div>
            <h2 class="display text-[30px] sm:text-[42px] text-text mb-3">${r.title}</h2>
            <p class="text-text-muted text-[14.5px] sm:text-[15px] leading-relaxed mb-5 max-w-[46ch]">${r.description || 'Otevři recept a uvidíš.'}</p>
            <div class="meta text-text-muted flex items-center gap-2.5 mb-6">
              ${r.time ? `<span>${r.time}</span><span class="opacity-40">/</span>` : ''}
              <span>${r.difficulty || 'Snadné'}</span><span class="opacity-40">/</span>
              <span>${r.servings || '?'} porcí</span>
            </div>
            <div class="flex gap-2.5">
              <button id="hero-open" class="px-5 py-3 rounded-xl bg-accent text-white text-[14px] font-medium hover:bg-accent-hover active:scale-[0.98] transition-all">Otevřít recept</button>
              <button id="hero-cook" class="px-5 py-3 rounded-xl border border-border text-text text-[14px] font-medium hover:border-accent hover:text-accent active:scale-[0.98] transition-all">Vařit hned</button>
            </div>
          </div>
        </div>`;
      document.getElementById('hero-open').addEventListener('click', () => openDetailModal(r.slug));
      document.getElementById('hero-cook').addEventListener('click', () => {
        openDetailModal(r.slug);
        setTimeout(() => document.getElementById('cook-mode-btn').click(), 340);
      });
    }

    // --- View mode ------------------------------------------------------
    let viewMode = localStorage.getItem('viewMode') || 'menu';

    function cardMarkup(r, isFav) {
      return `
          <article class="recipe-card reveal relative text-left cursor-pointer" data-slug="${r.slug}">
            <button class="fav-btn absolute top-2.5 right-2.5 z-10 w-9 h-9 rounded-full bg-black/45 backdrop-blur-sm flex items-center justify-center transition-colors ${isFav ? 'text-red-400' : 'text-white/70 hover:text-white'}" data-fav="${r.slug}" aria-label="Přidat do oblíbených">
              <svg class="w-[18px] h-[18px]" fill="${isFav ? 'currentColor' : 'none'}" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>
            </button>
            <div class="card-media mb-3">
              ${r.image
                ? photoTag(r)
                : `<div class="w-full h-full flex items-center justify-center"><span class="display text-[34px] text-border">${(r.title || '?').charAt(0)}</span></div>`}
            </div>
            ${r.category ? `<div class="label text-accent mb-1.5">${r.category}</div>` : ''}
            <h3 class="display text-[16px] sm:text-[19px] text-text mb-2">${r.title}</h3>
            <div class="card-rule mb-2"></div>
            <div class="meta text-text-muted flex items-center gap-2">
              ${r.time ? `<span>${r.time}</span><span class="opacity-40">/</span>` : ''}
              <span>${r.servings || '?'} porcí</span>
              ${getUserRating(r.slug) ? `<span class="text-amber-400 text-[13px]">${'★'.repeat(getUserRating(r.slug))}</span>` : ''}
            </div>
          </article>`;
    }

    function rowMarkup(r, isFav, n) {
      const num = String(n).padStart(2, '0');
      return `
          <div class="menu-row reveal" data-slug="${r.slug}" data-img="${r.image || ''}">
            <span class="menu-num">${num}</span>
            <span class="menu-title">${r.title}${isFav ? ' <span class="text-accent align-middle" style="font-size:0.42em">♥</span>' : ''}</span>
            <span class="menu-time hidden sm:inline">${r.time || ''}</span>
            ${r.image ? photoTag(r, { cls: 'menu-thumb sm:hidden', alt: '', style: 'grid-row:1/span 2;grid-column:3' }) : ''}
            <span class="menu-sub">${[r.category, r.difficulty, (r.servings || '?') + ' porcí'].filter(Boolean).join(' · ')} ${getUserRating(r.slug) ? '<span class=\'menu-stars\'>' + '★'.repeat(getUserRating(r.slug)) + '</span>' : ''}</span>
          </div>`;
    }

    // --- Render grid ---
    function renderGrid() {
      const query = fold(searchInput.value);
      let html = '';
      let visible = 0;
      recipes.forEach(r => {
        const isFav = favorites.includes(r.slug);
        const matchCat = activeCategory === 'all'
          || (activeCategory === '__fav' && isFav)
          || r.category === activeCategory;
        // Czech declension: "slanina" should still find "se slaninou".
        // Dropping the last letter of a longer query covers most case endings.
        const hay = haystack(r);
        const matchSearch = !query
          || hay.includes(query)
          || (query.length >= 5 && hay.includes(query.slice(0, -1)));
        const matchMeal = !activeMeal || (r.meal_type || []).includes(activeMeal);
        const mins = parseMinutes(r.time);
        const timeBuckets = [
          { key: '20',  fn: m => m <= 20 },
          { key: '45',  fn: m => m <= 45 },
          { key: '90',  fn: m => m <= 90 },
          { key: '90+', fn: m => m > 90  },
        ];
        const bucket = timeBuckets.find(b => b.key === activeTime);
        const matchTime = !activeTime || (mins !== null && bucket && bucket.fn(mins));
        if (!matchCat || !matchSearch || !matchMeal || !matchTime) return;
        visible++;
        html += viewMode === 'grid' ? cardMarkup(r, isFav) : rowMarkup(r, isFav, visible);
      });

      grid.className = viewMode === 'grid'
        ? 'grid grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-8 sm:gap-x-6 sm:gap-y-10'
        : 'block';
      grid.innerHTML = html;
      noResults.classList.toggle('hidden', visible > 0);

      const gh = document.getElementById('grid-heading');
      const gc = document.getElementById('grid-count');
      const gt = document.getElementById('grid-title');
      if (gh) {
        gh.classList.toggle('hidden', visible === 0);
        if (visible > 0) gh.classList.add('flex');
      }
      if (gt) gt.textContent = activeCategory === '__fav' ? 'Oblíbené' : (activeCategory === 'all' ? 'Rejstřík' : activeCategory);
      if (gc) gc.textContent = visible === 1 ? '1 recept' : (visible < 5 ? visible + ' recepty' : visible + ' receptů');

      grid.querySelectorAll('.recipe-card, .menu-row').forEach(c =>
        c.addEventListener('click', () => openDetailModal(c.dataset.slug))
      );
      grid.querySelectorAll('.fav-btn').forEach(b =>
        b.addEventListener('click', e => { e.stopPropagation(); toggleFavorite(b.dataset.fav); })
      );

      bindHoverPreview();
      revealCards();
      renderHero();
    }

    // --- Cursor-following dish preview (pointer devices only) ------------
    const preview = document.getElementById('hover-preview');
    const previewImg = preview ? preview.querySelector('img') : null;
    let px = 0, py = 0, tx = 0, ty = 0, previewRaf = null;

    function previewLoop() {
      px += (tx - px) * 0.14;
      py += (ty - py) * 0.14;
      preview.style.translate = px + 'px ' + py + 'px';
      previewRaf = requestAnimationFrame(previewLoop);
    }

    function bindHoverPreview() {
      if (!preview || !window.matchMedia('(hover: hover)').matches) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      grid.querySelectorAll('.menu-row').forEach(row => {
        row.addEventListener('mouseenter', () => {
          const src = row.dataset.img;
          if (!src) return;
          previewImg.src = src;
          preview.classList.add('on');
          if (!previewRaf) previewLoop();
        });
        row.addEventListener('mouseleave', () => {
          preview.classList.remove('on');
        });
      });
    }

    document.addEventListener('mousemove', e => {
      tx = e.clientX + 150;
      ty = e.clientY;
      if (tx > window.innerWidth - 130) tx = e.clientX - 150;
    });

    // --- View toggle -----------------------------------------------------
    const viewToggle = document.getElementById('view-toggle');
    if (viewToggle) {
      viewToggle.querySelectorAll('button').forEach(b => {
        b.classList.toggle('on', b.dataset.view === viewMode);
        b.addEventListener('click', () => {
          viewMode = b.dataset.view;
          localStorage.setItem('viewMode', viewMode);
          viewToggle.querySelectorAll('button').forEach(x => x.classList.toggle('on', x.dataset.view === viewMode));
          preview.classList.remove('on');
          renderGrid();
        });
      });
    }

    function updateDirty() {
      dirty = JSON.stringify(recipes) !== originalJson;
      unsavedBadge.classList.toggle('hidden', !dirty);
      saveBtn.classList.toggle('hidden', !dirty);
    }

    function slugify(text) {
      return text.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    }

    // --- Filters ---
    // active secondary filters
    let activeMeal = '';
    let activeTime = '';

    // "kure" should find "kuře" — nobody reaches for háčky mid-search.
    function fold(str) {
      return String(str).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    }

    // Tags no longer have pills, but they still feed search — that is the
    // whole point of dropping them from the bar.
    function haystack(r) {
      return fold([
        r.title, r.description, r.category,
        (r.tags || []).join(' '),
        (r.meal_type || []).join(' '),
        (r.ingredients || []).join(' '),
        (r.ingredients_fancy || []).join(' ')
      ].filter(Boolean).join(' '));
    }

    function parseMinutes(t) {
      if (!t) return null;
      const h = t.match(/(\d+)\s*hod/); const m = t.match(/(\d+)\s*min/);
      return (h ? parseInt(h[1]) * 60 : 0) + (m ? parseInt(m[1]) : 0) || null;
    }

    function updateFilters() {
      const bar  = document.getElementById('filter-bar');
      const bar2 = document.getElementById('filter-bar-2');

      // Row 1: view switches only. Category pills lived here, but with this
      // many recipes they barely narrowed anything and overlapped with the
      // course filters below.
      let h1 = `<button class="filter-btn pill ${activeCategory === 'all' ? 'is-active' : ''}" data-category="all">Vše</button>`;
      h1 += `<button class="filter-btn pill ${activeCategory === '__fav' ? 'is-active' : ''}" data-category="__fav">♥ Oblíbené</button>`;
      bar.innerHTML = h1;
      bar.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', () => { activeCategory = btn.dataset.category; updateFilters(); renderGrid(); });
      });

      // Row 2: course and time only. Ingredient tags used to live here too,
      // but sixteen of them wrapped onto three lines and buried the two
      // filters worth scanning. Searching "kuře" does that job better.
      const allMeals = [...new Set(recipes.flatMap(r => r.meal_type || []))];
      const mealOrder = ['snídaně','svačina','oběd','večeře','dezert','polévka','příloha','ostatní'];
      allMeals.sort((a,b) => mealOrder.indexOf(a) - mealOrder.indexOf(b));
      const timeBuckets = [
        { key: '20',  label: '⚡ do 20 min',  fn: m => m <= 20 },
        { key: '45',  label: '🕐 do 45 min',  fn: m => m <= 45 },
        { key: '90',  label: '🕑 do 90 min',  fn: m => m <= 90 },
        { key: '90+', label: '⏳ 90 min+',    fn: m => m > 90  },
      ];

      let h2 = '';
      allMeals.forEach(m => {
        h2 += `<button class="filter-btn pill pill-sm ${activeMeal === m ? 'is-active' : ''}" data-meal="${m}">${m}</button>`;
      });
      if (allMeals.length) h2 += `<span class="pill-sep"></span>`;
      timeBuckets.forEach(b => {
        h2 += `<button class="filter-btn pill pill-sm ${activeTime === b.key ? 'is-active' : ''}" data-time="${b.key}">${b.label}</button>`;
      });
      bar2.innerHTML = h2;
      bar2.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          if (btn.dataset.meal !== undefined) activeMeal = activeMeal === btn.dataset.meal ? '' : btn.dataset.meal;
          if (btn.dataset.time !== undefined) activeTime = activeTime === btn.dataset.time ? '' : btn.dataset.time;
          updateFilters(); renderGrid();
        });
      });

      const navAll = document.getElementById('nav-all');
      const navFav = document.getElementById('nav-fav');
      if (navAll) navAll.classList.toggle('text-accent', activeCategory !== '__fav');
      if (navFav) navFav.classList.toggle('text-accent', activeCategory === '__fav');
    }

    searchInput.addEventListener('input', renderGrid);

    // --- Detail modal ---
    const overlay = document.getElementById('modal-overlay');
    const modal = document.getElementById('modal');

    let currentServings = 4;

    function formatNum(n) {
      const rounded = Math.round(n * 100) / 100;
      return String(rounded).replace('.', ',');
    }

    // A blurred 20px stand-in rides along in the JSON, so a card never sits
    // empty while its photo downloads. The real photo paints straight over it.
    function photoTag(r, opts) {
      opts = opts || {};
      if (!r.image) return '';
      const blur = r.blur ? 'background-image:url(' + r.blur + ');' : '';
      return '<img class="photo ' + (opts.cls || '') + '" src="' + r.image + '"' +
        ' alt="' + (opts.alt === '' ? '' : (r.title || '')) + '"' +
        (opts.eager ? ' fetchpriority="high"' : ' loading="lazy"') +
        ' decoding="async" style="' + blur + (opts.style || '') + '" />';
    }

    function setPhoto(el, r) {
      if (!el) return;
      el.src = r.image || '';
      el.style.backgroundImage = r.blur ? 'url(' + r.blur + ')' : '';
    }

    // ---- Basic / Fancy -------------------------------------------------
    let fancyMode = localStorage.getItem('recipeMode') === 'fancy';

    // A recipe may carry a second, more involved version of itself.
    // Missing pieces fall back to the basic ones, so the switch works everywhere.
    function variantOf(r) {
      if (!fancyMode) return {
        ingredients: r.ingredients || [],
        steps: r.steps || [],
        description: r.description || '',
        time: r.time || '',
        tip: r.tip || '',
        own: true
      };
      return {
        ingredients: r.ingredients_fancy || r.ingredients || [],
        steps: r.steps_fancy || r.steps || [],
        description: r.description_fancy || r.description || '',
        time: r.time_fancy || r.time || '',
        tip: r.tip_fancy || r.tip || '',
        own: !!(r.ingredients_fancy || r.steps_fancy)
      };
    }

    const QTY_UNITS = ['g','kg','mg','ml','l','dl','cl','ks','kus','kusy','kusů','lžíce','lžíci','lžic','lžička','lžičky','lžiček','stroužek','stroužky','stroužku','stroužků','balení','plátek','plátky','plátků','špetka','špetky','hrst','hrsti','šálek','šálky','sklenice','sklenici','porce','porcí','konzerva','konzervy','kelímek','kelímky','svazek','snítka','snítky','větvička','list','listy','listů'];

    // Splits "800 g kuřecích prsou" into a menu line: name left, quantity right.
    function splitQty(text) {
      const m = text.match(/^(\d+(?:[.,]\d+)?(?:\s*[–\/-]\s*\d+(?:[.,]\d+)?)?)\s*(\S+)?\s*(.*)$/);
      if (!m) return { qty: '', name: text };
      let qty = m[1];
      let rest = ((m[2] || '') + ' ' + (m[3] || '')).trim();
      const w = (m[2] || '').replace(/[.,:]$/, '').toLowerCase();
      if (QTY_UNITS.indexOf(w) !== -1) { qty += ' ' + m[2]; rest = (m[3] || '').trim(); }
      if (!rest) return { qty: '', name: text };
      return { qty: qty, name: rest };
    }

    function roman(n) {
      const v = [50, 40, 10, 9, 5, 4, 1], sym = ['L','XL','X','IX','V','IV','I'];
      let out = '';
      for (let i = 0; i < v.length; i++) { while (n >= v[i]) { out += sym[i]; n -= v[i]; } }
      return out || '\u2014';
    }

    function esc(t) {
      return String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function scaleIngredient(text, factor) {
      if (factor === 1) return text;
      return text.replace(/(\d+(?:[.,]\d+)?)(\s*[–-]\s*)(\d+(?:[.,]\d+)?)|(\d+(?:[.,]\d+)?)/g, (m, a, dash, b, single) => {
        if (a !== undefined) {
          const na = parseFloat(a.replace(',', '.')) * factor;
          const nb = parseFloat(b.replace(',', '.')) * factor;
          return formatNum(na) + dash + formatNum(nb);
        }
        return formatNum(parseFloat(single.replace(',', '.')) * factor);
      });
    }

    function renderIngredients(r) {
      const base = r.servings || 4;
      const factor = currentServings / base;
      document.getElementById('portion-value').textContent =
        currentServings + ' ' + (currentServings === 1 ? 'porce' : currentServings < 5 ? 'porce' : 'porcí');
      const ingList = document.getElementById('modal-ingredients');
      const list = variantOf(r).ingredients;

      if (fancyMode) {
        ingList.className = 'f-ing-list';
        ingList.innerHTML = list.map(raw => {
          const parts = splitQty(scaleIngredient(raw, factor));
          return '<li class="f-ing">' +
            '<span class="f-ing-name">' + esc(parts.name) + '</span>' +
            (parts.qty ? '<span class="f-ing-dots"></span><span class="f-ing-qty">' + esc(parts.qty) + '</span>' : '') +
            '</li>';
        }).join('');
        ingList.querySelectorAll('.f-ing').forEach(li =>
          li.addEventListener('click', () => li.classList.toggle('is-done'))
        );
        return;
      }

      ingList.className = 'space-y-2';
      ingList.innerHTML = list.map(raw => {
        const ing = scaleIngredient(raw, factor);
        return `<li class="flex items-start gap-3 cursor-pointer group ingredient-item">
          <span class="mt-[3px] w-[18px] h-[18px] shrink-0 rounded border border-border group-hover:border-accent flex items-center justify-center transition-colors checkbox">
            <svg class="w-3 h-3 text-accent opacity-0 check-icon transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
          </span>
          <span class="text-[15px] text-text-muted group-hover:text-text transition-colors ing-text">${ing}</span>
        </li>`;
      }).join('');
      ingList.querySelectorAll('.ingredient-item').forEach(item => {
        item.addEventListener('click', () => {
          const ck = item.querySelector('.check-icon');
          const txt = item.querySelector('.ing-text');
          const on = ck.style.opacity === '1';
          ck.style.opacity = on ? '0' : '1';
          item.querySelector('.checkbox').classList.toggle('border-accent', !on);
          txt.classList.toggle('line-through', !on);
          txt.classList.toggle('opacity-40', !on);
        });
      });
    }

    document.getElementById('portion-minus').addEventListener('click', () => {
      if (currentServings <= 1) return;
      currentServings--;
      const r = recipes.find(x => x.slug === currentSlug);
      if (r) renderIngredients(r);
    });
    document.getElementById('portion-plus').addEventListener('click', () => {
      if (currentServings >= 20) return;
      currentServings++;
      const r = recipes.find(x => x.slug === currentSlug);
      if (r) renderIngredients(r);
    });

    function renderSteps(r) {
      const v = variantOf(r);
      const el = document.getElementById('modal-steps');

      if (fancyMode) {
        el.className = 'f-step-list';
        el.innerHTML = v.steps.map((s, i) =>
          '<li class="f-step"><span class="f-step-num">' + roman(i + 1) + '</span>' +
          '<p class="f-step-text">' + esc(s) + '</p></li>'
        ).join('');
        return;
      }

      el.className = 'space-y-5';
      el.innerHTML = v.steps.map((s, i) =>
        '<li class="flex gap-4 sm:gap-5"><span class="display shrink-0 w-8 text-[22px] leading-none text-accent/70 pt-0.5 text-right">' + (i + 1) + '</span>' +
        '<p class="text-[15px] text-text-muted leading-[1.7]">' + esc(s) + '</p></li>'
      ).join('');
    }

    // Everything that is not the ingredient/step lists: headings, meta, note.
    function renderModeChrome(r) {
      const v = variantOf(r);
      const headIng  = document.getElementById('head-ingredients');
      const headStep = document.getElementById('head-steps');
      const fleuron  = document.getElementById('modal-fleuron');
      const note     = document.getElementById('modal-note');
      const tipEl    = document.getElementById('modal-tip');

      modal.classList.toggle('is-fancy', fancyMode);
      document.querySelectorAll('#mode-toggle .mode-opt').forEach(b =>
        b.classList.toggle('is-on', (b.dataset.mode === 'fancy') === fancyMode)
      );

      document.getElementById('modal-description').textContent = v.description;
      document.getElementById('modal-meta').innerHTML =
        (v.time ? '<span>' + esc(v.time) + '</span><span class="opacity-40">/</span>' : '') +
        '<span>' + esc(r.difficulty || '') + '</span><span class="opacity-40">/</span>' +
        '<span>' + (r.servings || '?') + ' porcí</span>';

      if (fancyMode) {
        headIng.className  = 'f-head';
        headStep.className = 'f-head';
        headIng.innerHTML  = '<span>Suroviny</span>';
        headStep.innerHTML = '<span>Postup</span>';
        fleuron.classList.remove('hidden');
        if (v.own) { note.classList.add('hidden'); }
        else {
          note.classList.remove('hidden');
          note.textContent = 'Pro tento recept zatím není vlastní Fancy verze — vidíš základní postup.';
        }
      } else {
