        <span class="text-[10px] font-medium">Nákup</span>
        <span id="nav-shop-count" class="hidden absolute top-1 right-[22%] min-w-[16px] h-4 px-1 rounded-full bg-accent text-white text-[9px] font-semibold flex items-center justify-center"></span>
